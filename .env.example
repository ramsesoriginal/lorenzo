# Copy to .env and adjust for local development.
# Each app adds its own keys here (with a comment noting which app reads
# them) as it's scaffolded; see docs/guides/adding-an-app.md.
#
# Copy this to *two* places, not one - confirmed empirically, not obvious
# from either tool's own docs: `docker compose` (run from the repo root,
# e.g. `docker compose -f infra/docker-compose.yml up -d`) reads .env
# relative to wherever it's invoked from, i.e. this directory. apps/api's
# own Settings (pydantic-settings, config.py) reads .env relative to *its*
# working directory instead - apps/api/.env, not this one - since that's
# where `mise run //apps/api:dev`/`uv run fastapi dev ...` actually runs
# from. Keep both in sync by hand for now.

# --- infra/docker-compose.yml + apps/api ------------------------------------
# 55432, not 5432 - deliberately clear of other Postgres instances that
# might already be running on this machine. Adjust if it still collides.
POSTGRES_USER=lorenzo
POSTGRES_PASSWORD=lorenzo
POSTGRES_DB=lorenzo
POSTGRES_PORT=55432
# DATABASE_URL: what the running app connects as - a restricted role RLS
# actually applies to (see ADR 0021). MIGRATIONS_DATABASE_URL: what Alembic
# connects as - stays privileged (this is the compose-bootstrapped
# lorenzo/lorenzo superuser-equivalent role above). The restricted
# lorenzo_app role itself is created by migration, not by docker-compose.
DATABASE_URL=postgresql+asyncpg://lorenzo_app:lorenzo_app@localhost:55432/lorenzo
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://lorenzo:lorenzo@localhost:55432/lorenzo

# --- apps/api: Authgear (ADR 0009/0023/0027) --------------------------------
# Placeholders only - the app's test suite never reads these (it uses a fake
# JWKS server instead). Real values come from whichever Authgear project
# you're verifying tokens against; see docs/operations/local-authgear-setup.md
# for how to get them. AUTHGEAR_AUDIENCE is the project *endpoint* URL, not
# an OIDC client id - that distinction only applies to ID tokens, not the
# access tokens this app actually verifies (see ADR 0023).
AUTHGEAR_ISSUER=http://localhost:4000
AUTHGEAR_JWKS_URL=http://localhost:4000/oauth2/jwks
AUTHGEAR_AUDIENCE=http://localhost:4000
