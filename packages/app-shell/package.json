{
  "name": "@lorenzo/app-shell",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "The head, header, footer and page frame of the apps that share it (Calendars, Sessions, Writing and Maps), over the shared brand (ADR 0322).",
  "exports": {
    ".": "./src/index.ts",
    "./AppPage.astro": "./src/AppPage.astro"
  },
  "scripts": {
    "lint": "biome check . && tsc --noEmit && prettier --check \"**/*.astro\"",
    "format": "biome check --write . && prettier --write \"**/*.astro\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
