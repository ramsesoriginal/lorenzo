---
import lockupDark from './assets/lorenzo_horizontal_lockup_dark_bg.svg';
import lockupLight from './assets/lorenzo_horizontal_lockup_light_bg.svg';
import spark from './assets/brand_mark.svg';
import type { NavItem } from './pure';

// The web shell's header (ADR 0410): a global bar over an app bar, and the state strip under both.
// It carries the same data-* hooks as SiteHeader, so bindShell drives either.
interface Props {
  product: string;
  brandingUrl: string;
  nav?: NavItem[];
  // The app's icon, beside its name (D29): an icon of the brand's sprite, "account".
  icon?: string;
}

const { product, brandingUrl, nav = [], icon } = Astro.props;
const icons = `${brandingUrl}/icons.svg`;
---

<!-- One row (the mark, the app, its links, then the global controls) until the library switcher is
     shown: with several libraries it is two tiers and the wordmark sits beside the switcher (D29). -->
<header class="shell-header" data-site-header data-shell data-tiers="one" data-sprite={icons}>
  <div class="shell-bar">
    <a class="brand brand--compact" href="/" aria-label={`Lorenzo ${product}, home`}>
      <img
        class="brand-mark brand-mark--light"
        src={lockupLight.src}
        alt="Lorenzo"
        width="220"
        height="41"
      />
      <img
        class="brand-mark brand-mark--dark"
        src={lockupDark.src}
        alt="Lorenzo"
        width="220"
        height="41"
      />
      <img class="brand-spark" src={spark.src} alt="" width="32" height="32" />
    </a>
    <div class="row-tight" data-library-switcher hidden>
      <svg class="icon" aria-hidden="true">
        <use href={`${icons}#icon-library`}></use>
      </svg>
      <select class="text-input" aria-label="Library or repository" data-library-select></select>
    </div>
    <span class="grow"></span>
    <button type="button" class="shell-field-btn palette-btn" data-shell-open-palette hidden>
      <svg class="icon" aria-hidden="true">
        <use href={`${icons}#icon-search`}></use>
      </svg>
      <span>Search or go anywhere</span>
      <kbd data-shell-palette-keys>Ctrl K</kbd>
    </button>
    <button
      type="button"
      class="icon-button only-phone"
      aria-label="Search or go anywhere"
      data-shell-open-palette
      hidden
    >
      <svg class="icon" aria-hidden="true">
        <use href={`${icons}#icon-search`}></use>
      </svg>
    </button>
    <a class="icon-button" data-shell-bell hidden>
      <svg class="icon" aria-hidden="true">
        <use href={`${icons}#icon-notifications`}></use>
      </svg>
      <span data-shell-bell-count></span>
    </a>
    <span class="status-text row-tight" data-account-checking>
      <span class="spinner" aria-hidden="true"></span>
      Checking your session…
    </span>
    <span class="error-text" data-account-error hidden></span>
    <button type="button" class="btn row-tight" data-login hidden>
      <svg class="icon" aria-hidden="true">
        <use href={`${icons}#icon-login`}></use>
      </svg>
      Log in
    </button>
    <div class="row-tight" data-account-signed-in hidden>
      <button
        type="button"
        class="avatar"
        aria-label="Account menu"
        aria-haspopup="menu"
        aria-expanded="false"
        data-shell-account-button
      >
        <span aria-hidden="true" data-shell-initials></span>
      </button>
      <span class="visually-hidden" data-account-label></span>
    </div>
    <button type="button" hidden aria-pressed="false" data-theme-toggle>
      Dark theme
    </button>
  </div>
  <div class="shell-apps">
    <span class="prod">
      {icon && (
        <svg class="icon" aria-hidden="true">
          <use href={`${icons}#icon-${icon}`}></use>
        </svg>
      )}
      {product}
    </span>
    {nav.length > 0 && (
      <nav aria-label="Pages">
        {nav.map((item) => (
          <a
            class="tab"
            href={item.href}
            data-path={item.href}
            data-needs-library={item.needsLibrary ? '' : undefined}

            data-requires={item.requires}
            hidden={item.needsLibrary || Boolean(item.requires)}
          >
            {item.label}
          </a>
        ))}
      </nav>
    )}
  </div>
  <div class="shell-strip" data-shell-strip>
    <div>
      <div class="shell-strip-in" data-kind="offline" role="status">
        <svg class="icon" aria-hidden="true">
          <use href={`${icons}#icon-offline`} data-shell-strip-icon></use>
        </svg>
        <span class="msg" data-shell-strip-text></span>
        <span class="grow"></span>
        <button type="button" class="btn btn-secondary" data-shell-strip-action hidden></button>
      </div>
    </div>
  </div>
</header>
