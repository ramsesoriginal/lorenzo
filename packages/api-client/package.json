{
  "name": "@lorenzo/api-client",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "The typed client for apps/api that the apps share: the generated schema, a client factory, and one error type. See ADR 0122.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run",
    "generate-schema": "openapi-typescript ../../apps/api/openapi.json -o src/schema.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.14",
    "@types/node": "^26.6.6",
    "openapi-typescript": "^7.5.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
