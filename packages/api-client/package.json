{
  "name": "@lorenzo/api-client",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "The typed client for apps/api that loot-bot and inventory-web share: the generated schema, a client factory, and one error type. See ADR 0122.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run",
    "generate-schema": "openapi-typescript ../../apps/api/openapi.json -o src/schema.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^22.10.5",
    "openapi-typescript": "^7.5.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
