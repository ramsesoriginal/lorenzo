{
  "name": "@lorenzo/brand",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Lorenzo's shared brand layout package - tokens, fonts, icons, and a small opinionated CSS foundation - for other apps to bundle at build time. See ADR 0098.",
  "files": [
    "tokens.css",
    "fonts.css",
    "fonts/",
    "normalize.css",
    "base.css",
    "layout.css",
    "components.css",
    "motion.css",
    "icons.svg",
    "icons.manifest.yaml"
  ],
  "exports": {
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./fonts/*": "./fonts/*",
    "./normalize.css": "./normalize.css",
    "./base.css": "./base.css",
    "./layout.css": "./layout.css",
    "./components.css": "./components.css",
    "./motion.css": "./motion.css",
    "./icons.svg": "./icons.svg",
    "./icons.manifest.yaml": "./icons.manifest.yaml"
  }
}
