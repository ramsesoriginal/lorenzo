<div class="stack" data-slug-editor>
  <p class="status-text" data-message hidden></p>
  <form class="stack" data-form hidden>
    <label class="field">
      <span class="field-label">Link name</span>
      <input
        class="text-input"
        type="text"
        spellcheck="false"
        aria-describedby="slug-editor-note"
        data-slug
      />
    </label>
    <!-- Outside the label, so it describes the field rather than being part of its name. -->
    <p class="status-text" id="slug-editor-note">
      How links name it, as in [text](link-name). Empty for none. Also called its slug.
    </p>
    <div class="row">
      <button type="submit" data-save>
        Save link name
      </button>
    </div>
    <p class="status-text" role="status" data-status hidden></p>
  </form>
</div>
