<section class="stack-tight" aria-labelledby="being-inventory-heading" data-inventory hidden>
  <h2 id="being-inventory-heading">Inventory</h2>
  <p class="status-text" data-message hidden></p>
  <p data-counts hidden></p>
  <ul class="list" data-list hidden></ul>
  <p class="status-text" data-more hidden></p>
  <p>
    <a data-board hidden>
      Open the inventory board
    </a>
  </p>

  <template data-item-template>
    <li class="row">
      <span data-name></span>
      <span class="badge" data-quantity hidden></span>
    </li>
  </template>
</section>
