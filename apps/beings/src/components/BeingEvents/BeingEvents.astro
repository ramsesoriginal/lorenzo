<section
  class="sheet-section"
  id="events"
  data-being-events
  hidden
  aria-labelledby="being-events-heading"
>
  <header>
    <h2 id="being-events-heading">Events</h2>
  </header>
  <p class="caption">
    Events this being participates in, in story order. Linearized placements carry no recorded
    ordering path.
  </p>
  <p data-event-status role="status"></p>
  <ol data-event-list></ol>
  <button type="button" class="btn btn-secondary" data-more-events hidden>
    More Events
  </button>
</section>
