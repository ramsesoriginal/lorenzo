<section class="stack-tight" aria-labelledby="being-people-heading" data-people hidden>
  <h2 id="being-people-heading">Played by</h2>
  <p class="status-text" data-none hidden></p>
  <ul class="list" data-list hidden></ul>

  <template data-person-template>
    <li class="row">
      <strong data-name></strong>
      <span class="badge" data-owner hidden>
        Owner
      </span>
      <span class="pill" data-you hidden>
        You
      </span>
      <span class="status-text" data-campaign hidden></span>
    </li>
  </template>
</section>
