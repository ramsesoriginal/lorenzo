<!-- The being's numbers, drawn by what they are (RFC 0043): groups of tiles, then rows for text, and
     the Conditions: the ones that are on, and in Play a toggle for each a table may change. -->
<div class="stack" data-stat-band>
  <p class="status-text" data-message hidden></p>
  <div class="stat-band" data-groups></div>
  <div class="stat-conditions" data-conditions hidden></div>
</div>
