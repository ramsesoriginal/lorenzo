<div class="stack-tight" data-picture-edit hidden>
  <label class="field">
    <span class="field-label">Picture file</span>
    <input
      type="file"
      accept="image/png,image/jpeg,image/webp,image/gif"
      class="text-input"
      data-file
    />
  </label>
  <p class="status-text">A PNG, JPEG, WebP or GIF of at most 2 MB.</p>
  <div class="row">
    <button type="button" data-upload>
      Use this picture
    </button>
    <button type="button" class="btn-danger" data-remove hidden>
      Remove the picture
    </button>
  </div>
  <p class="status-text" role="status" data-status hidden></p>
</div>
