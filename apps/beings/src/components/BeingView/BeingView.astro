<div class="stack" data-being-view>
  <figure class="being-picture" data-picture-figure hidden>
    <img data-picture alt="" />
  </figure>
  <div class="stack item-detail-descriptions" data-description></div>
  <ul class="row" data-tags hidden></ul>
  <div class="stack" data-groups></div>
  <p class="status-text" data-nothing hidden>
    Nothing has been written about this being yet.
  </p>

  <template data-stat-template>
    <dt data-name></dt>
    <dd data-value></dd>
  </template>

  <template data-tag-template>
    <li class="chip" data-label></li>
  </template>
</div>
