<form class="stack-tight" data-name-edit hidden>
  <label class="field">
    <span class="field-label">Name</span>
    <input type="text" class="text-input" required maxlength="200" data-name />
  </label>
  <div class="row">
    <button type="submit" data-save>
      Rename
    </button>
  </div>
  <p class="status-text" role="status" data-status hidden></p>
</form>
