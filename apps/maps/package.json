{
  "name": "@lorenzo/maps",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build-branding-package": "pnpm --filter @lorenzo/brand run build",
    "copy-branding": "node scripts/copy-branding.mjs",
    "dev": "astro dev --port 4328",
    "build": "pnpm run build-branding-package && pnpm run copy-branding && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "biome check . && astro check && prettier --check \"**/*.astro\"",
    "format": "biome check --write . && prettier --write \"**/*.astro\"",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@authgear/web": "^6.0.0",
    "@lorenzo/api-client": "workspace:*",
    "@lorenzo/app-shell": "workspace:*",
    "@lorenzo/brand": "workspace:*",
    "@lorenzo/entry-preview": "workspace:*",
    "@lorenzo/map-renderer": "workspace:*",
    "@lorenzo/period-picker": "workspace:*",
    "@lorenzo/time-filter": "workspace:*",
    "@lorenzo/read-cache": "workspace:*",
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.11.10",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
