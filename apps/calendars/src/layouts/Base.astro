---
import AppPage from '@lorenzo/app-shell/AppPage.astro';
import { ClientRouter } from 'astro:transitions';
import { BRANDING_CSS_URL } from '../lib/config';
import appStyles from '../styles/app.css?url';

interface Props {
  title?: string;
  // What the welcome says while the page works out who is signed in.
  status?: string;
}

const { title = 'Lorenzo Calendars', status = 'Opening your calendars…' } = Astro.props;
---

<AppPage
  title={title}
  product="Calendars"
  icon="kind-calendar"
  brandingUrl={BRANDING_CSS_URL}
  themeKey="lorenzo:calendars:theme"
  shell="web"
  template="list-detail"
  nav={[
    {
      label: 'Calendar',
      href: '/',
      icon: 'kind-calendar',
      also: ['/calendar/', '/entry/'],
    },
    { label: 'Events', href: '/events/', needsLibrary: true, icon: 'kind-event' },
    {
      label: 'Clocks',
      href: '/clocks/',
      needsLibrary: true,
      requires: 'clocks',
      icon: 'kind-clock',
    },
  ]}
  path="apps/calendars"
  welcome={{
    title: 'Calendars',
    text: 'Each world keeps its own months, festivals and moons. Choose a calendar to read its dates, notes and Events.',
    status,
  }}
>
  <ClientRouter slot="head" />
  <link slot="head" rel="stylesheet" href={appStyles} />
  <slot />
</AppPage>
<script>
  import { bindLegalLinksFromApi } from '@lorenzo/app-shell/legal';
  import { API_BASE_URL } from '../lib/config';

  // The legal notice, the privacy policy and the support link, when the deployment has them
  // (ADR 0439). The footer is replaced when the client router swaps a page, so it is bound again.
  const bind = () => void bindLegalLinksFromApi(API_BASE_URL);
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
