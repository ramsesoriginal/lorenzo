{
  "name": "@lorenzo/inventory-web",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build-branding-package": "pnpm --filter @lorenzo/brand run build",
    "copy-branding": "node scripts/copy-branding.mjs",
    "dev": "pnpm run build-branding-package && pnpm run copy-branding && astro dev",
    "build": "pnpm run build-branding-package && pnpm run copy-branding && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "biome check . && astro check && prettier --check \"**/*.astro\"",
    "format": "biome check --write . && prettier --write \"**/*.astro\"",
    "test": "vitest run",
    "generate-client": "openapi-typescript ../api/openapi.json -o src/lib/lorenzo-schema.d.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@authgear/web": "^6.0.0",
    "@lorenzo/brand": "workspace:*",
    "@lorenzo/lorenzoscript": "workspace:*",
    "@lorenzo/lorenzoscript-editor": "workspace:*",
    "astro": "^7.3.3",
    "openapi-fetch": "^0.13.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "^2.3.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "openapi-typescript": "^7.5.2",
    "pg": "^8.13.1",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
