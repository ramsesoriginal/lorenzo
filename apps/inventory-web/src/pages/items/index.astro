---
import Base from '../../layouts/Base.astro';
import ItemForm from '../../components/ItemForm/ItemForm.astro';
---

<Base title="Manage items — Lorenzo">
  <p id="status">Loading&hellip;</p>

  <div id="page" hidden>
    <h1 class="display" id="tenant-name"></h1>

    <section class="section-lg" aria-labelledby="catalog-heading">
      <h2 id="catalog-heading">Catalog</h2>

      <p id="catalog-intro" class="field-note" hidden>
        Everything your GMs have put in the public catalog.
      </p>

      <div class="catalog-toolbar">
        <input
          type="search"
          id="catalog-search"
          class="text-input"
          placeholder="Search the item catalog…"
          aria-label="Search the item catalog"
        />
      </div>

      <p id="catalog-empty" hidden>No items match.</p>
      <p id="catalog-error" class="error-text" hidden></p>
      <ul id="catalog-list" class="catalog-list" hidden></ul>
    </section>

    <section id="instances" class="section-lg" aria-labelledby="instances-heading" hidden>
      <h2 id="instances-heading">Instances</h2>

      <div class="field">
        <span class="field-label" id="browse-label">View a being's inventory</span>

        <div class="combobox" id="browse-combobox">
          <input
            type="text"
            id="browse-search"
            class="text-input"
            placeholder="Search beings…"
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="browse-suggestions"
            aria-labelledby="browse-label"
          />

          <ul
            id="browse-suggestions"
            class="combobox-suggestions"
            role="listbox"
            hidden
          ></ul>
        </div>
      </div>

      <p id="instances-viewing" class="next-up" hidden></p>
      <p id="instances-empty" hidden></p>
      <p id="instances-error" class="error-text" hidden></p>
      <div id="instances-groups"></div>
    </section>

    <section id="new-item" class="section-lg" aria-labelledby="new-item-heading" hidden>
      <h2 id="new-item-heading">New item</h2>
      <div id="create-item-mount"></div>
    </section>
  </div>

  <!--
    Only emits the inert templates used by ItemForm/renderer.ts.
    Actual forms are cloned from it as needed.
  -->
  <ItemForm />

  <script>
    import { renderItemForm } from '../../components/ItemForm/renderer';

    import { isAuthenticated } from '../../lib/auth';
    import { renderBeingActionPanel, renderBeingSuggestions } from '../../lib/beingPicker';
    import { listBeings } from '../../lib/beings';
    import { readCatalogCache, writeCatalogCache } from '../../lib/catalogCache';
    import { descriptionRenderer } from '../../lib/descriptions';
    import { getDescription, saveDescription } from '../../lib/information';
    import {
      createCatalogItem,
      createItemInstance,
      deleteCatalogItem,
      deleteItemInstance,
      getEntityDetail,
      getOwnedItemInstances,
      listCatalogItems,
      listItemsUsingPrototype,
      setItemPrototypes,
      setOwner,
      unsetOwner,
      updateCatalogItem,
    } from '../../lib/items';
    import { isCampaignGm, isTenantMember, viewerId } from '../../lib/me';
    import { giveOrAsk } from '../../lib/moveAnyway';
    import { deleteSplitQuestion, isStackRefusal } from '../../lib/settingDown';
    import { saveSlug, slugField, suggestSlug } from '../../lib/slugs';
    import { getTenant } from '../../lib/tenants';
    import type {
      BeingRef,
      CatalogItem,
      EntitySummary,
      ItemInstance,
      OwnedGroup,
    } from '../../lib/types';

    const byId = (id: string) =>
      document.getElementById(id) as HTMLElement;

    const status = document.getElementById('status')!;
    const page = document.getElementById('page')!;
    const tenantName = document.getElementById('tenant-name')!;

    // Set once the page loads: whether this is Manage items or a
    // read-only catalog, and whose catalog the cache holds.
    let viewerIsGm = false;
    let viewer = '';

    const search =
      document.getElementById('catalog-search') as HTMLInputElement;

    const catalogEmpty = document.getElementById('catalog-empty')!;
    const catalogError = document.getElementById('catalog-error')!;
    const catalogList =
      document.getElementById('catalog-list') as HTMLUListElement;

    const createItemMount =
      document.getElementById('create-item-mount')!;

    const params = new URLSearchParams(window.location.search);
    const tenantId = params.get('tenant');

    // Created only after tenantId has been checked below.
    let renderer: ReturnType<typeof descriptionRenderer>;

    const reason = (e: unknown) =>
      e instanceof Error ? e.message : String(e);

    // --- Create item -------------------------------------------------------

    let createForm:
      | ReturnType<typeof renderItemForm>
      | null = null;

    function mountCreateItemForm() {
      createForm?.destroy();

      const rendered = renderItemForm({
        tenantId: tenantId as string,
        renderer,

        initial: {
          name: '',
          parents: new Map(),
          description: null,
          slug: '',
          inPublicCatalog: false,
        },

        submitLabel: 'Create item',
        followName: true,
        followSlug: true,

        onSubmit: async (values) => {
          const item = await createCatalogItem(
            tenantId as string,
            values.name,
            values.parentIds,
            values.inPublicCatalog,
          );

          // The item exists now, so a failed description or slug
          // mustn't leave this same form up to create it twice.
          const failed = (
            await Promise.all([
              saveDescription(
                tenantId as string,
                item.entity_id,
                null,
                values.description,
                values.name,
              )
                .then(() => null)
                .catch(
                  (e: unknown) =>
                    `its description (${reason(e)})`,
                ),

              saveSlug(
                tenantId as string,
                item.entity_id,
                null,
                values.slug,
              )
                .then(() => null)
                .catch(
                  (e: unknown) =>
                    `its slug (${reason(e)})`,
                ),
            ])
          ).filter(Boolean);

          rendered.destroy();
          createForm = null;

          await loadCatalog(search.value);

          // Fresh, empty form after a successful create.
          mountCreateItemForm();

          if (failed.length > 0) {
            window.alert(
              `“${values.name}” was created, but not ${failed.join(' or ')}.`,
            );
          }
        },
      });

      createForm = rendered;
      createItemMount.replaceChildren(rendered.element);
    }

    // --- Instantiate item --------------------------------------------------

    // The catalog's "Instantiate" panel - unlike renderCharacterActionPanel
    // (a single "pick one, do one thing" action), instantiating has two
    // real paths: assign straight to a picked character, or create with no
    // owner at all.
    //
    // Both can carry an optional slug (ADR 0043), left empty: filling it
    // for every instance would crowd the tenant's one slug namespace with
    // loot (ADR 0113). Its placeholder is the slug it would suggest, which
    // the item page can set later.
    function renderInstantiatePanel(
      item: CatalogItem,
      onDone: () => void,
    ): HTMLElement {
      const panel = document.createElement('div');
      panel.className = 'character-picker-panel';

      const slug = slugField('');
      const slugInput = slug.input;
      slugInput.placeholder = 'e.g. iron-sword-1';

      suggestSlug(
        tenantId as string,
        item.title,
        'instance',
      ).then(
        (suggestion) => {
          if (suggestion) {
            slugInput.placeholder = `e.g. ${suggestion}`;
          }
        },
        () => {},
      );

      const combobox = document.createElement('div');
      combobox.className = 'combobox';

      const input = document.createElement('input');
      input.type = 'text';
      input.className = 'text-input';
      input.placeholder = 'Search beings…';
      input.setAttribute('aria-label', 'Search beings');
      input.autocomplete = 'off';

      const suggestions = document.createElement('ul');
      suggestions.className = 'combobox-suggestions';
      suggestions.setAttribute('role', 'listbox');
      suggestions.hidden = true;

      combobox.append(input, suggestions);

      const noOwnerButton = document.createElement('button');
      noOwnerButton.type = 'button';
      noOwnerButton.textContent = 'Create without assigning';

      const statusEl = document.createElement('p');
      statusEl.className = 'picker-status';
      statusEl.hidden = true;

      panel.append(
        slug.element,
        combobox,
        noOwnerButton,
        statusEl,
      );

      let busy = false;

      async function finish(
        action: () => Promise<string>,
      ) {
        if (busy) return;

        busy = true;
        input.disabled = true;
        noOwnerButton.disabled = true;
        suggestions.hidden = true;

        try {
          const message = await action();

          statusEl.hidden = false;
          statusEl.classList.remove('error-text');
          statusEl.textContent = message;

          window.setTimeout(onDone, 1200);
        } catch (e) {
          statusEl.hidden = false;
          statusEl.classList.add('error-text');
          statusEl.textContent =
            e instanceof Error ? e.message : String(e);

          input.disabled = false;
          noOwnerButton.disabled = false;
          busy = false;
        }
      }

      let debounce:
        | ReturnType<typeof setTimeout>
        | undefined;

      input.addEventListener('input', () => {
        clearTimeout(debounce);

        const query = input.value.trim();

        if (!query) {
          suggestions.hidden = true;
          suggestions.replaceChildren();
          return;
        }

        debounce = setTimeout(async () => {
          const result = await listBeings(
            tenantId as string,
            query,
          );

          renderBeingSuggestions(
            suggestions,
            result.items,
            (being) => {
              void finish(async () => {
                await createItemInstance(
                  tenantId as string,
                  item.entity_id,
                  being.entity_id,
                  slugInput.value.trim() || undefined,
                );

                return `Created and assigned to ${being.name}.`;
              });
            },
          );
        }, 200);
      });

      input.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          onDone();
        }
      });

      noOwnerButton.addEventListener('click', () => {
        void finish(async () => {
          await createItemInstance(
            tenantId as string,
            item.entity_id,
            undefined,
            slugInput.value.trim() || undefined,
          );

          return 'Created without an owner.';
        });
      });

      window.setTimeout(() => input.focus(), 0);

      return panel;
    }

    // --- Catalog -----------------------------------------------------------

    // The standalone, shareable single-item page
    // (its own "Copy link").
    function createViewLink(
      entityId: string,
      slug?: string | null,
    ): HTMLAnchorElement {
      const link = document.createElement('a');
      link.className = 'btn btn-secondary';
      link.textContent = 'View';

      link.href = slug
        ? `/item/?tenant=${tenantId}&slug=${encodeURIComponent(slug)}`
        : `/item/?tenant=${tenantId}&id=${entityId}`;

      return link;
    }

    function renderCatalogItem(
      item: CatalogItem,
    ): HTMLLIElement {
      const li = document.createElement('li');
      li.className = 'catalog-row';

      const header = document.createElement('div');
      header.className = 'catalog-row-header';

      const title = document.createElement('span');
      title.className = 'catalog-row-title';
      title.textContent = item.title;

      // Beside the title, not in it: the title stays
      // the item's name alone.
      const name = document.createElement('span');
      name.append(title);

      if (viewerIsGm && item.in_public_catalog) {
        const chip = Object.assign(
          document.createElement('span'),
          {
            className: 'chip',
            textContent: 'Public',
          },
        );

        name.append(' ', chip);
      }

      const actions = document.createElement('div');
      actions.className = 'catalog-row-actions';

      const viewLink = createViewLink(item.entity_id);

      const editButton = document.createElement('button');
      editButton.type = 'button';
      editButton.textContent = 'Edit';

      const instantiateButton =
        document.createElement('button');
      instantiateButton.type = 'button';
      instantiateButton.textContent = 'Create instance';

      const deleteButton =
        document.createElement('button');
      deleteButton.type = 'button';
      deleteButton.className = 'btn-danger';
      deleteButton.textContent = 'Delete';

      // Only a GM changes the catalog; anyone else looks
      // items up (ADR 0116).
      actions.append(
        viewLink,
        ...(viewerIsGm
          ? [
              editButton,
              instantiateButton,
              deleteButton,
            ]
          : []),
      );

      header.append(name, actions);
      li.append(header);

      deleteButton.addEventListener(
        'click',
        async () => {
          if (
            !window.confirm(
              `Delete "${item.title}"? This can't be undone.`,
            )
          ) {
            return;
          }

          deleteButton.disabled = true;

          try {
            await deleteCatalogItem(
              tenantId as string,
              item.entity_id,
            );

            await loadCatalog(search.value);
          } catch (e) {
            deleteButton.disabled = false;

            window.alert(
              e instanceof Error ? e.message : String(e),
            );
          }
        },
      );

      // What an open edit form needs cleaned up when
      // its panel closes.
      let destroyEditForm = () => {};

      function closePanels() {
        destroyEditForm();
        destroyEditForm = () => {};

        li.querySelector(
          '.character-picker-panel',
        )?.remove();

        li.querySelector(
          '.edit-item-panel',
        )?.remove();

        instantiateButton.textContent =
          'Create instance';

        editButton.textContent = 'Edit';
      }

      editButton.addEventListener(
        'click',
        async () => {
          const wasOpen =
            editButton.textContent === 'Cancel';

          closePanels();

          if (wasOpen) return;

          editButton.textContent = 'Cancel';

          const panel =
            document.createElement('div');

          panel.className = 'edit-item-panel';
          panel.textContent = 'Loading…';

          li.append(panel);

          try {
            const [entity, usedBy, info] =
              await Promise.all([
                getEntityDetail(
                  tenantId as string,
                  item.entity_id,
                ),

                listItemsUsingPrototype(
                  tenantId as string,
                  item.entity_id,
                ),

                getDescription(
                  tenantId as string,
                  item.entity_id,
                ),
              ]);

            const parents = new Map(
              entity.prototypes.map(
                (prototype: EntitySummary) => [
                  prototype.id,
                  prototype.name,
                ],
              ),
            );

            // Its slug, or the one it would be given
            // (ADR 0113).
            const slug =
              entity.slug ??
              (await suggestSlug(
                tenantId as string,
                item.title,
                'item',
              ).catch(() => ''));

            const rendered = renderItemForm({
              tenantId: tenantId as string,
              renderer,

              initial: {
                // The entity's own name: item.title is its
                // description's display title (ADR 0019).
                name: entity.name,
                parents,
                description: info,
                slug,
                inPublicCatalog:
                  item.in_public_catalog,
                usedBy,
              },

              submitLabel: 'Save',

              onSubmit: async (values) => {
                await Promise.all([
                  updateCatalogItem(
                    tenantId as string,
                    item.entity_id,
                    values.name,
                    values.inPublicCatalog,
                  ),

                  setItemPrototypes(
                    tenantId as string,
                    item.entity_id,
                    values.parentIds,
                  ),
                ]);

                await saveDescription(
                  tenantId as string,
                  item.entity_id,
                  info,
                  values.description,
                  values.name,
                );

                await saveSlug(
                  tenantId as string,
                  item.entity_id,
                  entity.slug,
                  values.slug,
                );

                closePanels();

                // The row's title is the display title,
                // else the name (ADR 0067).
                await loadCatalog(search.value);
              },
            });

            destroyEditForm = rendered.destroy;

            panel.replaceChildren(
              rendered.element,
            );
          } catch (e) {
            panel.textContent =
              e instanceof Error
                ? e.message
                : String(e);
          }
        },
      );

      instantiateButton.addEventListener(
        'click',
        () => {
          const wasOpen =
            instantiateButton.textContent ===
            'Cancel';

          closePanels();

          if (wasOpen) return;

          instantiateButton.textContent =
            'Cancel';

          const panel = renderInstantiatePanel(
            item,
            () => closePanels(),
          );

          li.append(panel);
        },
      );

      return li;
    }

    let requestId = 0;

    function renderCatalogList(
      items: CatalogItem[],
    ) {
      catalogList.removeAttribute('aria-busy');

      if (items.length === 0) {
        catalogEmpty.hidden = false;
        catalogList.hidden = true;
        return;
      }

      catalogEmpty.hidden = true;

      catalogList.replaceChildren(
        ...items.map(renderCatalogItem),
      );

      catalogList.hidden = false;
    }

    function renderCatalogSkeleton() {
      catalogList.setAttribute(
        'aria-busy',
        'true',
      );

      catalogList.replaceChildren(
        ...Array.from({ length: 4 }, () => {
          const li =
            document.createElement('li');

          li.className =
            'catalog-row skeleton';

          return li;
        }),
      );

      catalogList.hidden = false;
    }

    async function loadCatalog(
      query: string,
    ) {
      const thisRequest = ++requestId;

      catalogError.hidden = true;

      // Cache-first, default (unfiltered) listing only -
      // see lib/catalogCache.ts for why. Paints instantly
      // from whatever was cached last session, then a fresh
      // fetch replaces it below. Read-only the whole time,
      // so a stale paint here can't cause a wrong write.
      let paintedFromCache = false;

      if (!query) {
        const cached = readCatalogCache(
          tenantId as string,
          viewer,
        );

        if (cached) {
          renderCatalogList(cached);
          paintedFromCache = true;
        }
      }

      if (!paintedFromCache) {
        renderCatalogSkeleton();
      }

      try {
        const result = await listCatalogItems(
          tenantId as string,
          query,
        );

        // A newer search superseded this one.
        if (thisRequest !== requestId) {
          return;
        }

        renderCatalogList(result);

        if (!query) {
          writeCatalogCache(
            tenantId as string,
            viewer,
            result,
          );
        }
      } catch (e) {
        if (thisRequest !== requestId) {
          return;
        }

        catalogList.removeAttribute('aria-busy');

        // Already showing (possibly stale) cached
        // content - a background refresh failure isn't
        // worth replacing it with a hard error.
        if (paintedFromCache) {
          return;
        }

        catalogList.hidden = true;
        catalogError.hidden = false;

        catalogError.textContent =
          e instanceof Error
            ? e.message
            : String(e);
      }
    }

    let searchDebounce:
      | ReturnType<typeof setTimeout>
      | undefined;

    search.addEventListener('input', () => {
      clearTimeout(searchDebounce);

      searchDebounce = setTimeout(
        () => void loadCatalog(search.value),
        300,
      );
    });

    // --- Instances: browse a character's inventory and reassign owners ---

    const browseSearch =
      document.getElementById(
        'browse-search',
      ) as HTMLInputElement;

    const browseSuggestions =
      document.getElementById(
        'browse-suggestions',
      ) as HTMLUListElement;

    const instancesViewing =
      document.getElementById(
        'instances-viewing',
      )!;

    const instancesEmpty =
      document.getElementById(
        'instances-empty',
      )!;

    const instancesError =
      document.getElementById(
        'instances-error',
      )!;

    const instancesGroups =
      document.getElementById(
        'instances-groups',
      )!;

    let currentCharacter:
      | BeingRef
      | null = null;

    let instancesRequestId = 0;

    function renderInstanceRow(
      instance: ItemInstance,
    ): HTMLLIElement {
      const li = document.createElement('li');
      li.className = 'catalog-row';

      const header =
        document.createElement('div');

      header.className =
        'catalog-row-header';

      const title =
        document.createElement('span');

      title.className =
        'catalog-row-title';

      title.textContent =
        instance.quantity &&
        instance.quantity > 1
          ? `${instance.title} ×${instance.quantity}`
          : instance.title;

      if (instance.slug) {
        const slug =
          document.createElement('code');

        slug.className =
          'catalog-row-slug';

        slug.textContent = instance.slug;

        title.append(' ', slug);
      }

      const actions =
        document.createElement('div');

      actions.className =
        'catalog-row-actions';

      const viewLink = createViewLink(
        instance.entity_id,
        instance.slug,
      );

      const reassignButton =
        document.createElement('button');

      reassignButton.type = 'button';
      reassignButton.textContent =
        'Reassign';

      const unassignButton =
        document.createElement('button');

      unassignButton.type = 'button';
      unassignButton.textContent =
        'Unassign';

      unassignButton.hidden =
        !instance.owner_entity_id;

      const deleteButton =
        document.createElement('button');

      deleteButton.type = 'button';
      deleteButton.className =
        'btn-danger';

      deleteButton.textContent =
        'Delete';

      actions.append(
        viewLink,
        reassignButton,
        unassignButton,
        deleteButton,
      );

      header.append(title, actions);
      li.append(header);

      unassignButton.addEventListener(
        'click',
        async () => {
          unassignButton.disabled = true;

          try {
            // A bound item's GM is asked to take it
            // anyway (ADR 0129).
            await giveOrAsk(
              (flags) =>
                unsetOwner(
                  tenantId as string,
                  instance.entity_id,
                  flags,
                ),
              {
                canOverride: viewerIsGm,
                ask: (question) =>
                  window.confirm(question),
              },
            );

            // Unowned items don't show up under
            // any character's view.
            if (currentCharacter) {
              void loadInstancesFor(
                currentCharacter,
              );
            }
          } catch (e) {
            unassignButton.disabled = false;

            window.alert(
              e instanceof Error
                ? e.message
                : String(e),
            );
          }
        },
      );

      reassignButton.addEventListener(
        'click',
        () => {
          const existingPanel =
            li.querySelector(
              '.character-picker-panel',
            );

          if (existingPanel) {
            existingPanel.remove();

            reassignButton.textContent =
              'Reassign';

            return;
          }

          reassignButton.textContent =
            'Cancel';

          const panel =
            renderBeingActionPanel(
              tenantId as string,

              async (being) => {
                await giveOrAsk(
                  (flags) =>
                    setOwner(
                      tenantId as string,
                      instance.entity_id,
                      being.entity_id,
                      false,
                      flags,
                    ),
                  {
                    canOverride: viewerIsGm,
                    ask: (question) =>
                      window.confirm(
                        question,
                      ),
                  },
                );

                return `Reassigned to ${being.name}.`;
              },

              () => {
                panel.remove();

                reassignButton.textContent =
                  'Reassign';

                // The item likely just left this
                // character - refresh the view.
                if (currentCharacter) {
                  void loadInstancesFor(
                    currentCharacter,
                  );
                }
              },
            );

          li.append(panel);
        },
      );

      deleteButton.addEventListener(
        'click',
        async () => {
          if (
            !window.confirm(
              `Delete "${instance.title}"? This can't be undone.`,
            )
          ) {
            return;
          }

          deleteButton.disabled = true;

          try {
            try {
              await deleteItemInstance(
                tenantId as string,
                instance.entity_id,
              );
            } catch (e) {
              // What was inside is set down; a stack
              // only as single items, asked first
              // (ADR 0132).
              if (
                !isStackRefusal(e) ||
                !window.confirm(
                  deleteSplitQuestion(
                    instance.title,
                  ),
                )
              ) {
                throw e;
              }

              await deleteItemInstance(
                tenantId as string,
                instance.entity_id,
                { split: true },
              );
            }

            if (currentCharacter) {
              void loadInstancesFor(
                currentCharacter,
              );
            }
          } catch (e) {
            deleteButton.disabled = false;

            window.alert(
              e instanceof Error
                ? e.message
                : String(e),
            );
          }
        },
      );

      return li;
    }

    function renderInstanceGroup(
      group: OwnedGroup,
      rootTitle: string,
    ): HTMLElement {
      const section =
        document.createElement('div');

      section.className = 'section';

      const heading =
        document.createElement('h3');

      heading.textContent =
        group.container?.name ??
        rootTitle;

      section.append(heading);

      const list =
        document.createElement('ul');

      list.className = 'catalog-list';

      for (
        const instance of
        group.item_instances
      ) {
        list.append(
          renderInstanceRow(instance),
        );
      }

      section.append(list);

      return section;
    }

    async function loadInstancesFor(
      character: BeingRef,
    ) {
      currentCharacter = character;

      const thisRequest =
        ++instancesRequestId;

      instancesViewing.hidden = false;

      instancesViewing.textContent =
        `Viewing ${character.name}'s inventory.`;

      instancesEmpty.hidden = true;
      instancesError.hidden = true;

      instancesGroups.replaceChildren();

      try {
        const response =
          await getOwnedItemInstances(
            tenantId as string,
            character.entity_id,
          );

        if (
          thisRequest !==
          instancesRequestId
        ) {
          return;
        }

        const hasAnything =
          response.groups.some(
            (group) =>
              group.item_instances.length >
              0,
          );

        if (!hasAnything) {
          instancesEmpty.hidden = false;

          instancesEmpty.textContent =
            `${character.name} isn't carrying anything.`;

          return;
        }

        for (
          const group of response.groups
        ) {
          if (
            group.item_instances.length >
            0
          ) {
            instancesGroups.append(
              renderInstanceGroup(
                group,
                character.name,
              ),
            );
          }
        }
      } catch (e) {
        if (
          thisRequest !==
          instancesRequestId
        ) {
          return;
        }

        instancesError.hidden = false;

        instancesError.textContent =
          e instanceof Error
            ? e.message
            : String(e);
      }
    }

    let browseDebounce:
      | ReturnType<typeof setTimeout>
      | undefined;

    browseSearch.addEventListener(
      'input',
      () => {
        clearTimeout(browseDebounce);

        const query =
          browseSearch.value.trim();

        if (!query) {
          browseSuggestions.hidden =
            true;

          browseSuggestions.replaceChildren();

          return;
        }

        browseDebounce = setTimeout(
          async () => {
            const result =
              await listBeings(
                tenantId as string,
                query,
              );

            renderBeingSuggestions(
              browseSuggestions,
              result.items,
              (being) => {
                browseSearch.value =
                  being.name;

                browseSuggestions.hidden =
                  true;

                void loadInstancesFor(
                  being,
                );
              },
            );
          },
          200,
        );
      },
    );

    browseSearch.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape') {
          browseSuggestions.hidden =
            true;
        }
      },
    );

    document.addEventListener(
      'click',
      (event) => {
        const combobox =
          document.getElementById(
            'browse-combobox',
          )!;

        if (
          !combobox.contains(
            event.target as Node,
          )
        ) {
          browseSuggestions.hidden =
            true;
        }
      },
    );

    // --- Page initialization ----------------------------------------------

    if (!(await isAuthenticated())) {
      status.textContent =
        "You're not logged in. Log in to continue.";
    } else if (!tenantId) {
      status.textContent =
        'No tenant selected. Pick one to continue.';
    } else {
      try {
        // We now know tenantId is real, so the description renderer
        // can be created without constructing it from null.
        renderer =
          descriptionRenderer(tenantId);

        // GMs manage the catalog here; anyone else browses what
        // they may list: the public catalog, for players (ADR 0116).
        [viewerIsGm, viewer] =
          await Promise.all([
            isCampaignGm(tenantId),
            viewerId(),
          ]);

        const tenant =
          await getTenant(tenantId);

        status.hidden = true;
        tenantName.textContent =
          tenant.name;

        document.title = viewerIsGm
          ? 'Manage items — Lorenzo'
          : 'Catalog — Lorenzo';

        byId('new-item').hidden =
          !viewerIsGm;

        byId('instances').hidden =
          !viewerIsGm;

        byId('catalog-intro').hidden =
          viewerIsGm ||
          (await isTenantMember(
            tenantId,
          ));

        page.hidden = false;

        if (viewerIsGm) {
          mountCreateItemForm();
        }

        await loadCatalog('');
      } catch (e) {
        status.textContent =
          e instanceof Error
            ? e.message
            : String(e);
      }
    }
  </script>
</Base>
