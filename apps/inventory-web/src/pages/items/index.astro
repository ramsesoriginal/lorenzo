---
import Base from '../../layouts/Base.astro';
import Catalog from '../../components/Catalog/Catalog.astro';
import Instances from '../../components/Instances/Instances.astro';
import InstantiateItem from '../../components/InstantiateItem/InstantiateItem.astro';
import ItemForm from '../../components/ItemForm/ItemForm.astro';
---

<Base title="Manage items — Lorenzo">
  <p id="status">Loading&hellip;</p>

  <div id="page" hidden>
    <h1 class="display" id="tenant-name"></h1>

    <Catalog />

    <Instances />

    <section
      id="new-item"
      class="section-lg"
      aria-labelledby="new-item-heading"
      hidden
    >
      <h2 id="new-item-heading">New item</h2>
      <div id="create-item-mount"></div>
    </section>
  </div>

  <!-- Inert templates used by the client-side renderers. -->
  <ItemForm />
  <InstantiateItem />

  <script>
    import { renderCatalog } from '../../components/Catalog/renderer';
    import { renderInstances } from '../../components/Instances/renderer';
    import { renderInstantiateItem } from '../../components/InstantiateItem/renderer';
    import { renderItemForm } from '../../components/ItemForm/renderer';

    import { isAuthenticated } from '../../lib/auth';
    import { descriptionRenderer } from '../../lib/descriptions';
    import { saveDescription } from '../../lib/information';
    import { createCatalogItem } from '../../lib/items';
    import {
      isCampaignGm,
      isTenantMember,
      viewerId,
    } from '../../lib/me';
    import { saveSlug } from '../../lib/slugs';
    import { getTenant } from '../../lib/tenants';

    const status =
      document.getElementById('status')!;

    const page =
      document.getElementById('page')!;

    const tenantName =
      document.getElementById('tenant-name')!;

    const createItemMount =
      document.getElementById('create-item-mount')!;

    const params =
      new URLSearchParams(window.location.search);

    const tenantId =
      params.get('tenant');

    let viewerIsGm = false;
    let viewer = '';

    let renderer:
      ReturnType<typeof descriptionRenderer>;

    let catalog:
      ReturnType<typeof renderCatalog>;

    const reason = (error: unknown) =>
      error instanceof Error
        ? error.message
        : String(error);

    // ---------------------------------------------------------------------
    // Create item
    // ---------------------------------------------------------------------

    let createForm:
      | ReturnType<typeof renderItemForm>
      | null = null;

    function mountCreateItemForm() {
      createForm?.destroy();

      const rendered = renderItemForm({
        tenantId: tenantId as string,
        renderer,

        initial: {
          name: '',
          parents: new Map(),
          description: null,
          slug: '',
          inPublicCatalog: false,
        },

        submitLabel: 'Create item',
        followName: true,
        followSlug: true,

        onSubmit: async (values) => {
          const item = await createCatalogItem(
            tenantId as string,
            values.name,
            values.parentIds,
            values.inPublicCatalog,
          );

          /*
           * The catalog item exists after createCatalogItem().
           *
           * Description and slug are separate writes. If either of those
           * fails, replace the form anyway so submitting it again doesn't
           * accidentally create the same catalog item twice.
           */
          const failed = (
            await Promise.all([
              saveDescription(
                tenantId as string,
                item.entity_id,
                null,
                values.description,
                values.name,
              )
                .then(() => null)
                .catch(
                  (error: unknown) =>
                    `its description (${reason(error)})`,
                ),

              saveSlug(
                tenantId as string,
                item.entity_id,
                null,
                values.slug,
              )
                .then(() => null)
                .catch(
                  (error: unknown) =>
                    `its slug (${reason(error)})`,
                ),
            ])
          ).filter(Boolean);

          rendered.destroy();
          createForm = null;

          await catalog.reload();

          mountCreateItemForm();

          if (failed.length > 0) {
            window.alert(
              `“${values.name}” was created, but not ${failed.join(' or ')}.`,
            );
          }
        },
      });

      createForm = rendered;

      createItemMount.replaceChildren(
        rendered.element,
      );
    }

    // ---------------------------------------------------------------------
    // Page initialization
    // ---------------------------------------------------------------------

    if (!(await isAuthenticated())) {
      status.textContent =
        "You're not logged in. Log in to continue.";
    } else if (!tenantId) {
      status.textContent =
        'No tenant selected. Pick one to continue.';
    } else {
      try {
        /*
         * tenantId is known from here on, so tenant-specific components
         * can be initialized safely.
         */
        renderer =
          descriptionRenderer(tenantId);

        [viewerIsGm, viewer] =
          await Promise.all([
            isCampaignGm(tenantId),
            viewerId(),
          ]);

        const [
          tenant,
          viewerIsMember,
        ] = await Promise.all([
          getTenant(tenantId),
          isTenantMember(tenantId),
        ]);

        tenantName.textContent =
          tenant.name;

        document.title =
          viewerIsGm
            ? 'Manage items — Lorenzo'
            : 'Catalog — Lorenzo';

        // -----------------------------------------------------------------
        // Catalog
        // -----------------------------------------------------------------

        const catalogRoot =
          document.querySelector<HTMLElement>(
            '[data-catalog]',
          );

        if (!catalogRoot) {
          throw new Error(
            'Catalog component not found.',
          );
        }

        catalog = renderCatalog({
          root: catalogRoot,

          tenantId,
          viewerId: viewer,
          viewerIsGm,

          showIntro:
            !viewerIsGm &&
            !viewerIsMember,

          renderer,

          renderInstantiate: (
            item,
            onDone,
          ) =>
            renderInstantiateItem({
              tenantId,
              item,
              onDone,
            }),
        });

        // -----------------------------------------------------------------
        // Instances
        // -----------------------------------------------------------------

        const instancesRoot =
          document.querySelector<HTMLElement>(
            '[data-instances]',
          );

        if (!instancesRoot) {
          throw new Error(
            'Instances component not found.',
          );
        }

        const instances =
          renderInstances({
            root: instancesRoot,
            tenantId,
            viewerIsGm,
          });

        // -----------------------------------------------------------------
        // GM-only UI
        // -----------------------------------------------------------------

        const newItemSection =
          document.getElementById(
            'new-item',
          )!;

        newItemSection.hidden =
          !viewerIsGm;

        if (viewerIsGm) {
          mountCreateItemForm();
          instances.show();
        } else {
          instances.hide();
        }

        // -----------------------------------------------------------------
        // Ready
        // -----------------------------------------------------------------

        page.hidden = false;
        status.hidden = true;

        await catalog.reload();
      } catch (error) {
        status.hidden = false;

        status.textContent =
          error instanceof Error
            ? error.message
            : String(error);
      }
    }
  </script>
</Base>
