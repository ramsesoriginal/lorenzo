---
import Base from '../../layouts/Base.astro';
import Catalog from '../../components/Catalog/Catalog.astro';
import Instances from '../../components/Instances/Instances.astro';
import InstantiateItem from '../../components/InstantiateItem/InstantiateItem.astro';
import ItemDetail from '../../components/ItemDetail/ItemDetail.astro';
import ItemForm from '../../components/ItemForm/ItemForm.astro';
---

<Base title="Manage items — Lorenzo">
  <p id="status">
    Loading&hellip; <span class="spinner" role="status" aria-label="Loading"></span>
  </p>

  <div id="page" hidden>
    <h1 class="display" id="tenant-name"></h1>

    <Catalog />

    <Instances />

    <section id="new-item" class="section-lg" aria-labelledby="new-item-heading" hidden>
      <h2 id="new-item-heading">New item</h2>
      <div id="create-item-mount"></div>
    </section>
  </div>

  <!-- Inert templates used by the client-side renderers. -->
  <ItemForm />
  <InstantiateItem />
  <ItemDetail />

  <script>
    import { renderCatalog } from '../../components/Catalog/renderer';
    import { renderInstances } from '../../components/Instances/renderer';
    import { renderInstantiateItem } from '../../components/InstantiateItem/renderer';
    import { renderItemDetail } from '../../components/ItemDetail/renderer';
    import { renderItemForm } from '../../components/ItemForm/renderer';

    import { addressedTenant, tenantAddress } from '../../lib/addresses';
    import { isAuthenticated } from '../../lib/auth';
    import { descriptionRenderer } from '../../lib/descriptions';
    import { saveDescription } from '../../lib/information';
    import { createCatalogItem } from '../../lib/items';
    import { isCampaignGm, isTenantMember, viewerId } from '../../lib/me';
    import { saveSlug } from '../../lib/slugs';
    import { getTenant } from '../../lib/tenants';

    const status = document.getElementById('status')!;
    const page = document.getElementById('page')!;
    const tenantName = document.getElementById('tenant-name')!;
    const createItemMount = document.getElementById('create-item-mount')!;

    // By id or by slug (ADR 0135).
    const addressed = await addressedTenant(
      new URLSearchParams(window.location.search).get('tenant'),
    );
    const tenantId = addressed.id;

    let renderer: ReturnType<typeof descriptionRenderer>;
    let catalog: ReturnType<typeof renderCatalog>;
    let createForm: ReturnType<typeof renderItemForm> | null = null;

    const reason = (error: unknown) => (error instanceof Error ? error.message : String(error));

    function mountCreateItemForm() {
      createForm?.destroy();

      const rendered = renderItemForm({
        tenantId: tenantId as string,
        renderer,
        initial: {
          name: '',
          parents: new Map(),
          description: null,
          slug: '',
          inPublicCatalog: false,
        },
        submitLabel: 'Create item',
        followName: true,
        followSlug: true,
        onSubmit: async (values) => {
          const item = await createCatalogItem(
            tenantId as string,
            values.name,
            values.parentIds,
            values.inPublicCatalog,
          );

          // The item exists now. Its description and slug are separate writes, so
          // the form is replaced even when one fails: submitting it again would
          // create the item twice.
          const failed = (
            await Promise.all([
              saveDescription(
                tenantId as string,
                item.entity_id,
                null,
                values.description,
                values.name,
              )
                .then(() => null)
                .catch((error: unknown) => `its description (${reason(error)})`),
              saveSlug(tenantId as string, item.entity_id, null, values.slug)
                .then(() => null)
                .catch((error: unknown) => `its slug (${reason(error)})`),
            ])
          ).filter(Boolean);

          rendered.destroy();
          createForm = null;

          await catalog.reload();
          mountCreateItemForm();

          if (failed.length > 0) {
            window.alert(`“${values.name}” was created, but not ${failed.join(' or ')}.`);
          }
        },
      });

      createForm = rendered;
      createItemMount.replaceChildren(rendered.element);
    }

    if (!(await isAuthenticated())) {
      status.textContent = "You're not logged in. Log in to continue.";
    } else if (!tenantId) {
      status.textContent = addressed.problem ?? 'No tenant selected. Pick one to continue.';
    } else {
      try {
        renderer = descriptionRenderer(tenantId);

        const [viewerIsGm, viewer, tenant, viewerIsMember] = await Promise.all([
          isCampaignGm(tenantId),
          viewerId(),
          getTenant(tenantId),
          isTenantMember(tenantId),
        ]);

        tenantName.textContent = tenant.name;
        document.title = viewerIsGm ? 'Manage items — Lorenzo' : 'Catalog — Lorenzo';

        const catalogRoot = document.querySelector<HTMLElement>('[data-catalog]');
        const instancesRoot = document.querySelector<HTMLElement>('[data-instances]');
        const detailRoot = document.querySelector<HTMLDialogElement>('[data-item-detail]');

        if (!catalogRoot || !instancesRoot || !detailRoot) {
          throw new Error('Catalog, Instances or Item detail component not found.');
        }

        // Items and instances open in the dialog the board uses, without the board's actions.
        const detail = renderItemDetail({
          root: detailRoot,
          tenantId,
          tenantSlug: await tenantAddress(tenant),
          viewerIsGm,
          renderer,
          myCharacters: () => [],
        });

        catalog = renderCatalog({
          root: catalogRoot,
          tenantId,
          viewerId: viewer,
          viewerIsGm,
          showIntro: !viewerIsGm && !viewerIsMember,
          renderer,
          renderInstantiate: (item, onDone) => renderInstantiateItem({ tenantId, item, onDone }),
          onView: (item) => detail.view(item),
          onPrefetch: (item) => detail.prefetch(item),
        });

        const instances = renderInstances({
          root: instancesRoot,
          tenantId,
          viewerIsGm,
          onView: (instance) => detail.view(instance),
          onPrefetch: (instance) => detail.prefetch(instance),
        });

        document.getElementById('new-item')!.hidden = !viewerIsGm;

        if (viewerIsGm) {
          mountCreateItemForm();
          instances.show();
        } else {
          instances.hide();
        }

        page.hidden = false;
        status.hidden = true;

        await catalog.reload();
      } catch (error) {
        status.hidden = false;
        status.textContent = reason(error);
      }
    }
  </script>
</Base>
