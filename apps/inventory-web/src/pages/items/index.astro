---
import Base from '../../layouts/Base.astro';
import ItemForm from '../../components/ItemForm/ItemForm.astro';
import Catalog from '../../components/Catalog/Catalog.astro';
---

<Base title="Manage items — Lorenzo">
  <p id="status">Loading&hellip;</p>

  <div id="page" hidden>
    <h1 class="display" id="tenant-name"></h1>

    <Catalog />

    <section
      id="instances"
      class="section-lg"
      aria-labelledby="instances-heading"
      hidden
    >
      <h2 id="instances-heading">Instances</h2>

      <div class="field">
        <span class="field-label" id="browse-label">
          View a being's inventory
        </span>

        <div class="combobox" id="browse-combobox">
          <input
            type="text"
            id="browse-search"
            class="text-input"
            placeholder="Search beings…"
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="browse-suggestions"
            aria-labelledby="browse-label"
          />

          <ul
            id="browse-suggestions"
            class="combobox-suggestions"
            role="listbox"
            hidden
          ></ul>
        </div>
      </div>

      <p
        id="instances-viewing"
        class="next-up"
        hidden
      ></p>

      <p id="instances-empty" hidden></p>

      <p
        id="instances-error"
        class="error-text"
        hidden
      ></p>

      <div id="instances-groups"></div>
    </section>

    <section
      id="new-item"
      class="section-lg"
      aria-labelledby="new-item-heading"
      hidden
    >
      <h2 id="new-item-heading">New item</h2>
      <div id="create-item-mount"></div>
    </section>

  </div>

  <!-- Inert HTML templates used by ItemForm/renderer.ts. -->
  <ItemForm />

  <script>
    import { renderCatalog } from '../../components/Catalog/renderer';
    import { renderItemForm } from '../../components/ItemForm/renderer';

    import { isAuthenticated } from '../../lib/auth';
    import {
      renderBeingActionPanel,
      renderBeingSuggestions,
    } from '../../lib/beingPicker';
    import { listBeings } from '../../lib/beings';
    import { descriptionRenderer } from '../../lib/descriptions';
    import { saveDescription } from '../../lib/information';
    import {
      createCatalogItem,
      createItemInstance,
      deleteItemInstance,
      getOwnedItemInstances,
      setOwner,
      unsetOwner,
    } from '../../lib/items';
    import {
      isCampaignGm,
      isTenantMember,
      viewerId,
    } from '../../lib/me';
    import { giveOrAsk } from '../../lib/moveAnyway';
    import {
      deleteSplitQuestion,
      isStackRefusal,
    } from '../../lib/settingDown';
    import {
      saveSlug,
      slugField,
      suggestSlug,
    } from '../../lib/slugs';
    import { getTenant } from '../../lib/tenants';
    import type {
      BeingRef,
      CatalogItem,
      ItemInstance,
      OwnedGroup,
    } from '../../lib/types';

    const byId = (id: string) =>
      document.getElementById(id) as HTMLElement;

    const status = document.getElementById('status')!;
    const page = document.getElementById('page')!;
    const tenantName = document.getElementById('tenant-name')!;

    const createItemMount =
      document.getElementById('create-item-mount')!;

    const params = new URLSearchParams(window.location.search);
    const tenantId = params.get('tenant');

    let viewerIsGm = false;
    let viewer = '';

    const reason = (e: unknown) =>
      e instanceof Error ? e.message : String(e);

    /*
     * Initialized once authentication / tenant lookup succeeds.
     */
    let renderer: ReturnType<typeof descriptionRenderer>;
    let catalog: ReturnType<typeof renderCatalog>;

    // ---------------------------------------------------------------------
    // Create catalog item
    // ---------------------------------------------------------------------

    let createForm:
      | ReturnType<typeof renderItemForm>
      | null = null;

    function mountCreateItemForm() {
      createForm?.destroy();

      const rendered = renderItemForm({
        tenantId: tenantId as string,
        renderer,

        initial: {
          name: '',
          parents: new Map(),
          description: null,
          slug: '',
          inPublicCatalog: false,
        },

        submitLabel: 'Create item',
        followName: true,
        followSlug: true,

        onSubmit: async (values) => {
          const item = await createCatalogItem(
            tenantId as string,
            values.name,
            values.parentIds,
            values.inPublicCatalog,
          );

          /*
           * The item now exists.
           *
           * Description and slug are separate writes, so if either fails
           * we still replace the form instead of letting the user create
           * the same catalog item a second time.
           */
          const failed = (
            await Promise.all([
              saveDescription(
                tenantId as string,
                item.entity_id,
                null,
                values.description,
                values.name,
              )
                .then(() => null)
                .catch(
                  (e: unknown) =>
                    `its description (${reason(e)})`,
                ),

              saveSlug(
                tenantId as string,
                item.entity_id,
                null,
                values.slug,
              )
                .then(() => null)
                .catch(
                  (e: unknown) =>
                    `its slug (${reason(e)})`,
                ),
            ])
          ).filter(Boolean);

          rendered.destroy();
          createForm = null;

          await catalog.reload();

          // A fresh empty form after successful creation.
          mountCreateItemForm();

          if (failed.length > 0) {
            window.alert(
              `“${values.name}” was created, but not ${failed.join(' or ')}.`,
            );
          }
        },
      });

      createForm = rendered;

      createItemMount.replaceChildren(
        rendered.element,
      );
    }

    // ---------------------------------------------------------------------
    // Instantiate catalog item
    //
    // This is still page-local for now. It would be a good next candidate
    // for its own component + renderer.
    // ---------------------------------------------------------------------

    function renderInstantiatePanel(
      item: CatalogItem,
      onDone: () => void,
    ): HTMLElement {
      const panel = document.createElement('div');
      panel.className = 'character-picker-panel';

      const slug = slugField('');
      const slugInput = slug.input;

      slugInput.placeholder =
        'e.g. iron-sword-1';

      suggestSlug(
        tenantId as string,
        item.title,
        'instance',
      ).then(
        (suggestion) => {
          if (suggestion) {
            slugInput.placeholder =
              `e.g. ${suggestion}`;
          }
        },
        () => {},
      );

      const combobox =
        document.createElement('div');

      combobox.className = 'combobox';

      const input =
        document.createElement('input');

      input.type = 'text';
      input.className = 'text-input';
      input.placeholder = 'Search beings…';
      input.setAttribute(
        'aria-label',
        'Search beings',
      );
      input.autocomplete = 'off';

      const suggestions =
        document.createElement('ul');

      suggestions.className =
        'combobox-suggestions';

      suggestions.setAttribute(
        'role',
        'listbox',
      );

      suggestions.hidden = true;

      combobox.append(
        input,
        suggestions,
      );

      const noOwnerButton =
        document.createElement('button');

      noOwnerButton.type = 'button';
      noOwnerButton.textContent =
        'Create without assigning';

      const statusEl =
        document.createElement('p');

      statusEl.className = 'picker-status';
      statusEl.hidden = true;

      panel.append(
        slug.element,
        combobox,
        noOwnerButton,
        statusEl,
      );

      let busy = false;

      async function finish(
        action: () => Promise<string>,
      ) {
        if (busy) return;

        busy = true;

        input.disabled = true;
        noOwnerButton.disabled = true;
        suggestions.hidden = true;

        try {
          const message = await action();

          statusEl.hidden = false;
          statusEl.classList.remove(
            'error-text',
          );
          statusEl.textContent = message;

          window.setTimeout(
            onDone,
            1200,
          );
        } catch (e) {
          statusEl.hidden = false;
          statusEl.classList.add(
            'error-text',
          );
          statusEl.textContent =
            e instanceof Error
              ? e.message
              : String(e);

          input.disabled = false;
          noOwnerButton.disabled = false;
          busy = false;
        }
      }

      let debounce:
        | ReturnType<typeof setTimeout>
        | undefined;

      input.addEventListener(
        'input',
        () => {
          clearTimeout(debounce);

          const query =
            input.value.trim();

          if (!query) {
            suggestions.hidden = true;
            suggestions.replaceChildren();
            return;
          }

          debounce = setTimeout(
            async () => {
              const result =
                await listBeings(
                  tenantId as string,
                  query,
                );

              renderBeingSuggestions(
                suggestions,
                result.items,
                (being) => {
                  void finish(
                    async () => {
                      await createItemInstance(
                        tenantId as string,
                        item.entity_id,
                        being.entity_id,
                        slugInput.value.trim() ||
                          undefined,
                      );

                      return `Created and assigned to ${being.name}.`;
                    },
                  );
                },
              );
            },
            200,
          );
        },
      );

      input.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape') {
            onDone();
          }
        },
      );

      noOwnerButton.addEventListener(
        'click',
        () => {
          void finish(async () => {
            await createItemInstance(
              tenantId as string,
              item.entity_id,
              undefined,
              slugInput.value.trim() ||
                undefined,
            );

            return 'Created without an owner.';
          });
        },
      );

      window.setTimeout(
        () => input.focus(),
        0,
      );

      return panel;
    }

    // ---------------------------------------------------------------------
    // Instances
    // ---------------------------------------------------------------------

    const browseSearch =
      document.getElementById(
        'browse-search',
      ) as HTMLInputElement;

    const browseSuggestions =
      document.getElementById(
        'browse-suggestions',
      ) as HTMLUListElement;

    const instancesViewing =
      document.getElementById(
        'instances-viewing',
      )!;

    const instancesEmpty =
      document.getElementById(
        'instances-empty',
      )!;

    const instancesError =
      document.getElementById(
        'instances-error',
      )!;

    const instancesGroups =
      document.getElementById(
        'instances-groups',
      )!;

    let currentCharacter:
      | BeingRef
      | null = null;

    let instancesRequestId = 0;

    function createViewLink(
      entityId: string,
      slug?: string | null,
    ): HTMLAnchorElement {
      const link =
        document.createElement('a');

      link.className =
        'btn btn-secondary';

      link.textContent = 'View';

      link.href = slug
        ? `/item/?tenant=${tenantId}&slug=${encodeURIComponent(slug)}`
        : `/item/?tenant=${tenantId}&id=${entityId}`;

      return link;
    }

    function renderInstanceRow(
      instance: ItemInstance,
    ): HTMLLIElement {
      const li =
        document.createElement('li');

      li.className = 'catalog-row';

      const header =
        document.createElement('div');

      header.className =
        'catalog-row-header';

      const title =
        document.createElement('span');

      title.className =
        'catalog-row-title';

      title.textContent =
        instance.quantity &&
        instance.quantity > 1
          ? `${instance.title} ×${instance.quantity}`
          : instance.title;

      if (instance.slug) {
        const slug =
          document.createElement('code');

        slug.className =
          'catalog-row-slug';

        slug.textContent =
          instance.slug;

        title.append(' ', slug);
      }

      const actions =
        document.createElement('div');

      actions.className =
        'catalog-row-actions';

      const viewLink =
        createViewLink(
          instance.entity_id,
          instance.slug,
        );

      const reassignButton =
        document.createElement('button');

      reassignButton.type = 'button';
      reassignButton.textContent =
        'Reassign';

      const unassignButton =
        document.createElement('button');

      unassignButton.type = 'button';
      unassignButton.textContent =
        'Unassign';

      unassignButton.hidden =
        !instance.owner_entity_id;

      const deleteButton =
        document.createElement('button');

      deleteButton.type = 'button';
      deleteButton.className =
        'btn-danger';
      deleteButton.textContent =
        'Delete';

      actions.append(
        viewLink,
        reassignButton,
        unassignButton,
        deleteButton,
      );

      header.append(
        title,
        actions,
      );

      li.append(header);

      unassignButton.addEventListener(
        'click',
        async () => {
          unassignButton.disabled = true;

          try {
            // A bound item's GM is asked to take it
            // anyway (ADR 0129).
            await giveOrAsk(
              (flags) =>
                unsetOwner(
                  tenantId as string,
                  instance.entity_id,
                  flags,
                ),
              {
                canOverride: viewerIsGm,
                ask: (question) =>
                  window.confirm(question),
              },
            );

            // Unowned items don't show up under any
            // character's view.
            if (currentCharacter) {
              void loadInstancesFor(
                currentCharacter,
              );
            }
          } catch (e) {
            unassignButton.disabled =
              false;

            window.alert(
              e instanceof Error
                ? e.message
                : String(e),
            );
          }
        },
      );

      reassignButton.addEventListener(
        'click',
        () => {
          const existingPanel =
            li.querySelector(
              '.character-picker-panel',
            );

          if (existingPanel) {
            existingPanel.remove();

            reassignButton.textContent =
              'Reassign';

            return;
          }

          reassignButton.textContent =
            'Cancel';

          const panel =
            renderBeingActionPanel(
              tenantId as string,

              async (being) => {
                await giveOrAsk(
                  (flags) =>
                    setOwner(
                      tenantId as string,
                      instance.entity_id,
                      being.entity_id,
                      false,
                      flags,
                    ),
                  {
                    canOverride:
                      viewerIsGm,

                    ask: (question) =>
                      window.confirm(
                        question,
                      ),
                  },
                );

                return `Reassigned to ${being.name}.`;
              },

              () => {
                panel.remove();

                reassignButton.textContent =
                  'Reassign';

                // The item likely just left this
                // character, so refresh.
                if (currentCharacter) {
                  void loadInstancesFor(
                    currentCharacter,
                  );
                }
              },
            );

          li.append(panel);
        },
      );

      deleteButton.addEventListener(
        'click',
        async () => {
          if (
            !window.confirm(
              `Delete "${instance.title}"? This can't be undone.`,
            )
          ) {
            return;
          }

          deleteButton.disabled = true;

          try {
            try {
              await deleteItemInstance(
                tenantId as string,
                instance.entity_id,
              );
            } catch (e) {
              // What was inside is set down; a stack
              // only as single items, asked first
              // (ADR 0132).
              if (
                !isStackRefusal(e) ||
                !window.confirm(
                  deleteSplitQuestion(
                    instance.title,
                  ),
                )
              ) {
                throw e;
              }

              await deleteItemInstance(
                tenantId as string,
                instance.entity_id,
                { split: true },
              );
            }

            if (currentCharacter) {
              void loadInstancesFor(
                currentCharacter,
              );
            }
          } catch (e) {
            deleteButton.disabled =
              false;

            window.alert(
              e instanceof Error
                ? e.message
                : String(e),
            );
          }
        },
      );

      return li;
    }

    function renderInstanceGroup(
      group: OwnedGroup,
      rootTitle: string,
    ): HTMLElement {
      const section =
        document.createElement('div');

      section.className = 'section';

      const heading =
        document.createElement('h3');

      heading.textContent =
        group.container?.name ??
        rootTitle;

      section.append(heading);

      const list =
        document.createElement('ul');

      list.className =
        'catalog-list';

      for (
        const instance of
        group.item_instances
      ) {
        list.append(
          renderInstanceRow(instance),
        );
      }

      section.append(list);

      return section;
    }

    async function loadInstancesFor(
      character: BeingRef,
    ) {
      currentCharacter = character;

      const thisRequest =
        ++instancesRequestId;

      instancesViewing.hidden =
        false;

      instancesViewing.textContent =
        `Viewing ${character.name}'s inventory.`;

      instancesEmpty.hidden = true;
      instancesError.hidden = true;
      instancesGroups.replaceChildren();

      try {
        const response =
          await getOwnedItemInstances(
            tenantId as string,
            character.entity_id,
          );

        if (
          thisRequest !==
          instancesRequestId
        ) {
          return;
        }

        const hasAnything =
          response.groups.some(
            (group) =>
              group.item_instances.length >
              0,
          );

        if (!hasAnything) {
          instancesEmpty.hidden = false;

          instancesEmpty.textContent =
            `${character.name} isn't carrying anything.`;

          return;
        }

        for (
          const group of
          response.groups
        ) {
          if (
            group.item_instances
              .length > 0
          ) {
            instancesGroups.append(
              renderInstanceGroup(
                group,
                character.name,
              ),
            );
          }
        }
      } catch (e) {
        if (
          thisRequest !==
          instancesRequestId
        ) {
          return;
        }

        instancesError.hidden =
          false;

        instancesError.textContent =
          e instanceof Error
            ? e.message
            : String(e);
      }
    }

    let browseDebounce:
      | ReturnType<typeof setTimeout>
      | undefined;

    browseSearch.addEventListener(
      'input',
      () => {
        clearTimeout(
          browseDebounce,
        );

        const query =
          browseSearch.value.trim();

        if (!query) {
          browseSuggestions.hidden =
            true;

          browseSuggestions.replaceChildren();

          return;
        }

        browseDebounce =
          setTimeout(
            async () => {
              const result =
                await listBeings(
                  tenantId as string,
                  query,
                );

              renderBeingSuggestions(
                browseSuggestions,
                result.items,
                (being) => {
                  browseSearch.value =
                    being.name;

                  browseSuggestions.hidden =
                    true;

                  void loadInstancesFor(
                    being,
                  );
                },
              );
            },
            200,
          );
      },
    );

    browseSearch.addEventListener(
      'keydown',
      (event) => {
        if (
          event.key === 'Escape'
        ) {
          browseSuggestions.hidden =
            true;
        }
      },
    );

    document.addEventListener(
      'click',
      (event) => {
        const combobox =
          document.getElementById(
            'browse-combobox',
          )!;

        if (
          !combobox.contains(
            event.target as Node,
          )
        ) {
          browseSuggestions.hidden =
            true;
        }
      },
    );

    // ---------------------------------------------------------------------
    // Page initialization
    // ---------------------------------------------------------------------

    if (!(await isAuthenticated())) {
      status.textContent =
        "You're not logged in. Log in to continue.";
    } else if (!tenantId) {
      status.textContent =
        'No tenant selected. Pick one to continue.';
    } else {
      try {
        /*
         * tenantId is known to be valid from here on, so the
         * tenant-specific description renderer can now be created.
         */
        renderer =
          descriptionRenderer(
            tenantId,
          );

        /*
         * GMs manage the catalog here; everyone else browses
         * whatever the API lets them list (ADR 0116).
         */
        [viewerIsGm, viewer] =
          await Promise.all([
            isCampaignGm(tenantId),
            viewerId(),
          ]);

        const tenant =
          await getTenant(
            tenantId,
          );

        status.hidden = true;

        tenantName.textContent =
          tenant.name;

        document.title =
          viewerIsGm
            ? 'Manage items — Lorenzo'
            : 'Catalog — Lorenzo';

        byId('new-item').hidden =
          !viewerIsGm;

        byId('instances').hidden =
          !viewerIsGm;

        page.hidden = false;

        /*
         * Catalog owns its own search input, rows, loading state,
         * cache handling, edit forms and delete actions.
         */
        const catalogRoot =
          document.querySelector<HTMLElement>(
            '[data-catalog]',
          );

        if (!catalogRoot) {
          throw new Error(
            'Catalog component not found.',
          );
        }

        catalog = renderCatalog({
          root: catalogRoot,

          tenantId,
          viewerId: viewer,
          viewerIsGm,

          renderer,

          /*
           * A player who's actually a tenant member doesn't need
           * the public-catalog explanation.
           *
           * See the note below about this option.
           */
          showIntro:
            !viewerIsGm &&
            !(await isTenantMember(
              tenantId,
            )),

          onInstantiate: (
            item,
            onDone,
          ) =>
            renderInstantiatePanel(
              item,
              onDone,
            ),
        });

        if (viewerIsGm) {
          mountCreateItemForm();
        }

        await catalog.reload();
      } catch (e) {
        status.textContent =
          e instanceof Error
            ? e.message
            : String(e);
      }
    }
  </script>
</Base>
