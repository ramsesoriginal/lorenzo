---
import Base from '../../layouts/Base.astro';
import Board from '../../components/Board/Board.astro';
import HolderPicker from '../../components/HolderPicker/HolderPicker.astro';
import ItemDetail from '../../components/ItemDetail/ItemDetail.astro';
import UndoBanner from '../../components/UndoBanner/UndoBanner.astro';
---

<Base title="Board — Lorenzo">
  <p id="status">
    Loading&hellip; <span class="spinner" role="status" aria-label="Loading"></span>
  </p>

  <div id="page" hidden>
    <h1 class="display" id="tenant-name"></h1>

    <div class="stack">
      <HolderPicker />
      <UndoBanner />
    </div>

    <Board />
  </div>

  <ItemDetail />

  <script>
    import { errorMessage } from '../../lib/errorMessage';
    import { say } from '../../lib/statusLine';
    import { requiredIn } from '../../lib/template';
    import { renderBoard } from '../../components/Board/renderer';
    import { renderHolderPicker } from '../../components/HolderPicker/renderer';
    import { renderItemDetail } from '../../components/ItemDetail/renderer';
    import { renderUndoBanner } from '../../components/UndoBanner/renderer';

    import { addressedTenant } from '../../lib/addresses';
    import { isAuthenticated } from '../../lib/auth';
    import { descriptionRenderer } from '../../lib/descriptions';
    import { isCampaignGm, seatsIn } from '../../lib/me';
    import { addItemStanding } from '../../lib/addItem';
    import { getTenant } from '../../lib/tenants';

    const required = requiredIn('Board page');

    const status = required<HTMLElement>(document, '#status');
    const page = required<HTMLElement>(document, '#page');
    const tenantName = required<HTMLElement>(document, '#tenant-name');

    // By id or by slug (ADR 0135).
    const addressed = await addressedTenant(
      new URLSearchParams(window.location.search).get('tenant'),
    );
    const tenantId = addressed.id;

    if (!(await isAuthenticated())) {
      say(status, "You're not logged in. Log in to continue.");
    } else if (!tenantId) {
      say(status, addressed.problem ?? 'No library selected. Pick one to continue.');
    } else {
      try {
        const [tenant, viewerIsGm] = await Promise.all([
          getTenant(tenantId),
          isCampaignGm(tenantId),
        ]);

        // The parts are wired to each other: a card opens the dialog, which changes the board
        // and offers the Undo, which needs to know the viewer's characters. Each reaches the
        // others only through these callbacks, when something happens.
        const undo = renderUndoBanner({
          root: required(document, '[data-undo-banner]'),
          tenantId,
          mayUndoGiveTo: (recipientId) => viewerIsGm || picker.isMine(recipientId),
          onApplied: () => board.reload(),
          onError: (message) => board.showError(message),
        });

        const board = renderBoard({
          root: required(document, '[data-board]'),
          tenantId,
          viewerIsGm,
          undo,
          addItemStanding: async (holderId) =>
            addItemStanding({ viewerIsGm, holderId, seats: await seatsIn(tenantId) }),
          onOpenItem: (item, card) => detail.open(item, card),
          onPrefetchItem: (item) => detail.prefetch(item),
        });

        const detail = renderItemDetail({
          root: required<HTMLDialogElement>(document, '[data-item-detail]'),
          tenantId,
          tenantSlug: tenant.slug,
          viewerIsGm,
          renderer: descriptionRenderer(tenantId),
          myCharacters: () => picker.myCharacters(),
          board: { state: board.state, undo, onChanged: () => board.reload() },
        });

        const picker = renderHolderPicker({
          root: required(document, '[data-picker]'),
          tenantId,
          viewerIsGm,
          onViewHolder: (entityId, viewing, name) => void board.load(entityId, viewing, name),
          onViewUnowned: (viewing) => void board.loadUnowned(viewing),
          onPrefetch: (entityId) => board.prefetch(entityId),
          onError: (message) => board.showError(message),
        });

        say(status, '');
        tenantName.textContent = tenant.name;
        page.hidden = false;

        await picker.load();
      } catch (error) {
        say(status, errorMessage(error), true);
      }
    }
  </script>
</Base>
