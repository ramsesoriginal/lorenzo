---
import Base from '../../layouts/Base.astro';
import ItemDesignDialog from '../../components/ItemDetailDialog.astro';
import BoardColumn from '../../components/BoardColumn.astro';
import BoardColumnItem from '../../components/BoardColumnItem.astro';
import HolderListItem from '../../components/HolderListItem.astro';
---

<Base title="Board — Lorenzo">
  <p id="status">Loading&hellip;</p>
  <div id="board" hidden>
    <h1 class="display" id="tenant-name"></h1>

    <div class="stack">
      <section id="picker-section" class="section stack">
        <div
          id="picker-tablist"
          class="tabs"
          role="tablist"
          aria-label="Whose inventory to view"
          hidden
        >
          <button
            type="button"
            id="tab-characters"
            class="tab"
            role="tab"
            aria-selected="true"
            aria-controls="panel-characters"
          >
            Your characters
          </button>
          <button
            type="button"
            id="tab-browse"
            class="tab"
            role="tab"
            aria-selected="false"
            aria-controls="panel-browse"
            hidden
          >
            Browse a being
          </button>
          <button
            type="button"
            id="tab-unowned"
            class="tab"
            role="tab"
            aria-selected="false"
            aria-controls="panel-unowned"
            hidden
          >
            Unowned items
          </button>
        </div>

        <div
          id="panel-characters"
          class="tab-panel stack"
          role="tabpanel"
          aria-labelledby="tab-characters"
        >
          <p id="characters-loading">Loading characters&hellip;</p>
          <p id="characters-empty" hidden>You don't have a character in this tenant yet.</p>
          <p id="characters-error" class="error-text" hidden></p>
          <ul id="character-strip" class="list" aria-label="Your characters and groups"></ul>
        </div>

        <div
          id="panel-browse"
          class="tab-panel card card-body"
          role="tabpanel"
          aria-labelledby="tab-browse"
          hidden
        >
          <div class="field">
            <label class="field-label" id="gm-browse-label" for="gm-browse-search"
              >Search beings</label
            >
            <div class="combobox" id="gm-browse-combobox">
              <input
                type="text"
                id="gm-browse-search"
                class="text-input"
                placeholder="Search beings…"
                autocomplete="off"
                role="combobox"
                aria-expanded="false"
                aria-controls="gm-browse-suggestions"
                aria-labelledby="gm-browse-label"
              />
              <ul id="gm-browse-suggestions" class="combobox-suggestions" role="listbox" hidden>
              </ul>
            </div>
          </div>
          <div class="being-id-row">
            <input
              type="text"
              id="gm-browse-raw-id"
              class="text-input"
              placeholder="or a being's entity id…"
              aria-label="Being's entity id"
            />
            <button type="button" id="gm-browse-raw-id-button">View</button>
          </div>
        </div>

        <div
          id="panel-unowned"
          class="tab-panel"
          role="tabpanel"
          aria-labelledby="tab-unowned"
          hidden
        >
        </div>
      </section>

      <p id="undo-banner" class="next-up" hidden>
        <span id="undo-message"></span>
        <button type="button" id="undo-button">Undo</button>
      </p>
    </div>

    <section id="inventory" class="section">
      <p id="inventory-viewing" class="next-up" hidden></p>

      <div id="selection-toolbar" class="selection-toolbar" hidden>
        <span id="selection-count"></span>
        <button type="button" id="selection-give-button">Give selected to&hellip;</button>
        <button type="button" id="selection-clear-button">Clear</button>
      </div>
      <div id="selection-give-panel"></div>

      <p id="inventory-empty" class="next-up" hidden></p>
      <p id="inventory-error" class="error-text" hidden></p>
      <div id="board-columns" class="grid full-width h-scroll board-row" style="--grid-min: 260px">
      </div>

      <section class="board-toolbar card card-body">
        <input
          type="search"
          id="board-search"
          class="text-input"
          placeholder="Search this inventory…"
          aria-label="Search this inventory"
        />
        <button type="button" id="select-mode-button">Select items</button>
      </section>
    </section>
  </div>

  <ItemDesignDialog />
  <BoardColumn />
  <BoardColumnItem />
  <HolderListItem />

  <script>
    import { fetchAncestryTree } from '../../lib/ancestryTree';
    import { isAuthenticated } from '../../lib/auth';
    import {
      renderBeingActionPanel,
      renderBeingSuggestions,
      searchBeingsAndGroups,
    } from '../../lib/beingPicker';
    import {
      createUndoController,
      failedEntityIds,
      findMergeCandidates,
      mergedAway,
      planGive,
      summarizeBulkResults,
      type UndoPayload,
    } from '../../lib/boardLogic';
    import {
      type Board,
      type BoardColumn,
      controlledBoard,
      ownerMark,
      unownedBoard,
    } from '../../lib/boardColumns';
    import { listMyCharacters } from '../../lib/characters';
    import { descriptionRenderer } from '../../lib/descriptions';
    import { groupsOf } from '../../lib/groups';
    import { LorenzoApiError } from '../../lib/api';
    import {
      type MoveFlags,
      bulkAssignItemInstances,
      bulkMoveItemInstances,
      clearContainer,
      getControlledItemInstances,
      getUnownedItemInstances,
      giveContents,
      mergeItemInstance,
      setContainer,
      setOwner,
      splitItemInstance,
      unsetOwner,
    } from '../../lib/items';
    import { renderItemView } from '../../lib/itemView';
    import { isCampaignGm } from '../../lib/me';
    import {
      bulkMoveAnywayQuestion,
      giveOrAsk,
      type MoveAnywayOptions,
      moveOrAsk,
      overridableIds,
    } from '../../lib/moveAnyway';
    import { collectMoveTargets } from '../../lib/moveTargets';
    import {
      contentsDone,
      contentsQuestion,
      nothingToGive,
      withContentsDone,
      withContentsQuestion,
    } from '../../lib/givingContents';
    import { renderNotes } from '../../lib/notes';
    import { splitQuestion } from '../../lib/settingDown';
    import { getTenant } from '../../lib/tenants';
    import type {
      BeingRef,
      CharacterSummary,
      ControlledByResponse,
      EntitySummary,
      ItemInstance,
      ProblemOut,
    } from '../../lib/types';

    const status = document.getElementById('status')!;
    const board = document.getElementById('board')!;
    const tenantName = document.getElementById('tenant-name')!;

    const charactersLoading = document.getElementById('characters-loading')!;
    const charactersEmpty = document.getElementById('characters-empty')!;
    const charactersError = document.getElementById('characters-error')!;
    const characterStrip = document.getElementById('character-strip')!;

    const undoBanner = document.getElementById('undo-banner')!;
    const undoMessage = document.getElementById('undo-message')!;
    const undoButton = document.getElementById('undo-button') as HTMLButtonElement;

    const inventoryViewing = document.getElementById('inventory-viewing')!;
    const boardSearch = document.getElementById('board-search') as HTMLInputElement;
    const selectModeButton = document.getElementById('select-mode-button') as HTMLButtonElement;
    const selectionToolbar = document.getElementById('selection-toolbar')!;
    const selectionCount = document.getElementById('selection-count')!;
    const selectionGiveButton = document.getElementById(
      'selection-give-button',
    ) as HTMLButtonElement;
    const selectionGivePanel = document.getElementById('selection-give-panel')!;
    const selectionClearButton = document.getElementById(
      'selection-clear-button',
    ) as HTMLButtonElement;
    const inventoryEmpty = document.getElementById('inventory-empty')!;
    const inventoryError = document.getElementById('inventory-error')!;
    const boardColumns = document.getElementById('board-columns')!;

    const pickerTablist = document.getElementById('picker-tablist')!;
    const tabCharacters = document.getElementById('tab-characters') as HTMLButtonElement;
    const tabBrowse = document.getElementById('tab-browse') as HTMLButtonElement;
    const tabUnowned = document.getElementById('tab-unowned') as HTMLButtonElement;
    const panelCharacters = document.getElementById('panel-characters')!;
    const panelBrowse = document.getElementById('panel-browse')!;
    const panelUnowned = document.getElementById('panel-unowned')!;

    const gmBrowseCombobox = document.getElementById('gm-browse-combobox')!;
    const gmBrowseSearch = document.getElementById('gm-browse-search') as HTMLInputElement;
    const gmBrowseSuggestions = document.getElementById(
      'gm-browse-suggestions',
    ) as HTMLUListElement;
    const gmBrowseRawId = document.getElementById('gm-browse-raw-id') as HTMLInputElement;
    const gmBrowseRawIdButton = document.getElementById(
      'gm-browse-raw-id-button',
    ) as HTMLButtonElement;

    // Your characters / Browse a being / Unowned items - three ways to pick
    // whose inventory the board below shows, kept out of view as tabs
    // instead of three stacked sections (the latter was the actual
    // complaint: too much vertical real estate for GMs, who see all three).
    // Non-GMs only ever have "Your characters" to pick from, so the tablist
    // itself stays hidden for them - no point presenting a one-tab tab bar.
    type PickerTab = 'characters' | 'browse' | 'unowned';
    const pickerTabs: Record<PickerTab, HTMLButtonElement> = {
      characters: tabCharacters,
      browse: tabBrowse,
      unowned: tabUnowned,
    };
    const pickerPanels: Record<PickerTab, HTMLElement> = {
      characters: panelCharacters,
      browse: panelBrowse,
      unowned: panelUnowned,
    };

    function selectPickerTab(tab: PickerTab) {
      for (const key of Object.keys(pickerTabs) as PickerTab[]) {
        const isActive = key === tab;
        pickerTabs[key].setAttribute('aria-selected', String(isActive));
        pickerPanels[key].hidden = !isActive;
      }
    }

    tabCharacters.addEventListener('click', () => selectPickerTab('characters'));
    tabBrowse.addEventListener('click', () => selectPickerTab('browse'));
    tabUnowned.addEventListener('click', () => {
      selectPickerTab('unowned');
      browseUnowned();
    });

    const detailDialog = document.getElementById('item-detail') as HTMLDialogElement;
    const detailTitle = document.getElementById('item-detail-title')!;
    const detailSlug = document.getElementById('item-detail-slug')!;
    const detailQty = document.getElementById('item-detail-qty')!;
    const detailBound = document.getElementById('item-detail-bound')!;
    const detailView = document.getElementById('item-detail-view')!;
    const detailAncestry = document.getElementById('item-detail-ancestry')!;
    const detailAncestryList = document.getElementById(
      'item-detail-ancestry-list',
    ) as HTMLUListElement;
    const detailViewLink = document.getElementById('item-detail-view-link') as HTMLAnchorElement;
    const detailGiveButton = document.getElementById(
      'item-detail-give-button',
    ) as HTMLButtonElement;
    const detailGiveContentsButton = document.getElementById(
      'item-detail-give-contents-button',
    ) as HTMLButtonElement;
    const detailSplitButton = document.getElementById(
      'item-detail-split-button',
    ) as HTMLButtonElement;
    const detailMergeButton = document.getElementById(
      'item-detail-merge-button',
    ) as HTMLButtonElement;
    const detailMoveButton = document.getElementById(
      'item-detail-move-button',
    ) as HTMLButtonElement;
    const detailActionPanel = document.getElementById('item-detail-action-panel')!;
    const detailNotes = document.getElementById('item-detail-notes')!;

    const params = new URLSearchParams(window.location.search);
    const tenantId = params.get('tenant');
    const renderDescriptions = descriptionRenderer(tenantId as string);

    // Set once at init (see the bottom of this script) - gates the
    // GM-only "browse any being" section. Give/split/merge are player
    // actions, not gated by this - the real authorization boundary is
    // each write's own server-side check either way.
    let userIsGm = false;
    // The viewer's own characters, once loaded: who reads their private notes (ADR 0113).
    let myCharacters: CharacterSummary[] = [];
    // Their characters and those characters' groups: what they may give things back from
    // (ADR 0124).
    const myHolderIds = new Set<string>();

    // How to refresh whatever board is currently shown - set by loadBoard/
    // loadUnownedBoard, called after any action that might change what
    // belongs here (give, split, merge, undo).
    let reloadCurrentView: (() => void) | null = null;
    // The being whose board this is, who carries what's in no container of theirs (ADR
    // 0115); null on a group's board (a group carries nothing, ADR 0124) and on the
    // board of unowned things.
    let boardOwnerId: string | null = null;
    // The board as shown, for marking whose each card is (ADR 0123).
    let currentBoard: Board | null = null;

    // entity_id -> its ItemInstance, for everything currently rendered -
    // lets the merge panel's "other stacks of this" lookup and the bulk
    // give panel's item list work off data already in hand.
    const boardItems = new Map<string, ItemInstance>();

    // container_entity_id -> its EntitySummary, for every column a card can be
    // dropped into - the "Move to…" button's candidate list (lib/moveTargets.ts)
    // combines this with boardItems' own is_container-flagged cards.
    const boardContainers = new Map<string, EntitySummary>();
    // Containers whose column lists something: what "Give what's inside…" is for.
    const occupiedContainers = new Set<string>();
    // Cards in a read-only column (ADR 0131): not dragged, and not moved from there.
    const readOnlyItems = new Set<string>();

    // Multi-select (bulk actions) - only meaningful while selectMode is on.
    let selectMode = false;
    const selectedIds = new Set<string>();

    // One-slot undo, mirroring apps/loot-bot's own convention (ADR 0068):
    // each new undoable action overwrites whatever was pending, not a
    // stack - this is "I just made a mistake," not a history browser.
    // Bulk actions and deletes are deliberately not undoable here - a
    // multi-item reversal needs per-item previous state, and a deleted
    // instance's id is simply gone. The state machine itself (what's
    // pending, its expiry, and which API call reverses it) lives in
    // lib/boardLogic.ts so it's unit-testable without a DOM; this page
    // only wires it to the undo banner and the board reload.
    const undoController = createUndoController(tenantId as string, {
      setOwner,
      unsetOwner,
      setContainer,
      clearContainer,
      splitItemInstance,
      mergeItemInstance,
    });

    function recordUndo(payload: UndoPayload, description: string) {
      undoMessage.textContent = description;
      undoBanner.hidden = false;
      undoController.record(payload, () => {
        undoBanner.hidden = true;
      });
    }

    // After a give, taking it back is a give too (ADR 0124): only whoever controls the new
    // owner may. So a player keeps an Undo only for a give to one of their own characters or
    // groups, and gets none that would fail otherwise - handed over (ADR 0115) or not. A GM
    // keeps theirs.
    function recordGiveUndo(recipientId: string, payload: UndoPayload, description: string) {
      if (userIsGm || myHolderIds.has(recipientId)) {
        recordUndo(payload, description);
        return;
      }
      forgetUndo();
    }

    // Nothing to undo: after a give with what's inside, an Undo would only give the container
    // back (ADR 0125).
    function forgetUndo() {
      undoController.clear();
      undoBanner.hidden = true;
    }

    async function applyUndo() {
      if (!undoController.getPending()) return;
      undoBanner.hidden = true;
      try {
        await undoController.apply();
        reloadCurrentView?.();
      } catch (e) {
        showTransientError(e instanceof Error ? e.message : String(e));
      }
    }

    undoButton.addEventListener('click', () => void applyUndo());

    // Same-document View Transition when the browser supports it and the
    // user hasn't asked for reduced motion; a plain DOM mutation otherwise.
    function withReflow(mutate: () => void) {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion && document.startViewTransition) {
        document.startViewTransition(mutate);
      } else {
        mutate();
      }
    }

    let openCard: HTMLElement | null = null;

    function closeDetailActionPanels() {
      detailActionPanel.replaceChildren();
      detailGiveButton.textContent = 'Give to…';
      detailGiveContentsButton.textContent = "Give what's inside…";
      detailMoveButton.textContent = 'Move to…';
      detailSplitButton.textContent = 'Split…';
      detailMergeButton.textContent = 'Merge into…';
    }

    function populateDetail(item: ItemInstance) {
      detailTitle.textContent = item.title;

      detailViewLink.href = item.slug
        ? `/item/?tenant=${tenantId}&slug=${encodeURIComponent(item.slug)}`
        : `/item/?tenant=${tenantId}&id=${item.entity_id}`;

      detailSlug.hidden = !item.slug;
      detailSlug.textContent = item.slug ?? '';

      const showQty = Boolean(item.quantity && item.quantity > 1);
      detailQty.hidden = !showQty;
      detailQty.textContent = showQty ? `×${item.quantity}` : '';

      renderItemView(detailView, item, {
        tenantId: tenantId as string,
        renderer: renderDescriptions,
      });
      // Its notes (ADR 0113), written by a GM or by a player whose character owns it.
      const reader = myCharacters.find((c) => c.entity_id === item.owner_entity_id) ?? null;
      void renderNotes(detailNotes, {
        tenantId: tenantId as string,
        entityId: item.entity_id,
        renderer: renderDescriptions,
        canWrite: userIsGm || reader !== null,
        reader,
        rowHeading: 'h4',
      });

      // Bound to its owner (ADR 0129): only a GM may give it away.
      detailBound.hidden = !item.bound;
      detailGiveButton.disabled = item.bound && !userIsGm;
      detailGiveButton.title = detailGiveButton.disabled ? "It's bound to its owner." : '';

      closeDetailActionPanels();
      detailSplitButton.disabled = !(item.quantity && item.quantity > 1);
      // Only a container the board shows something inside (ADR 0125).
      detailGiveContentsButton.hidden = !occupiedContainers.has(item.entity_id);
      // A read-only column's cards aren't moved from this board (ADR 0131).
      detailMoveButton.hidden = readOnlyItems.has(item.entity_id);
    }

    // The full transitive ancestry (ADR 0073) is scoped to catalog Items,
    // not instances - resolve the instance's own direct prototype first
    // (ItemInstanceOut.prototype_ids, id-only), then walk *that* item's
    // graph. Fire-and-forget from openDetail, guarded by a request id so
    // opening a second item before the first fetch resolves can't clobber
    // the now-current dialog with stale ancestry.
    let ancestryRequestId = 0;
    async function loadAncestry(item: ItemInstance) {
      const thisRequest = ++ancestryRequestId;
      const directId = item.prototype_ids[0];
      if (!directId) {
        detailAncestry.hidden = true;
        return;
      }
      detailAncestry.hidden = false;
      const loading = document.createElement('li');
      loading.textContent = 'Loading…';
      detailAncestryList.replaceChildren(loading);
      try {
        const rootLi = await fetchAncestryTree(tenantId as string, directId);
        if (thisRequest !== ancestryRequestId) return;
        detailAncestryList.replaceChildren(rootLi);
      } catch {
        if (thisRequest !== ancestryRequestId) return;
        detailAncestry.hidden = true;
      }
    }

    // The dialog borrows the clicked card's view-transition-name for the
    // duration it's open (and gives it back on close) - two different
    // elements sharing one name, one at a time, is what makes the browser
    // morph between them instead of just cross-fading.
    let currentDetailItem: ItemInstance | null = null;

    function openDetail(item: ItemInstance, card: HTMLElement) {
      currentDetailItem = item;
      openCard = card;
      withReflow(() => {
        card.style.viewTransitionName = '';
        detailDialog.style.viewTransitionName = `item-${item.entity_id}`;
        populateDetail(item);
        detailDialog.showModal();
      });
      void loadAncestry(item);
    }

    function closeDetail() {
      const card = openCard;
      openCard = null;
      withReflow(() => {
        detailDialog.close();
        detailDialog.style.viewTransitionName = '';
        if (card?.dataset.entityId) {
          card.style.viewTransitionName = `item-${card.dataset.entityId}`;
        }
      });
    }

    // After a give, split, merge or move: the panel shows the item as it was, or one that's
    // gone, so it closes onto the board as it is now.
    function finishAction() {
      closeDetailActionPanels();
      closeDetail();
      reloadCurrentView?.();
    }

    document.getElementById('item-detail-close')?.addEventListener('click', () => closeDetail());

    // Escape fires 'cancel' first (cancelable) - intercept it so Escape
    // also gets the animated close instead of an instant native one.
    detailDialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeDetail();
    });

    // A click that lands on the <dialog> element itself (not a descendant)
    // is a backdrop click - the standard click-outside-to-close idiom.
    detailDialog.addEventListener('click', (event) => {
      if (event.target === detailDialog) {
        closeDetail();
      }
    });

    // The container an item is in, if any. Its owner carrying it isn't one (ADR 0115).
    function containerOf(item: ItemInstance): { id: string; name: string } | null {
      const id = item.container_entity_id;
      // In its owner's hands, or the board's being's, it's in no container of theirs.
      if (!id || id === item.owner_entity_id || id === boardOwnerId) return null;
      return boardContainers.get(id) ?? { id, name: 'container' };
    }

    // A GM whose move or give is refused, because it doesn't fit or something is bound, is
    // asked, and may do it anyway (ADR 0128, 0129).
    function moveAnyway(): MoveAnywayOptions {
      return { canOverride: userIsGm, ask: (question) => window.confirm(question) };
    }

    // A give's checkbox with a note saying what happens without it: "Hand it over" (ADR
    // 0115), out of its container and into the recipient's hands, only offered for what's in
    // a container; "Also give what's inside" (ADR 0125), only for a container with something
    // in it.
    let checkboxFields = 0;
    function checkboxField(label: string, otherwise: string) {
      const input = Object.assign(document.createElement('input'), { type: 'checkbox' });
      const row = document.createElement('label');
      row.className = 'field-row';
      row.append(input, label);
      const note = document.createElement('p');
      note.className = 'field-note';
      note.id = `checkbox-note-${++checkboxFields}`;
      note.textContent = otherwise;
      input.setAttribute('aria-describedby', note.id);
      const element = document.createElement('div');
      element.append(row, note);
      return { element, input };
    }

    // Give to… - a player action, always available, not GM-gated
    // (ownership already accepts any entity id server-side, no
    // character-only validation). An optional quantity splits off part of
    // a stack instead of transferring the whole thing (via bulk-assign's
    // own quantity delegation to split-with-owner).
    detailGiveButton.addEventListener('click', () => {
      const wasOpen = detailGiveButton.textContent === 'Cancel';
      closeDetailActionPanels();
      if (wasOpen || !currentDetailItem) return;

      detailGiveButton.textContent = 'Cancel';
      const item = currentDetailItem;
      const hasStack = Boolean(item.quantity && item.quantity > 1);

      const quantityField = document.createElement('label');
      quantityField.className = 'field';
      const quantityLabel = document.createElement('span');
      quantityLabel.className = 'field-label';
      quantityLabel.textContent = `How many? (of ${item.quantity}, blank for all)`;
      const quantityInput = document.createElement('input');
      quantityInput.type = 'number';
      quantityInput.className = 'text-input';
      quantityInput.min = '1';
      if (item.quantity) quantityInput.max = String(item.quantity);
      quantityField.append(quantityLabel, quantityInput);

      const previousOwnerId = item.owner_entity_id;
      const previousContainerId = item.container_entity_id;
      const where = containerOf(item);
      const handOver = where
        ? checkboxField('Hand it over', `Otherwise it stays in the ${where.name}, theirs now.`)
        : null;
      // Only for a container whose column lists something (ADR 0131).
      const alsoInside = occupiedContainers.has(item.entity_id)
        ? checkboxField(
            "Also give what's inside",
            "Otherwise what's inside stays whose it is. You'll be asked first.",
          )
        : null;
      const panel = renderBeingActionPanel(
        tenantId as string,
        async (being) => {
          const rawQuantity = quantityInput.value.trim();
          const requestedQuantity = rawQuantity ? Number.parseInt(rawQuantity, 10) : undefined;
          const plan = planGive(item, requestedQuantity);
          const moveToOwner = handOver?.input.checked ?? false;
          if (alsoInside?.input.checked) {
            if (plan.mode === 'partial') {
              throw new Error("Give all of it to give what's inside too.");
            }
            return giveWithContents(item, being, moveToOwner);
          }
          if (plan.mode === 'partial') {
            let splitOffEntityId = '';
            await giveOrAsk(async (flags) => {
              const [result] = await bulkAssignItemInstances(tenantId as string, [
                {
                  entityId: item.entity_id,
                  ownerCharacterId: being.entity_id,
                  quantity: plan.quantity,
                  moveToOwner,
                  ...flags,
                },
              ]);
              if (result.status === 'error' || !result.item_instance) {
                throw problemError(result.problem);
              }
              splitOffEntityId = result.item_instance.entity_id;
            }, moveAnyway());
            // The split-off instance is a *new* entity - restore-owner
            // has nothing to restore it to; merging it back is the
            // honest inverse instead.
            recordGiveUndo(
              being.entity_id,
              { kind: 'undo-split', splitOffEntityId, intoEntityId: item.entity_id },
              `Gave ${plan.quantity} ${item.title} to ${being.name}.`,
            );
          } else {
            await giveOrAsk(
              (flags) =>
                setOwner(tenantId as string, item.entity_id, being.entity_id, moveToOwner, flags),
              moveAnyway(),
            );
            recordGiveUndo(
              being.entity_id,
              {
                kind: 'restore-owner',
                entityId: item.entity_id,
                previousOwnerId,
                ...(moveToOwner ? { previousContainerId } : {}),
              },
              `Gave ${item.title} to ${being.name}.`,
            );
          }
          return `Given to ${being.name}.`;
        },
        () => {
          finishAction();
        },
        [
          ...(hasStack ? [quantityField] : []),
          ...(handOver ? [handOver.element] : []),
          ...(alsoInside ? [alsoInside.element] : []),
        ],
      );
      detailActionPanel.append(panel);
    });

    // A one-entry bulk-assign with what's inside (ADR 0125): its dry run first, so the
    // question says what goes along and what stays, then the give itself.
    async function giveWithContents(item: ItemInstance, being: BeingRef, moveToOwner: boolean) {
      const entry = {
        entityId: item.entity_id,
        ownerCharacterId: being.entity_id,
        moveToOwner,
        withContents: true,
      };
      const [preview] = await bulkAssignItemInstances(tenantId as string, [entry], {
        dryRun: true,
      });
      if (preview.status === 'error') throw new Error(problemText(preview.problem));
      const question = withContentsQuestion(item.title, being.name, preview.contents);
      if (question && !window.confirm(question)) throw new Error('Nothing given.');
      const [result] = await bulkAssignItemInstances(tenantId as string, [entry]);
      if (result.status === 'error') throw new Error(problemText(result.problem));
      forgetUndo();
      return withContentsDone(being.name, result.contents);
    }

    function problemText(problem: ProblemOut | null | undefined): string {
      return problem?.detail ?? problem?.title ?? 'Could not give that.';
    }

    // A bulk result's problem as the error a single write would throw, so a GM can be
    // asked to give anyway (ADR 0129).
    function problemError(problem: ProblemOut | null | undefined): LorenzoApiError {
      return new LorenzoApiError(problemText(problem), problem?.status ?? 500, problem?.type);
    }

    // Give what's inside… (ADR 0125): everything inside, not the container, after asking
    // with a dry run's answer. Anything not the caller's to give stays whose it is.
    detailGiveContentsButton.addEventListener('click', () => {
      const wasOpen = detailGiveContentsButton.textContent === 'Cancel';
      closeDetailActionPanels();
      if (wasOpen || !currentDetailItem) return;

      detailGiveContentsButton.textContent = 'Cancel';
      const item = currentDetailItem;
      const panel = renderBeingActionPanel(
        tenantId as string,
        async (being) => {
          const preview = await giveContents(tenantId as string, item.entity_id, being.entity_id, {
            dryRun: true,
          });
          const question = contentsQuestion(item.title, being.name, preview);
          if (!question) throw new Error(nothingToGive(item.title, being.name, preview));
          if (!window.confirm(question)) throw new Error('Nothing given.');
          const results = await giveContents(tenantId as string, item.entity_id, being.entity_id);
          forgetUndo();
          return contentsDone(item.title, being.name, results);
        },
        () => {
          finishAction();
        },
      );
      detailActionPanel.append(panel);
    });

    // Split… - splits part of a stack off into a new, same-owner sibling
    // instance. Only meaningful for quantity > 1 (button disabled
    // otherwise, see populateDetail).
    detailSplitButton.addEventListener('click', () => {
      const wasOpen = detailSplitButton.textContent === 'Cancel';
      closeDetailActionPanels();
      if (wasOpen || !currentDetailItem || detailSplitButton.disabled) return;

      detailSplitButton.textContent = 'Cancel';
      const item = currentDetailItem;
      const panel = document.createElement('div');
      panel.className = 'character-picker-panel';

      const field = document.createElement('label');
      field.className = 'field';
      const label = document.createElement('span');
      label.className = 'field-label';
      label.textContent = `Split off how many? (of ${item.quantity})`;
      const input = document.createElement('input');
      input.type = 'number';
      input.className = 'text-input';
      input.min = '1';
      input.max = String((item.quantity ?? 1) - 1);
      field.append(label, input);

      const submitButton = document.createElement('button');
      submitButton.type = 'button';
      submitButton.textContent = 'Split';

      const statusEl = document.createElement('p');
      statusEl.className = 'picker-status';
      statusEl.hidden = true;

      panel.append(field, submitButton, statusEl);

      submitButton.addEventListener('click', async () => {
        const quantity = Number.parseInt(input.value, 10);
        if (!Number.isFinite(quantity) || quantity < 1) return;
        submitButton.disabled = true;
        try {
          const splitOff = await splitItemInstance(tenantId as string, item.entity_id, quantity);
          recordUndo(
            {
              kind: 'undo-split',
              splitOffEntityId: splitOff.entity_id,
              intoEntityId: item.entity_id,
            },
            `Split off ${quantity} ${item.title}.`,
          );
          statusEl.hidden = false;
          statusEl.classList.remove('error-text');
          statusEl.textContent = `Split off ${quantity}.`;
          window.setTimeout(() => {
            finishAction();
          }, 1200);
        } catch (e) {
          statusEl.hidden = false;
          statusEl.classList.add('error-text');
          statusEl.textContent = e instanceof Error ? e.message : String(e);
          submitButton.disabled = false;
        }
      });

      detailActionPanel.append(panel);
    });

    // Merge into… - candidates are other stacks of the same item already
    // visible on the current board (a same-tenant, same-view lookup off
    // data already in hand, not a new search endpoint). The "same kind of
    // item" test itself (samePrototypes/findMergeCandidates) lives in
    // lib/boardLogic.ts and is unit-tested there - it's the only thing
    // standing between a title collision (ADR 0067's title-fallback-to-
    // name) and silently combining two different items' quantities.
    detailMergeButton.addEventListener('click', () => {
      const wasOpen = detailMergeButton.textContent === 'Cancel';
      closeDetailActionPanels();
      if (wasOpen || !currentDetailItem) return;

      detailMergeButton.textContent = 'Cancel';
      const item = currentDetailItem;
      const panel = document.createElement('div');
      panel.className = 'character-picker-panel';

      const candidates = findMergeCandidates(boardItems.values(), item);

      if (candidates.length === 0) {
        const note = document.createElement('p');
        note.className = 'field-note';
        note.textContent = 'No other stack of this is visible on the current board.';
        panel.append(note);
        detailActionPanel.append(panel);
        return;
      }

      const statusEl = document.createElement('p');
      statusEl.className = 'picker-status';
      statusEl.hidden = true;

      const list = document.createElement('div');
      list.className = 'merge-candidates';
      for (const candidate of candidates) {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent =
          candidate.quantity && candidate.quantity > 1
            ? `${candidate.title} ×${candidate.quantity}`
            : candidate.title;
        button.addEventListener('click', async () => {
          for (const b of list.querySelectorAll('button')) (b as HTMLButtonElement).disabled = true;
          try {
            const merged = await mergeItemInstance(
              tenantId as string,
              item.entity_id,
              candidate.entity_id,
            );
            recordUndo(
              {
                kind: 'undo-merge',
                intoEntityId: candidate.entity_id,
                quantity: item.quantity ?? 1,
                previousOwnerId: item.owner_entity_id,
              },
              `Merged into ${merged.title}.`,
            );
            finishAction();
          } catch (e) {
            statusEl.hidden = false;
            statusEl.classList.add('error-text');
            statusEl.textContent = e instanceof Error ? e.message : String(e);
            for (const b of list.querySelectorAll('button')) {
              (b as HTMLButtonElement).disabled = false;
            }
          }
        });
        list.append(button);
      }

      panel.append(list, statusEl);
      detailActionPanel.append(panel);
    });

    // Move to… - the non-drag-and-drop fallback for a single-item
    // container move (drag-and-drop, bindDropZone below, was previously
    // the only way). Candidates come from lib/moveTargets.ts, the same
    // "already visible on the current board" convention Merge into…
    // above already established.
    detailMoveButton.addEventListener('click', () => {
      const wasOpen = detailMoveButton.textContent === 'Cancel';
      closeDetailActionPanels();
      if (wasOpen || !currentDetailItem) return;

      detailMoveButton.textContent = 'Cancel';
      const item = currentDetailItem;
      const previousContainerId = item.container_entity_id;
      const panel = document.createElement('div');
      panel.className = 'character-picker-panel';

      // Equipping is moving into the being: Move to… lists Equipped among its targets.
      const targets = collectMoveTargets(item, boardContainers.values(), boardItems.values());
      // Anything in a container can be set down, what's equipped too (ADR 0132).
      const inContainer = item.container_entity_id !== null;

      if (targets.length === 0 && !inContainer) {
        const note = document.createElement('p');
        note.className = 'field-note';
        note.textContent = 'No other container is visible on the current board.';
        panel.append(note);
        detailActionPanel.append(panel);
        return;
      }

      const statusEl = document.createElement('p');
      statusEl.className = 'picker-status';
      statusEl.hidden = true;

      const list = document.createElement('div');
      list.className = 'merge-candidates';

      async function performMove(targetId: string | null) {
        // Set down, a stack becomes single items: asked first, and then there's no Undo.
        const question = targetId === null ? splitQuestion([item]) : null;
        if (question !== null && !window.confirm(question)) return;
        for (const b of list.querySelectorAll('button')) (b as HTMLButtonElement).disabled = true;
        try {
          // Into a container, it stacks with something identical already there (ADR 0133).
          let merged = false;
          if (targetId) {
            const endedUp = await moveOrAsk(
              (flags) =>
                setContainer(tenantId as string, item.entity_id, targetId, {
                  ...flags,
                  mergeIdentical: true,
                }),
              moveAnyway(),
            );
            merged = endedUp.entity_id !== item.entity_id;
          } else {
            await moveOrAsk(
              (flags) =>
                clearContainer(tenantId as string, item.entity_id, {
                  ...flags,
                  split: question !== null,
                }),
              moveAnyway(),
            );
          }
          // What's split or merged away can't simply be put back.
          if (question === null && !merged) {
            recordUndo(
              { kind: 'restore-container', entityId: item.entity_id, previousContainerId },
              `${targetId === null ? 'Set down' : 'Moved'} ${item.title}.`,
            );
          } else {
            forgetUndo();
          }
          finishAction();
        } catch (e) {
          statusEl.hidden = false;
          statusEl.classList.add('error-text');
          statusEl.textContent = e instanceof Error ? e.message : String(e);
          for (const b of list.querySelectorAll('button')) {
            (b as HTMLButtonElement).disabled = false;
          }
        }
      }

      if (inContainer) {
        const setDownButton = document.createElement('button');
        setDownButton.type = 'button';
        setDownButton.textContent = 'Set down';
        setDownButton.addEventListener('click', () => void performMove(null));
        list.append(setDownButton);
      }
      for (const target of targets) {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = target.name;
        button.addEventListener('click', () => void performMove(target.id));
        list.append(button);
      }

      panel.append(list, statusEl);
      detailActionPanel.append(panel);
    });

    function ensurePlaceholder(list: HTMLUListElement) {
      if (list.children.length === 0) {
        const empty = document.createElement('li');
        empty.className = 'column-empty';
        // Each column says it its own way: Equipped is "Nothing equipped." (ADR 0123).
        empty.textContent = list.dataset.empty ?? 'This container is empty.';
        list.append(empty);
      }
    }

    function removePlaceholder(list: HTMLUListElement) {
      list.querySelector('.column-empty')?.remove();
    }

    function showTransientError(message: string) {
      inventoryError.hidden = false;
      inventoryError.textContent = message;
      window.setTimeout(() => {
        inventoryError.hidden = true;
      }, 5000);
    }

    // --- Multi-select (bulk actions) ---

    function updateSelectionToolbar() {
      selectionToolbar.hidden = selectedIds.size === 0;
      selectionCount.textContent = `${selectedIds.size} selected`;
    }

    function setCardSelected(card: HTMLLIElement, selected: boolean) {
      card.classList.toggle('item-card--selected', selected);
      card.setAttribute('aria-pressed', String(selected));
      const entityId = card.dataset.entityId;
      if (!entityId) return;
      if (selected) selectedIds.add(entityId);
      else selectedIds.delete(entityId);
      updateSelectionToolbar();
    }

    function clearSelection() {
      for (const card of boardColumns.querySelectorAll<HTMLLIElement>('.item-card--selected')) {
        setCardSelected(card, false);
      }
      selectedIds.clear();
      updateSelectionToolbar();
    }

    // While selecting, each card is a toggle; otherwise it opens the item.
    function setSelectMode(on: boolean) {
      selectMode = on;
      selectModeButton.textContent = on ? 'Cancel selecting' : 'Select items';
      selectModeButton.setAttribute('aria-pressed', String(on));
      if (!on) clearSelection();
      for (const card of boardColumns.querySelectorAll('.item-card')) {
        if (on) card.setAttribute('aria-pressed', 'false');
        else card.removeAttribute('aria-pressed');
      }
    }

    selectModeButton.addEventListener('click', () => setSelectMode(!selectMode));

    selectionClearButton.addEventListener('click', () => clearSelection());

    // Give selected to… (bulk-assign) - same being-picker panel every
    // other give/assign flow uses, over the current selection.
    selectionGiveButton.addEventListener('click', () => {
      const wasOpen = selectionGiveButton.textContent === 'Cancel';
      selectionGivePanel.replaceChildren();
      selectionGiveButton.textContent = 'Give selected to…';
      if (wasOpen || selectedIds.size === 0) return;

      selectionGiveButton.textContent = 'Cancel';
      const ids = [...selectedIds];
      const inContainers = ids.some((id) => {
        const selected = boardItems.get(id);
        return selected ? containerOf(selected) !== null : false;
      });
      const handOver = inContainers
        ? checkboxField('Hand them over', 'Otherwise they stay in their containers, theirs now.')
        : null;
      const panel = renderBeingActionPanel(
        tenantId as string,
        async (being) => {
          const moveToOwner = handOver?.input.checked ?? false;
          const results = await bulkAssignItemInstances(
            tenantId as string,
            ids.map((entityId) => ({ entityId, ownerCharacterId: being.entity_id, moveToOwner })),
          );
          // bulk-assign is never all-or-nothing (ADR 0044) - a total
          // failure means nothing changed, so it's safe to just throw
          // (leaves the panel open for retry, no reload needed). A
          // partial failure already reassigned some items server-side,
          // so it still has to fall through to onDone/reload below rather
          // than throwing - otherwise the board silently drifts from
          // what actually happened. The summarizing logic itself lives in
          // lib/boardLogic.ts and is unit-tested there.
          const outcome = summarizeBulkResults(results);
          if (outcome.allFailed) {
            throw new Error(`Couldn't give any of the ${ids.length} selected item(s).`);
          }
          if (outcome.failedCount > 0) {
            showTransientError(`${outcome.failedCount} of ${ids.length} couldn't be given.`);
          }
          return outcome.failedCount > 0
            ? `Gave ${outcome.succeededCount} of ${ids.length} item(s) to ${being.name}.`
            : `Gave ${ids.length} item(s) to ${being.name}.`;
        },
        () => {
          selectionGivePanel.replaceChildren();
          selectionGiveButton.textContent = 'Give selected to…';
          setSelectMode(false);
          reloadCurrentView?.();
        },
        handOver ? [handOver.element] : [],
      );
      selectionGivePanel.append(panel);
    });

    // dragenter/dragleave both fire while crossing child elements (a card
    // moving within its own column), so a plain "leave clears the
    // highlight" handler flickers - a per-column counter fixes that.
    const dragDepth = new WeakMap<HTMLElement, number>();

    // containerEntityId is the column's container, or null for the owner's own column.
    function bindDropZone(
      column: HTMLElement,
      list: HTMLUListElement,
      containerEntityId: string | null,
    ) {
      column.addEventListener('dragenter', (event) => {
        event.preventDefault();
        dragDepth.set(column, (dragDepth.get(column) ?? 0) + 1);
        column.classList.add('board-column--drop-target');
      });

      column.addEventListener('dragleave', () => {
        const depth = (dragDepth.get(column) ?? 1) - 1;
        dragDepth.set(column, depth);
        if (depth <= 0) {
          column.classList.remove('board-column--drop-target');
        }
      });

      column.addEventListener('dragover', (event) => {
        event.preventDefault();
        if (event.dataTransfer) {
          event.dataTransfer.dropEffect = 'move';
        }
      });

      column.addEventListener('drop', (event) => {
        event.preventDefault();
        dragDepth.set(column, 0);
        column.classList.remove('board-column--drop-target');

        const entityId = event.dataTransfer?.getData('text/plain');
        if (!entityId) return;
        const card = boardColumns.querySelector<HTMLLIElement>(
          `.item-card[data-entity-id="${entityId}"]`,
        );
        if (!card) return;

        const sourceList = card.parentElement as HTMLUListElement;
        if (sourceList === list) return;

        // Dragging a card that's part of a multi-selection (with more
        // than just itself selected) moves the whole selection together.
        const isBulk = selectMode && selectedIds.has(entityId) && selectedIds.size > 1;
        const idsToMove = isBulk ? [...selectedIds] : [entityId];
        const cardsToMove = idsToMove
          .map((id) =>
            boardColumns.querySelector<HTMLLIElement>(`.item-card[data-entity-id="${id}"]`),
          )
          .filter((c): c is HTMLLIElement => c !== null);
        // Where it really was: a card in the owner's own column may be carried by the owner.
        const previousContainerId = boardItems.get(entityId)?.container_entity_id ?? null;
        // A column with no container is Not carried, on every board: dropping there sets
        // things down (ADR 0132). Equipped names the being as its container.
        const target = containerEntityId;
        // A stack set down becomes single items: asked first, and then there's no Undo.
        const question =
          target === null
            ? splitQuestion(
                idsToMove.flatMap((id) => {
                  const item = boardItems.get(id);
                  return item ? [item] : [];
                }),
              )
            : null;
        if (question !== null && !window.confirm(question)) return;
        const splitting = question !== null;
        const isStack = (id: string) => (boardItems.get(id)?.quantity ?? 1) > 1;

        withReflow(() => {
          removePlaceholder(list);
          for (const c of cardsToMove) list.append(c);
          ensurePlaceholder(sourceList);
        });

        // Bulk endpoints are never all-or-nothing (ADR 0044/0065) - each
        // resolves to a per-entry result, so a partial failure still needs
        // to keep the DOM in sync with whichever entries actually moved
        // server-side, not roll back the whole selection. failedIds is
        // empty for the single-item path, where any failure really is
        // total and handled by the outer .catch below instead. merged: some
        // of it stacked into something identical (ADR 0133), so the board
        // has to show it anew.
        let request: Promise<{ failedIds: Set<string>; merged: boolean }>;
        if (isBulk && target) {
          const moveAll = (ids: string[], flags: MoveFlags = {}) =>
            bulkMoveItemInstances(tenantId as string, target, ids, {
              ...flags,
              mergeIdentical: true,
            });
          request = moveAll(idsToMove).then(async (results) => {
            // One question for every card that didn't fit (ADR 0128).
            const question = userIsGm ? bulkMoveAnywayQuestion(results) : null;
            if (!question || !window.confirm(question)) {
              return { failedIds: failedEntityIds(results), merged: mergedAway(results) };
            }
            const retried = await moveAll(overridableIds(results), { override: true });
            const combined = results.map(
              (result) => retried.find((r) => r.entity_id === result.entity_id) ?? result,
            );
            return { failedIds: failedEntityIds(combined), merged: mergedAway(combined) };
          });
        } else if (isBulk) {
          // bulk-move has no "no container" mode - to_container_entity_id
          // is required server-side, so clearing several at once still
          // needs one clearContainer call per item. Settled individually
          // (not Promise.all) so one rejection doesn't mask which of the
          // others actually cleared.
          request = Promise.allSettled(
            idsToMove.map((id) => clearContainer(tenantId as string, id, { split: isStack(id) })),
          ).then((settled) => ({
            failedIds: new Set(
              settled.flatMap((result, i) => (result.status === 'rejected' ? [idsToMove[i]] : [])),
            ),
            merged: false,
          }));
        } else {
          request = moveOrAsk(
            (flags) =>
              target
                ? setContainer(tenantId as string, entityId, target, {
                    ...flags,
                    mergeIdentical: true,
                  })
                : clearContainer(tenantId as string, entityId, { ...flags, split: splitting }).then(
                    () => null,
                  ),
            moveAnyway(),
          ).then((endedUp) => ({
            failedIds: new Set<string>(),
            merged: endedUp !== null && endedUp.entity_id !== entityId,
          }));
        }

        request
          .then(({ failedIds, merged }) => {
            if (isBulk) {
              if (failedIds.size > 0) {
                withReflow(() => {
                  removePlaceholder(sourceList);
                  for (const c of cardsToMove) {
                    if (failedIds.has(c.dataset.entityId ?? '')) sourceList.append(c);
                  }
                  ensurePlaceholder(list);
                });
                showTransientError(`${failedIds.size} of ${idsToMove.length} couldn't be moved.`);
              }
              // Multi-item moves aren't undoable here (would need
              // per-item previous state) - deliberately not recorded.
              setSelectMode(false);
            } else if (!splitting && !merged) {
              recordUndo(
                { kind: 'restore-container', entityId, previousContainerId },
                `${target === null ? 'Set down' : 'Moved'} ${boardItems.get(entityId)?.title ?? 'item'}.`,
              );
            }
            // The pieces a split made are cards of their own, and a merge made one stack of
            // two: neither can simply be put back, and the board shows them anew.
            if (splitting || merged) {
              forgetUndo();
              reloadCurrentView?.();
            }
          })
          .catch((e) => {
            withReflow(() => {
              removePlaceholder(sourceList);
              for (const c of cardsToMove) sourceList.append(c);
              ensurePlaceholder(list);
            });
            showTransientError(e instanceof Error ? e.message : String(e));
          });
      });
    }

    function matchesSearch(item: ItemInstance, query: string): boolean {
      return !query || item.title.toLowerCase().includes(query);
    }

    // A fresh copy of one of the page's <template>s (src/components).
    function fromTemplate(id: string): DocumentFragment {
      const template = document.querySelector<HTMLTemplateElement>(`#${id}`);
      if (!template) {
        throw new Error(`Template #${id} not found`);
      }
      return template.content.cloneNode(true) as DocumentFragment;
    }

    // `readOnly`: in a read-only column (ADR 0131), so it isn't dragged anywhere.
    function renderCard(item: ItemInstance, readOnly: boolean): HTMLLIElement {
      const fragment = fromTemplate('boardColumnItem');

      const li = fragment.querySelector<HTMLLIElement>('li')!;
      const name = fragment.querySelector<HTMLSpanElement>('[data-name]')!;
      const container = fragment.querySelector<HTMLSpanElement>('[data-container]')!;
      const count = fragment.querySelector<HTMLSpanElement>('[data-count]')!;
      const ownerMarkField = fragment.querySelector<HTMLSpanElement>('[data-owner-mark]')!;
      const bound = fragment.querySelector<HTMLSpanElement>('[data-bound]')!;

      li.draggable = !readOnly;
      li.dataset.entityId = item.entity_id;
      li.style.viewTransitionName = `item-${item.entity_id}`;
      if (item.is_container) {
        container.hidden = false;
      }
      li.hidden = !matchesSearch(item, boardSearch.value.trim().toLowerCase());
      if (selectMode) li.setAttribute('aria-pressed', 'false');

      li.addEventListener('dragstart', (event) => {
        event.dataTransfer?.setData('text/plain', item.entity_id);
        if (event.dataTransfer) {
          event.dataTransfer.effectAllowed = 'move';
        }
      });

      name.textContent = item.title;

      const activateItem = () => {
        if (selectMode) {
          setCardSelected(li, !li.classList.contains('item-card--selected'));
          return;
        }

        openDetail(item, li);
      };

      li.addEventListener('click', activateItem);

      li.addEventListener('keydown', (event) => {
        if (event.key === ' ' || event.key === 'Enter') {
          event.preventDefault(); // prevents Space from scrolling the page
          activateItem();
        }
      });

      if (item.quantity && item.quantity > 1) {
        count.hidden = false;
        count.textContent = `×${item.quantity}`;
      }

      // Whose it is, when it isn't the board's being's own (ADR 0123).
      const mark = currentBoard ? ownerMark(item, currentBoard) : null;
      if (mark) {
        ownerMarkField.hidden = false;
        ownerMarkField.textContent = mark;
      }

      // Bound to its owner (ADR 0129).
      bound.hidden = !item.bound;

      return li;
    }

    // A column of the board (ADR 0131). Equipped and Not carried, the two every board
    // has, glow; a read-only one takes no drops, and its cards aren't dragged.
    function renderColumn(column: BoardColumn): HTMLElement {
      const fragment = fromTemplate('boardColumn');

      const section = fragment.querySelector<HTMLElement>('[data-column]')!;
      const nameField = fragment.querySelector<HTMLHeadingElement>('[data-name]')!;
      const noteField = fragment.querySelector<HTMLSpanElement>('[data-note]')!;
      const list = fragment.querySelector<HTMLUListElement>('[data-items]')!;

      section.classList.toggle('glow-canonical', column.fixed);
      if (column.droppable && column.dropTarget !== null) {
        // "Move to…" offers it under the column's own title: Equipped, not the being's name.
        boardContainers.set(column.dropTarget, {
          id: column.dropTarget,
          name: column.title,
          quantity: null,
        });
        if (column.items.length > 0) occupiedContainers.add(column.dropTarget);
      }

      // Named by its heading, so each column is a region a reader can find.
      nameField.id = `column-${column.key}`;
      nameField.textContent = column.title;
      section.setAttribute('aria-labelledby', nameField.id);

      // Where its container is: "In Backpack", "Brisk has these", "Not carried".
      if (column.note) {
        noteField.hidden = false;
        noteField.textContent = column.note;
        noteField.classList.add(column.carried ? 'pill-success' : 'pill-warning');
      }

      // Holding more than it lists (ADR 0130): it says so, rather than that it's empty.
      list.dataset.empty = column.contentsHidden ? 'Contents not shown.' : column.empty;
      if (column.items.length === 0) {
        ensurePlaceholder(list);
      } else {
        for (const item of column.items) {
          boardItems.set(item.entity_id, item);
          if (!column.droppable) readOnlyItems.add(item.entity_id);
          list.append(renderCard(item, !column.droppable));
        }
        if (column.contentsHidden) {
          // After the list, not in it: dropping a card in removes the list's placeholder.
          const hidden = document.createElement('p');
          hidden.className = 'column-empty';
          hidden.textContent = 'Other contents not shown.';
          section.append(hidden);
        }
      }

      if (column.droppable) bindDropZone(section, list, column.dropTarget);

      return section;
    }

    // A couple of fake columns/cards shaped like the real thing - the same column
    // template, without its heading - shown while the actual board loads. See the
    // styles/normalize.css [hidden] fix and components.css .skeleton for why this works.
    function renderBoardSkeleton() {
      boardColumns.setAttribute('aria-busy', 'true');
      boardColumns.replaceChildren(
        ...Array.from({ length: 2 }, () => {
          const fragment = fromTemplate('boardColumn');
          const section = fragment.querySelector<HTMLElement>('[data-column]')!;
          fragment.querySelector('[data-name]')!.parentElement!.remove();
          const list = fragment.querySelector<HTMLUListElement>('[data-items]')!;
          for (let i = 0; i < 3; i++) {
            const li = document.createElement('li');
            li.className = 'item-card skeleton';
            list.append(li);
          }
          return section;
        }),
      );
    }

    // Shared rendering for both boards: a being's or a group's (what it
    // controls, ADR 0131) and the board of unowned things (ADR 0077). Only the
    // latter can be empty - every other board has Not carried to drop onto.
    async function loadBoardFromResponse(
      fetchFn: () => Promise<Board>,
      emptyMessage: string | null,
    ) {
      boardItems.clear();
      boardContainers.clear();
      occupiedContainers.clear();
      readOnlyItems.clear();
      clearSelection();
      inventoryEmpty.hidden = true;
      inventoryError.hidden = true;
      renderBoardSkeleton();
      try {
        const shown = await fetchFn();
        currentBoard = shown;
        boardColumns.replaceChildren();
        boardColumns.removeAttribute('aria-busy');
        const hasAnything = shown.columns.some((c) => c.items.length > 0);
        if (!hasAnything && emptyMessage !== null) {
          inventoryEmpty.hidden = false;
          inventoryEmpty.textContent = emptyMessage;
          return;
        }
        // One row, in the order the listing gives.
        boardColumns.append(...shown.columns.map(renderColumn));
      } catch (e) {
        boardColumns.replaceChildren();
        boardColumns.removeAttribute('aria-busy');
        inventoryError.hidden = false;
        inventoryError.textContent = e instanceof Error ? e.message : String(e);
      }
    }

    // entityId is deliberately generic, not character-specific - controlled-by
    // accepts any being or group the viewer reaches, so this same function
    // serves "a player's own character", their groups, and "a GM browsing any
    // being."
    //
    // prefetchedBoards holds requests already in flight (or settled) for a
    // being's board, fired on hover/focus of its pill before the actual
    // click - loadBoard consumes and discards the entry (one-shot: a later
    // reload of the same being should hit the network again, not replay a
    // now-stale response).
    const prefetchedBoards = new Map<string, Promise<ControlledByResponse>>();

    function prefetchBoard(entityId: string) {
      if (prefetchedBoards.has(entityId)) return;
      const request = getControlledItemInstances(tenantId as string, entityId);
      // Swallow here so an unclicked prefetch (hover without a follow-up
      // click) never surfaces as an unhandled rejection - the original
      // `request` reference kept in the map is untouched, so loadBoard's
      // own await/catch still sees a real failure if the being is
      // actually opened.
      request.catch(() => {});
      prefetchedBoards.set(entityId, request);
    }

    async function loadBoard(entityId: string) {
      reloadCurrentView = () => void loadBoard(entityId);
      boardOwnerId = null;
      const prefetched = prefetchedBoards.get(entityId);
      prefetchedBoards.delete(entityId);
      await loadBoardFromResponse(async () => {
        const shown = controlledBoard(
          await (prefetched ?? getControlledItemInstances(tenantId as string, entityId)),
          entityId,
        );
        boardOwnerId = shown.holderIsBeing ? shown.holderId : null;
        return shown;
      }, null);
    }

    // GM-only: unclaimed loot, nobody's owned it yet (ADR 0077/#95).
    async function loadUnownedBoard() {
      reloadCurrentView = () => void loadUnownedBoard();
      boardOwnerId = null;
      await loadBoardFromResponse(
        async () => unownedBoard(await getUnownedItemInstances(tenantId as string)),
        "There's nothing unowned right now.",
      );
    }

    // Marks `link` as the board shown, among every character and group in the list.
    function pressOnly(link: HTMLAnchorElement | null) {
      for (const el of characterStrip.querySelectorAll('a')) {
        el.setAttribute('aria-pressed', String(el === link));
      }
    }

    function selectCharacter(character: CharacterSummary, link: HTMLAnchorElement) {
      pressOnly(link);
      inventoryViewing.hidden = true;
      const url = new URL(window.location.href);
      url.searchParams.set('character', character.entity_id);
      url.searchParams.delete('group');
      window.history.replaceState({}, '', url);
      void loadBoard(character.entity_id);
    }

    // A group one of your characters belongs to, and what it owns (ADR 0124).
    function selectGroup(group: BeingRef, link: HTMLAnchorElement) {
      pressOnly(link);
      inventoryViewing.hidden = false;
      inventoryViewing.textContent = `Viewing what ${group.name} holds.`;
      const url = new URL(window.location.href);
      url.searchParams.set('group', group.entity_id);
      url.searchParams.delete('character');
      window.history.replaceState({}, '', url);
      void loadBoard(group.entity_id);
    }

    // Adds one entry to the list of your characters and their groups: a link to its board
    // (?character= or ?group=), a group marked as one. Shown at once if the URL names it.
    function addHolder(
      holder: { entity_id: string; name: string },
      param: 'character' | 'group',
      select: (link: HTMLAnchorElement) => void,
    ) {
      const fragment = fromTemplate('holderListItem');
      const item = fragment.querySelector<HTMLLIElement>('li')!;
      const link = fragment.querySelector<HTMLAnchorElement>('[data-name]')!;
      const groupBadge = fragment.querySelector<HTMLSpanElement>('[data-group]')!;

      const url = new URL(window.location.href);
      url.searchParams.set(param, holder.entity_id);
      url.searchParams.delete(param === 'character' ? 'group' : 'character');
      link.href = url.href;
      link.textContent = holder.name;
      link.setAttribute('aria-pressed', String(holder.entity_id === params.get(param)));
      link.addEventListener('click', (event) => {
        event.preventDefault();
        select(link);
      });
      link.addEventListener('mouseenter', () => prefetchBoard(holder.entity_id));
      link.addEventListener('focus', () => prefetchBoard(holder.entity_id));
      groupBadge.hidden = param !== 'group';

      characterStrip.append(item);
      if (holder.entity_id === params.get(param)) select(link);
    }

    async function loadGroups(currentTenantId: string, characters: CharacterSummary[]) {
      const groups = await groupsOf(currentTenantId, characters).catch(() => []);
      for (const group of groups) {
        myHolderIds.add(group.entity_id);
        addHolder(group, 'group', (link) => selectGroup(group, link));
      }
    }

    // GM-only: browse any being's inventory - by search against
    // GET /tenants/{t}/beings (ADR 0078: PCs, NPCs, and bare beings alike),
    // or a raw entity id as a quick-entry shortcut. Deselects the "your
    // characters" pill strip since none of the player's own characters is
    // the one being shown.
    function browseBeing(being: BeingRef) {
      pressOnly(null);
      inventoryViewing.hidden = false;
      inventoryViewing.textContent = `Viewing ${being.name}'s inventory.`;
      void loadBoard(being.entity_id);
    }

    // GM-only: browse unowned loot (ADR 0077/#95).
    function browseUnowned() {
      pressOnly(null);
      inventoryViewing.hidden = false;
      inventoryViewing.textContent = 'Viewing unowned items.';
      void loadUnownedBoard();
    }

    async function loadCharacters(currentTenantId: string) {
      try {
        const page = await listMyCharacters(currentTenantId);
        myCharacters = page.items;
        for (const character of page.items) myHolderIds.add(character.entity_id);
        charactersLoading.hidden = true;
        if (page.items.length === 0) {
          charactersEmpty.hidden = false;
          return;
        }
        for (const character of page.items) {
          addHolder(character, 'character', (link) => selectCharacter(character, link));
        }
        await loadGroups(currentTenantId, page.items);
      } catch (e) {
        charactersLoading.hidden = true;
        charactersError.hidden = false;
        charactersError.textContent = e instanceof Error ? e.message : String(e);
      }
    }

    boardSearch.addEventListener('input', () => {
      const query = boardSearch.value.trim().toLowerCase();
      for (const card of boardColumns.querySelectorAll<HTMLLIElement>('.item-card')) {
        const item = boardItems.get(card.dataset.entityId ?? '');
        card.hidden = item ? !matchesSearch(item, query) : false;
      }
    });

    let gmBrowseDebounce: ReturnType<typeof setTimeout> | undefined;
    gmBrowseSearch.addEventListener('input', () => {
      clearTimeout(gmBrowseDebounce);
      const query = gmBrowseSearch.value.trim();
      if (!query) {
        gmBrowseSuggestions.hidden = true;
        gmBrowseSuggestions.replaceChildren();
        return;
      }
      gmBrowseDebounce = setTimeout(async () => {
        const { beings, groups } = await searchBeingsAndGroups(tenantId as string, query);
        renderBeingSuggestions(
          gmBrowseSuggestions,
          beings,
          (being) => {
            gmBrowseSearch.value = being.name;
            gmBrowseSuggestions.hidden = true;
            browseBeing(being);
          },
          groups,
        );
      }, 200);
    });

    gmBrowseSearch.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') gmBrowseSuggestions.hidden = true;
    });

    document.addEventListener('click', (event) => {
      if (!gmBrowseCombobox.contains(event.target as Node)) {
        gmBrowseSuggestions.hidden = true;
      }
    });

    gmBrowseRawIdButton.addEventListener('click', () => {
      const id = gmBrowseRawId.value.trim();
      if (!id) return;
      browseBeing({ entity_id: id, name: id });
    });

    if (!(await isAuthenticated())) {
      status.textContent = "You're not logged in. Log in to continue.";
    } else if (!tenantId) {
      status.textContent = 'No tenant selected. Pick one to continue.';
    } else {
      try {
        const tenant = await getTenant(tenantId);
        status.hidden = true;
        tenantName.textContent = tenant.name;
        board.hidden = false;
        await loadCharacters(tenantId);

        userIsGm = await isCampaignGm(tenantId);
        if (userIsGm) {
          pickerTablist.hidden = false;
          tabBrowse.hidden = false;
          tabUnowned.hidden = false;
        }
      } catch (e) {
        status.textContent = e instanceof Error ? e.message : String(e);
      }
    }
  </script>
</Base>
