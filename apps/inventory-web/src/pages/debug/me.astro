---
import Base from '../../layouts/Base.astro';
---

<Base title="Debug: GET /me — Lorenzo">
  <h1 class="display">
    <code>GET /me</code>
  </h1>
  <p><a href="/">&larr; Back</a></p>
  <pre id="result">Loading&hellip;</pre>

  <script>
    import { errorMessage } from '../../lib/errorMessage';
    import { requiredIn } from '../../lib/template';
    import { client, unwrap } from '../../lib/api';
    import { isAuthenticated } from '../../lib/auth';

    const required = requiredIn('Debug page');
    const result = required<HTMLElement>(document, '#result');

    if (!(await isAuthenticated())) {
      result.textContent = "You're not logged in. Log in to continue.";
    } else {
      try {
        const me = await unwrap(await client.GET('/me'));
        result.textContent = JSON.stringify(me, null, 2);
      } catch (e) {
        result.textContent = errorMessage(e);
      }
    }
  </script>
</Base>
