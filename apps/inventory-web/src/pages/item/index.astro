---
import Base from '../../layouts/Base.astro';
import ItemPage from '../../components/ItemPage/ItemPage.astro';
---

<Base title="Item — Lorenzo">
  <p id="status">
    Loading&hellip; <span class="spinner" role="status" aria-label="Loading"></span>
  </p>

  <ItemPage />

  <script>
    import { renderItemPage } from '../../components/ItemPage/renderer';
    import { addressedTenant, isId } from '../../lib/addresses';
    import { isAuthenticated } from '../../lib/auth';
    import { descriptionRenderer } from '../../lib/descriptions';
    import { errorMessage } from '../../lib/errorMessage';
    import { findItem } from '../../lib/itemLookup';
    import { say } from '../../lib/statusLine';
    import { requiredIn } from '../../lib/template';

    const required = requiredIn('Item page');
    const status = required<HTMLElement>(document, '#status');
    const page = required<HTMLElement>(document, '[data-item-page]');

    const params = new URLSearchParams(window.location.search);
    // By id or by slug (ADR 0135).
    const addressed = await addressedTenant(params.get('tenant'));
    const itemId = params.get('id');
    // ?slug=, or an ?id= that's a slug (ADR 0113, 0135).
    const itemSlug = params.get('slug') ?? (itemId && !isId(itemId) ? itemId : null);

    if (!(await isAuthenticated())) {
      say(status, "You're not logged in. Log in to continue.");
    } else if (addressed.problem) {
      say(status, addressed.problem);
    } else if (!addressed.id || !(itemId || itemSlug)) {
      say(status, "This link is incomplete — it's missing a library or item.");
    } else {
      const tenantId = addressed.id;

      try {
        const found = await findItem(tenantId, { slug: itemSlug, id: itemId });

        say(status, '');
        await renderItemPage({
          root: page,
          tenantId,
          renderer: descriptionRenderer(tenantId),
        }).show(found);
      } catch (error) {
        say(status, errorMessage(error), true);
        page.hidden = true;
      }
    }
  </script>
</Base>
