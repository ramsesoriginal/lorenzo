---
import Base from '../../layouts/Base.astro';
---

<Base title="Item — Lorenzo">
  <p><a href="/">&larr; Tenants</a></p>
  <p id="status">Loading&hellip;</p>

  <div id="page" hidden>
    <div class="item-detail-content">
      <h1 class="display" id="item-title"></h1>
      <p id="item-slug" class="item-detail-slug" hidden></p>
      <p id="item-qty" class="item-detail-qty" hidden></p>
      <button type="button" id="copy-link-button">Copy link</button>

      <dl id="item-stats" class="item-detail-stats"></dl>
      <p id="item-flags" class="item-detail-flags" hidden></p>

      <div id="item-ancestry" class="item-detail-ancestry" hidden>
        <h2>Ancestry</h2>
        <ul id="item-ancestry-list"></ul>
      </div>

      <div id="item-descriptions" class="item-detail-descriptions"></div>
      <button type="button" id="description-edit" class="btn btn-secondary" hidden>
        Edit description
      </button>
      <form id="description-form" class="description-form" hidden>
        <textarea id="description-source" name="content" rows="12" aria-label="Description"
        ></textarea>
        <label id="description-public-field" class="field-row">
          <input type="checkbox" id="description-public" checked />
          Players can read this
        </label>
        <ul id="description-notes" class="description-notes status-text"></ul>
        <div class="field-row">
          <button type="submit" id="description-save">Save</button>
          <button type="button" id="description-cancel" class="btn btn-secondary">Cancel</button>
        </div>
      </form>
      <p id="description-status" class="status-text" role="status" hidden></p>

      <section id="item-mentioned-in" class="section" hidden>
        <h2>Mentioned in</h2>
        <ul id="item-mentioned-in-list" class="chip-list"></ul>
      </section>

      <section id="item-used-by" class="section" hidden>
        <h2>Used as a prototype by</h2>
        <ul id="item-used-by-list" class="chip-list"></ul>
      </section>
    </div>
  </div>

  <script>
    import { createEditor, type Editor } from '@lorenzo/lorenzoscript-editor';
    import { fetchAncestryTree } from '../../lib/ancestryTree';
    import { ApiError } from '../../lib/api';
    import { isAuthenticated } from '../../lib/auth';
    import {
      createDescription,
      type DescriptionPayload,
      descriptionRenderer,
      getBacklinks,
      getDescription,
      saveDescription,
      showDescriptions,
    } from '../../lib/descriptions';
    import { entityHref } from '../../lib/entityLinks';
    import {
      getCatalogItem,
      getItemInstance,
      getItemInstanceBySlug,
      listItemsUsingPrototype,
    } from '../../lib/items';
    import { isCampaignGm } from '../../lib/me';
    import type { ItemBase } from '../../lib/types';

    const status = document.getElementById('status')!;
    const page = document.getElementById('page')!;
    const itemTitle = document.getElementById('item-title')!;
    const itemSlug = document.getElementById('item-slug')!;
    const itemQty = document.getElementById('item-qty')!;
    const copyLinkButton = document.getElementById('copy-link-button') as HTMLButtonElement;
    const itemStats = document.getElementById('item-stats')!;
    const itemFlags = document.getElementById('item-flags')!;
    const itemAncestry = document.getElementById('item-ancestry')!;
    const itemAncestryList = document.getElementById('item-ancestry-list') as HTMLUListElement;
    const itemDescriptions = document.getElementById('item-descriptions')!;
    const itemUsedBy = document.getElementById('item-used-by')!;
    const itemUsedByList = document.getElementById('item-used-by-list') as HTMLUListElement;
    const itemMentionedIn = document.getElementById('item-mentioned-in')!;
    const itemMentionedInList = document.getElementById(
      'item-mentioned-in-list',
    ) as HTMLUListElement;
    const descriptionEdit = document.getElementById('description-edit') as HTMLButtonElement;
    const descriptionForm = document.getElementById('description-form') as HTMLFormElement;
    const descriptionSource = document.getElementById('description-source') as HTMLTextAreaElement;
    const descriptionPublicField = document.getElementById('description-public-field')!;
    const descriptionPublic = document.getElementById('description-public') as HTMLInputElement;
    const descriptionNotes = document.getElementById('description-notes') as HTMLUListElement;
    const descriptionSave = document.getElementById('description-save') as HTMLButtonElement;
    const descriptionCancel = document.getElementById('description-cancel') as HTMLButtonElement;
    const descriptionStatus = document.getElementById('description-status')!;

    const params = new URLSearchParams(window.location.search);
    const tenantId = params.get('tenant');
    const itemId = params.get('id');
    const itemSlugParam = params.get('slug');
    const renderDescriptions = descriptionRenderer(tenantId as string);

    // The shown item's entity and description texts, kept current by saves.
    let entityId = '';
    let descriptions: string[] = [];
    // While editing: the description being replaced, or null when writing a new one.
    let editing: DescriptionPayload | null = null;
    let editor: Editor | undefined;
    const STALE_DESCRIPTION =
      'Someone saved this description after you opened it. Copy your text, reload the page, and make your changes again.';

    copyLinkButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyLinkButton.textContent = 'Copied!';
      } catch {
        copyLinkButton.textContent = "Couldn't copy";
      } finally {
        window.setTimeout(() => {
          copyLinkButton.textContent = 'Copy link';
        }, 1500);
      }
    });

    function populate(item: ItemBase, slug: string | null, quantity: number | null) {
      document.title = `${item.title} — Lorenzo`;
      itemTitle.textContent = item.title;

      itemSlug.hidden = !slug;
      itemSlug.textContent = slug ?? '';

      const showQty = Boolean(quantity && quantity > 1);
      itemQty.hidden = !showQty;
      itemQty.textContent = showQty ? `×${quantity}` : '';

      itemStats.replaceChildren();
      const stats: [string, number | null][] = [
        ['Weight', item.weight],
        ['Height', item.height],
        ['Price', item.price],
        ['Rarity', item.rarity],
        ['HP', item.hp],
        ['Armor', item.armor],
      ];
      for (const [label, value] of stats) {
        if (value === null) continue;
        const dt = document.createElement('dt');
        dt.textContent = label;
        const dd = document.createElement('dd');
        dd.textContent = String(value);
        itemStats.append(dt, dd);
      }

      const flags = [item.is_magical && 'Magical', item.is_cursed && 'Cursed'].filter(Boolean);
      itemFlags.hidden = flags.length === 0;
      itemFlags.textContent = flags.join(' · ');

      entityId = item.entity_id;
      descriptions = item.descriptions.map((description) => description.content);
      showItemDescriptions();
    }

    function showItemDescriptions() {
      void showDescriptions(itemDescriptions, renderDescriptions, descriptions);
      descriptionEdit.textContent =
        descriptions.length > 0 ? 'Edit description' : 'Write a description';
    }

    function setDescriptionStatus(text: string, isError = false) {
      descriptionStatus.hidden = text === '';
      descriptionStatus.textContent = text;
      descriptionStatus.classList.toggle('error-text', isError);
    }

    function toggleEditor(open: boolean) {
      descriptionForm.hidden = !open;
      descriptionEdit.hidden = open;
      itemDescriptions.hidden = open;
      if (!open) {
        editor?.destroy();
        editor = undefined;
        descriptionNotes.replaceChildren();
      }
    }

    descriptionEdit.addEventListener('click', async () => {
      descriptionEdit.disabled = true;
      setDescriptionStatus('');
      try {
        editing = await getDescription(tenantId as string, entityId);
      } catch (e) {
        setDescriptionStatus(e instanceof Error ? e.message : String(e), true);
        return;
      } finally {
        descriptionEdit.disabled = false;
      }
      descriptionSource.value = editing?.content ?? '';
      descriptionPublicField.hidden = editing !== null;
      toggleEditor(true);
      editor = createEditor({
        textarea: descriptionSource,
        render: async (source) => {
          const [rendered] = await renderDescriptions([source]);
          descriptionNotes.replaceChildren(
            ...(rendered?.notes ?? []).map((note) => {
              const li = document.createElement('li');
              li.textContent = note;
              return li;
            }),
          );
          return rendered?.html ?? '';
        },
      });
      descriptionSource.focus();
    });

    descriptionCancel.addEventListener('click', () => {
      const changed = descriptionSource.value !== (editing?.content ?? '');
      if (changed && !window.confirm('Discard your changes to this description?')) return;
      setDescriptionStatus('');
      toggleEditor(false);
    });

    descriptionForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const content = descriptionSource.value;
      descriptionSave.disabled = true;
      setDescriptionStatus('Saving…');
      try {
        if (editing) {
          await saveDescription(tenantId as string, editing, content);
        } else {
          await createDescription(tenantId as string, entityId, content, descriptionPublic.checked);
        }
        // The edited description is the first one shown (ADR 0108).
        descriptions = editing ? [content, ...descriptions.slice(1)] : [content];
        setDescriptionStatus('');
        toggleEditor(false);
        showItemDescriptions();
      } catch (e) {
        const message = e instanceof Error ? e.message : String(e);
        const stale = e instanceof ApiError && e.status === 412;
        setDescriptionStatus(stale ? STALE_DESCRIPTION : message, true);
      } finally {
        descriptionSave.disabled = false;
      }
    });

    async function loadAncestry(directPrototypeId: string) {
      itemAncestry.hidden = false;
      const loading = document.createElement('li');
      loading.textContent = 'Loading…';
      itemAncestryList.replaceChildren(loading);
      try {
        const rootLi = await fetchAncestryTree(tenantId as string, directPrototypeId);
        itemAncestryList.replaceChildren(rootLi);
      } catch {
        itemAncestry.hidden = true;
      }
    }

    async function loadUsedBy(entityId: string) {
      itemUsedBy.hidden = false;
      try {
        const result = await listItemsUsingPrototype(tenantId as string, entityId);
        if (result.length === 0) {
          itemUsedBy.hidden = true;
          return;
        }
        itemUsedByList.replaceChildren();
        for (const usedByItem of result) {
          const li = document.createElement('li');
          li.className = 'chip';
          const span = document.createElement('span');
          span.textContent = usedByItem.title;
          li.append(span);
          itemUsedByList.append(li);
        }
      } catch {
        itemUsedBy.hidden = true;
      }
    }

    // What links here (ADR 0110): shown only when something does.
    async function loadMentionedIn(entityId: string) {
      try {
        const backlinks = await getBacklinks(tenantId as string, entityId);
        itemMentionedInList.replaceChildren(
          ...backlinks.map((backlink) => {
            const li = document.createElement('li');
            li.className = 'chip';
            const href = entityHref(tenantId as string, backlink);
            const label = href
              ? Object.assign(document.createElement('a'), { href })
              : document.createElement('span');
            label.textContent = backlink.name;
            label.title = backlink.title;
            li.append(label);
            return li;
          }),
        );
        itemMentionedIn.hidden = backlinks.length === 0;
      } catch {
        itemMentionedIn.hidden = true;
      }
    }

    if (!(await isAuthenticated())) {
      status.textContent = "You're not logged in. Log in to continue.";
    } else if (!tenantId || !(itemId || itemSlugParam)) {
      status.textContent = "This link is incomplete — it's missing a tenant or item.";
    } else {
      try {
        let asItem: ItemBase | null = null;
        let asInstance: (ItemBase & { slug: string | null }) | null = null;
        if (itemSlugParam) {
          // A slug always resolves to an instance - catalog items don't
          // have one, so there's no item-vs-instance ambiguity to try
          // both ways for, unlike the id case below.
          asInstance = await getItemInstanceBySlug(tenantId, itemSlugParam);
        } else {
          // Not knowing in advance whether this id is a catalog item or
          // an instance - try the item endpoint first, fall back to the
          // instance one only on a real 404, not on e.g. a network/auth
          // error, which should surface directly rather than being
          // masked by a second, differently-failing request.
          try {
            asItem = await getCatalogItem(tenantId, itemId as string);
          } catch (e) {
            if (!(e instanceof ApiError) || e.status !== 404) throw e;
            asInstance = await getItemInstance(tenantId, itemId as string);
          }
        }

        status.hidden = true;
        page.hidden = false;

        if (asItem) {
          populate(asItem, null, null);
          void loadAncestry(asItem.entity_id);
          void loadUsedBy(asItem.entity_id);
        } else if (asInstance) {
          populate(asInstance, asInstance.slug, asInstance.quantity);
          const directId = asInstance.prototype_ids[0];
          if (directId) void loadAncestry(directId);
        }
        void loadMentionedIn(entityId);
        // GMs write descriptions here (ADR 0108); the API still decides.
        void isCampaignGm().then(
          (gm) => {
            descriptionEdit.hidden = !gm;
          },
          () => {},
        );
      } catch (e) {
        status.hidden = false;
        page.hidden = true;
        status.textContent = e instanceof Error ? e.message : String(e);
      }
    }
  </script>
</Base>
