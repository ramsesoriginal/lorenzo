<div class="stack" data-tag-editor>
  <p class="status-text" data-message hidden></p>
  <div class="stack-tight" data-tags></div>
  <p class="status-text" role="status" data-status hidden></p>

  <template data-tag-template>
    <div class="option-group" role="group" data-tag>
      <span class="option-group-label" data-label></span>
      <div class="row" data-choices></div>
    </div>
  </template>

  <template data-choice-template>
    <label class="field-row">
      <input type="radio" data-radio />
      <span data-text></span>
    </label>
  </template>
</div>
