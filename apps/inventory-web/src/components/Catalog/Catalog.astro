---
import { BRANDING_CSS_URL } from '../../lib/config';
---

<section class="section-lg" aria-labelledby="catalog-heading" data-catalog>
  <h2 id="catalog-heading">Catalog</h2>

  <p class="field-note" data-intro hidden>
    Everything your GMs have put in the public catalog.
  </p>


  <div class="with-sidebar full-width">

    <div class="stack">
      <div class="catalog-toolbar">
        <input
          type="search"
          class="text-input"
          data-search
          placeholder="Search the item catalog…"
          aria-label="Search the item catalog"
        />
      </div>
      <div class="stack">
        <strong>Filter:</strong>
        <ul class="tree stagger" data-filter>
        </ul>
      </div>
    </div>
    <div class="stack">
        <p data-empty hidden>No items match.</p>
        <p class="error-text" data-error hidden></p>
        <ul class="catalog-list list stagger vertical-window vertical-mask" data-list hidden></ul>
    </div>
  </div>

  <template data-filter-branch-template>
    <li>
      <details>
        <summary>
          <label class="row-tight">
            <input
              type="checkbox"
              data-filter-checkbox
            />

            <span data-filter-title></span>
          </label>

          <svg class="icon tree-toggle">
            <use href={`${BRANDING_CSS_URL}/icons.svg#icon-expand`}></use>
          </svg>
        </summary>

        <ul data-filter-children></ul>
      </details>
    </li>
  </template>

  <template data-filter-leaf-template>
    <li>
      <label class="row">
        <input
          type="checkbox"
          data-filter-checkbox
        />

        <span data-filter-title></span>
      </label>
    </li>
  </template>

  <template data-row-template>
    <li class="catalog-row">
      <div class="row grow sticky-top">
        <span data-name class="row">
          <strong class="catalog-row-title" data-title></strong>
          <span class="pill pill-success" data-public hidden>Public</span>
        </span>

        <div data-panel class="grow"></div>
        <div class="catalog-row-actions row">
          <a class="btn btn-secondary" data-view>View</a>

          <button type="button" data-edit>
            Edit
          </button>

          <button type="button" data-instantiate>
            Create instance
          </button>

          <button
            type="button"
            class="btn-danger"
            data-delete
          >
            Delete
          </button>
        </div>
      </div>

    </li>
  </template>

  <template data-skeleton-template>
    <li class="catalog-row skeleton"></li>
  </template>
</section>
