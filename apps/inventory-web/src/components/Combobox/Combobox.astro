---
// A text field that offers suggestions as you type, rendered by renderCombobox.
interface Props {
  placeholder?: string;
  // The field's name, when no visible label points at it.
  label?: string;
  labelledby?: string;
  id?: string;
}

const { placeholder, label, labelledby, id } = Astro.props;
---

<div class="combobox" data-combobox>
  <input
    type="text"
    class="text-input"
    role="combobox"
    autocomplete="off"
    aria-expanded="false"
    id={id}
    placeholder={placeholder}
    aria-label={label}
    aria-labelledby={labelledby}
    data-input
  />
  <ul class="combobox-suggestions" role="listbox" hidden data-suggestions></ul>
  <template data-suggestion-template>
    <li class="combobox-suggestion" role="option">
      <button type="button" data-select></button>
    </li>
  </template>
</div>
