---
import Combobox from '../Combobox/Combobox.astro';
---

<section class="stack-tight add-item" aria-labelledby="add-item-heading" data-add-item hidden>
  <h3 id="add-item-heading">Add an item</h3>

  <div class="stack-tight" data-off-block hidden>
    <p class="status-text" data-off></p>
    <div class="dialog-actions">
      <button type="button" class="btn btn-secondary" data-cancel>
        Close
      </button>
    </div>
  </div>

  <div class="stack-tight" data-add-form hidden>
    <p class="field-note" data-hint></p>

    <fieldset class="add-source" data-source>
      <legend class="field-note">Where does it come from</legend>
      <label class="row-tight">
        <input type="radio" name="add-source" value="list" checked data-source-list />
        From the list
      </label>
      <label class="row-tight" data-not-listed hidden>
        <input type="radio" name="add-source" value="free" data-source-free />
        Not in the list
      </label>
    </fieldset>
    <p class="field-note" data-matched-later hidden></p>

    <p class="field-note" data-no-unsorted hidden>
      This library can't take unsorted items yet. Ask your <span data-gm-title></span> to run
      <code>lorenzo seed --layer core</code>.
    </p>

    <form class="stack-tight" data-confirm>
      <div class="field" data-find>
        <span class="field-label" id="add-item-find-label" aria-hidden="true">
          Item
        </span>
        <Combobox placeholder="Search the catalog…" label="Find an item" />
      </div>
      <label class="field">
        <span class="field-label">A name of your own, if you like</span>
        <input class="text-input" type="text" data-call-it autocomplete="off" />
      </label>
      <div class="dialog-actions">
        <button type="button" class="btn btn-secondary" data-cancel>
          Cancel
        </button>
        <button type="submit" class="btn btn-primary" data-add disabled>
          Add
        </button>
      </div>
    </form>

    <form class="stack-tight" data-unsorted-form hidden>
      <label class="field">
        <span class="field-label">Name</span>
        <input class="text-input" type="text" data-unsorted-name autocomplete="off" required />
      </label>
      <label class="field">
        <span class="field-label">Description (optional)</span>
        <textarea class="text-input" rows="3" data-unsorted-description></textarea>
      </label>
      <div class="field-row">
        <label class="field">
          <span class="field-label">Weight in pounds (optional)</span>
          <input
            class="text-input"
            type="text"
            inputmode="decimal"
            data-unsorted-weight
            autocomplete="off"
          />
        </label>
        <label class="field">
          <span class="field-label">Value (optional)</span>
          <input class="text-input" type="text" data-unsorted-value autocomplete="off" />
        </label>
      </div>
      <div class="dialog-actions">
        <button type="button" class="btn btn-secondary" data-cancel>
          Cancel
        </button>
        <button type="submit" class="btn btn-primary" data-unsorted-add>
          Add
        </button>
      </div>
    </form>
  </div>

  <p class="status-text board-add-status" role="status" data-status hidden>
    <span data-status-text></span>
    <button type="button" class="btn btn-secondary" data-undo hidden>
      Undo
    </button>
  </p>
</section>
