---
import Combobox from '../Combobox/Combobox.astro';
---

<section
  class="card card-body stack-tight board-add"
  aria-labelledby="add-item-heading"
  data-add-item
  hidden
>
  <h3 id="add-item-heading">Add an item</h3>

  <p class="status-text" data-off hidden></p>

  <div class="stack-tight" data-add-form hidden>
    <p class="field-note" data-hint></p>

    <div class="field" data-find>
      <span class="field-label" id="add-item-find-label">
        Find an item
      </span>
      <Combobox placeholder="Search the catalog…" labelledby="add-item-find-label" />
    </div>

    <div class="stack-tight" data-not-listed hidden>
      <button type="button" class="btn btn-secondary" data-not-listed-open>
        Not in the list? Add it as an unsorted item
      </button>
      <p class="field-note">
        Your GM matches it to a catalog item later. Your name and notes stay.
      </p>
    </div>

    <p class="field-note" data-no-unsorted hidden>
      This library can't take unsorted items yet. Ask your GM to run
      <code>lorenzo seed --layer core</code>.
    </p>

    <form class="stack-tight" data-unsorted-form hidden>
      <label class="field">
        <span class="field-label">Name</span>
        <input class="text-input" type="text" data-unsorted-name autocomplete="off" required />
      </label>
      <label class="field">
        <span class="field-label">Description (optional)</span>
        <textarea class="text-input" rows="3" data-unsorted-description></textarea>
      </label>
      <div class="field-row">
        <label class="field">
          <span class="field-label">Weight in pounds (optional)</span>
          <input
            class="text-input"
            type="text"
            inputmode="decimal"
            data-unsorted-weight
            autocomplete="off"
          />
        </label>
        <label class="field">
          <span class="field-label">Value (optional)</span>
          <input class="text-input" type="text" data-unsorted-value autocomplete="off" />
        </label>
      </div>
      <div class="field-row">
        <button type="submit" data-unsorted-add>
          Add
        </button>
        <button type="button" class="btn btn-secondary" data-unsorted-back>
          Back
        </button>
      </div>
    </form>

    <form class="stack-tight" data-confirm hidden>
      <div class="field-row">
        <span class="chip" data-picked></span>
        <button type="button" class="btn btn-secondary" data-change>
          Pick another
        </button>
      </div>
      <label class="field">
        <span class="field-label">Call it (optional)</span>
        <input class="text-input" type="text" data-call-it autocomplete="off" />
      </label>
      <div class="field-row">
        <button type="submit" data-add>
          Add
        </button>
      </div>
    </form>
  </div>

  <p class="status-text board-add-status" role="status" data-status hidden>
    <span data-status-text></span>
    <button type="button" class="btn btn-secondary" data-undo hidden>
      Undo
    </button>
  </p>
</section>
