---
import Combobox from '../Combobox/Combobox.astro';
---

<!-- Finding any being (a GM's): the board's name is a switcher (IN7), and its menu opens this. -->
<dialog aria-labelledby="find-being-title" data-find-dialog>
  <div class="stack-tight">
    <h2 id="find-being-title">Find any being</h2>
    <div class="field">
      <label class="field-label" id="browse-label" for="browse-search">
        {' '}
        Search beings{' '}
      </label>
      <Combobox id="browse-search" placeholder="Search beings…" labelledby="browse-label" />
    </div>
    <div class="being-id-row">
      <input
        type="text"
        class="text-input"
        placeholder="or a being's id or slug…"
        aria-label="Being's id or slug"
        data-browse-raw-id
      />
      <button type="button" class="btn btn-secondary" data-browse-raw-id-button>
        View
      </button>
    </div>
    <div class="dialog-actions">
      <button type="button" class="btn btn-secondary" data-find-close>
        Close
      </button>
    </div>
  </div>
</dialog>
