<!-- A checkbox with a note saying what happens without it, copied by renderCheckboxField. -->
<template data-checkbox-field-template>
  <div>
    <label class="field-row">
      <input type="checkbox" data-input />
      <span data-label></span>
    </label>
    <p class="field-note" data-note></p>
  </div>
</template>
