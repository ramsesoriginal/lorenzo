<section class="section-lg" data-library-list hidden>
  <h2>Your libraries</h2>
  <p data-loading>Loading libraries&hellip;</p>
  <p data-empty hidden>
    You don't have access to a library yet.
  </p>
  <p class="error-text" data-error hidden></p>
  <ul class="list" data-list></ul>

  <template data-library-template>
    <li>
      <a data-link>
        <div class="row">
          <strong data-name></strong>
          <span class="pill" data-kind hidden></span>
          <span class="badge" data-role></span>
        </div>
      </a>
    </li>
  </template>
</section>
