<section
  id="instances"
  class="section-lg"
  aria-labelledby="instances-heading"
  data-instances
  hidden
>
  <h2 id="instances-heading">Instances</h2>

  <div class="field">
    <span class="field-label" data-browse-label>View a being's inventory</span>
    <div class="combobox" data-browse-combobox>
      <input
        type="text"
        class="text-input"
        data-browse-search
        placeholder="Search beings…"
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
      />
      <ul class="combobox-suggestions" data-browse-suggestions role="listbox" hidden></ul>
    </div>
  </div>

  <p class="next-up" data-viewing hidden></p>
  <p data-empty hidden></p>
  <p class="error-text" data-error hidden></p>
  <div data-groups></div>

  <template data-group-template>
    <div class="section">
      <h3 data-heading></h3>
      <ul class="catalog-list" data-list></ul>
    </div>
  </template>

  <template data-row-template>
    <li class="catalog-row">
      <div class="catalog-row-header">
        <span class="catalog-row-title" data-title></span>
        <div class="catalog-row-actions">
          <button type="button" class="btn-secondary" data-view>View</button>
          <button type="button" data-reassign>Reassign</button>
          <button type="button" data-unassign>Unassign</button>
          <button type="button" class="btn-danger" data-delete>Delete</button>
        </div>
      </div>
      <div data-panel></div>
    </li>
  </template>
</section>
