---
import { BRANDING_CSS_URL } from '../lib/config';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Lorenzo — Inventory' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <!-- @lorenzo/brand's tokens.css gates its dark values behind
         [data-theme="dark"] (identity.md's own CSS starter), rather than
         a pure prefers-color-scheme media query - so this app has to set
         that attribute itself. Synchronous and inline, before first
         paint, so there's no light-mode flash for a dark-preferring
         browser (ADR 0098 doesn't build a manual toggle here - just
         following the system preference, same as this app's previous
         light-dark()-based tokens.css did automatically). -->
    <script is:inline>
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    </script>
    <!-- Remembers the last tenant in the URL, and puts it back into a
         subpage's URL that has none - before any page script reads
         ?tenant=, so those keep reading only the URL. Also inline and
         synchronous for that reason, so it can't import lib/lastTenant.ts -
         its KEY is that file's LAST_TENANT_KEY, keep the two in step. -->
    <script is:inline>
      (function () {
        var KEY = 'lorenzo:lastTenant';
        var url = new URL(window.location.href);
        var tenant = url.searchParams.get('tenant');
        try {
          if (tenant) {
            localStorage.setItem(KEY, tenant);
          } else if (url.pathname !== '/' && url.pathname.indexOf('/auth/') !== 0) {
            var stored = localStorage.getItem(KEY);
            if (stored) {
              url.searchParams.set('tenant', stored);
              history.replaceState(history.state, '', url);
            }
          }
        } catch (e) {
          // Storage unavailable (private browsing, disabled) - the page
          // just behaves as if nothing was remembered.
        }
      })();
    </script>
    <link rel="stylesheet" href={`${BRANDING_CSS_URL}/normalize.css`} />
    <link rel="stylesheet" href={`${BRANDING_CSS_URL}/tokens.css`} />
    <link rel="stylesheet" href={`${BRANDING_CSS_URL}/fonts.css`} />
    <link rel="stylesheet" href={`${BRANDING_CSS_URL}/base.css`} />
    <link rel="stylesheet" href={`${BRANDING_CSS_URL}/layout.css`} />
    <link rel="stylesheet" href={`${BRANDING_CSS_URL}/components.css`} />
    <!-- .skeleton (loading placeholders, components.css) -->
    <link rel="stylesheet" href={`${BRANDING_CSS_URL}/motion.css`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="row">
        <a class="brand display" href="/" aria-label="Lorenzo">
          <img
            class="brand-mark brand-mark--light"
            src="/brand/lorenzo_horizontal_lockup_light_bg.svg"
            alt="Lorenzo"
          />
          <img
            class="brand-mark brand-mark--dark"
            src="/brand/lorenzo_horizontal_lockup_dark_bg.svg"
            alt="Lorenzo"
          />
        </a>
        <nav class="row" aria-label="Subpages">
          <a href="/" data-path="/">Home</a>
          <a href="/board/" data-path="/board/" data-needs-tenant hidden>Board</a>
          <a href="/items/" data-path="/items/" data-needs-tenant hidden>Items</a>
        </nav>
      </div>
      <div class="row">
        <div id="tenant-switcher-group" class="account row-tight" hidden>
          <svg class="icon" aria-hidden="true">
            <use href={`${BRANDING_CSS_URL}/icons.svg#icon-library`}></use>
          </svg>
          <select id="tenant-switcher" aria-label="Library" class="text-input" style="width: auto;"
          ></select>
        </div>

        <div class="account row-tight">
          <p id="account-loading">Checking your session&hellip;</p>
          <p id="account-error" class="error-text" hidden></p>
          <div id="account-signed-out" class="row" hidden>
            <button id="login-button" type="button" class="btn row-tight">
              <svg class="icon" aria-hidden="true">
                <use href={`${BRANDING_CSS_URL}/icons.svg#icon-login`}></use>
              </svg>
              Log in
            </button>
          </div>
          <div id="account-signed-in" class="row" hidden>
            <span>Signed in as <strong id="account-email"></strong>.</span>
            <button id="logout-button" type="button" class="btn btn-secondary row-tight">
              <svg class="icon" aria-hidden="true">
                <use href={`${BRANDING_CSS_URL}/icons.svg#icon-logout`}></use>
              </svg>
              Log out
            </button>
            <a href="/debug/me">Debug: <code>GET /me</code></a>
          </div>
        </div>

        <button class="btn btn-secondary" id="theme-toggle" type="button" aria-pressed="false">
          ☾ dark
        </button>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer>
      <div class="wrap">
        Part of <code>apps/inventory-web</code>
      </div>
    </footer>

    <script>
      import { getUserInfo, isAuthConfigured, isAuthenticated, login, logout } from '../lib/auth';
      import { LAST_TENANT_EVENT, getLastTenant, rememberTenant } from '../lib/lastTenant';
      import { listTenants } from '../lib/tenants';
      import { isCampaignGm } from '../lib/me';

      let userIsGm = false;

      // The tenant this page is about: the URL's (the head script puts a
      // remembered one there on a subpage), else the remembered one (home).
      function currentTenant(): string | null {
        return new URLSearchParams(window.location.search).get('tenant') ?? getLastTenant();
      }

      // Nav links: a tenant's pages link to the current tenant, and stay
      // hidden until there is one.
      async function updateNav() {
        const tenant = currentTenant();
        if (tenant) {
          userIsGm = await isCampaignGm(tenant);
        }
        for (const link of document.querySelectorAll<HTMLAnchorElement>('nav a[data-path]')) {
          const path = link.dataset.path!;
          if (link.hasAttribute('data-needs-tenant')) {
            link.hidden = !tenant;
            link.href = tenant ? `${path}?tenant=${encodeURIComponent(tenant)}` : path;
          }
          if (path === window.location.pathname) link.setAttribute('aria-current', 'page');
        }
      }

      await updateNav();
      window.addEventListener(LAST_TENANT_EVENT, updateNav);

      // Tenant switcher: only for a signed-in user with more than one tenant.
      // Switching stays on the board or the catalog, of the other tenant;
      // anything else (an item, home) goes to its board, since what it shows
      // belongs to the tenant being left.
      async function initTenantSwitcher() {
        const { items: tenants } = await listTenants();
        if (tenants.length < 2) return;

        const switcher = document.getElementById('tenant-switcher') as HTMLSelectElement;
        const current = currentTenant();
        if (!tenants.some((tenant) => tenant.id === current)) {
          switcher.append(new Option('Choose a library…', '', true, true));
        }
        for (const tenant of tenants) {
          switcher.append(new Option(tenant.name, tenant.id, false, tenant.id === current));
        }
        switcher.addEventListener('change', () => {
          if (!switcher.value) return;
          rememberTenant(switcher.value);
          const path = ['/board/', '/items/'].includes(window.location.pathname)
            ? window.location.pathname
            : '/board/';
          window.location.assign(`${path}?tenant=${encodeURIComponent(switcher.value)}`);
        });
        // The whole group, icon included - not a lone icon without its switcher.
        document.getElementById('tenant-switcher-group')!.hidden = false;
      }

      // Account: who's signed in, with log in/out - on every page. The auth
      // redirect page is still finishing the login, so it gets neither this
      // nor the switcher.
      async function initAccount() {
        const loading = document.getElementById('account-loading')!;
        const errorEl = document.getElementById('account-error')!;

        function showError(message: string) {
          loading.hidden = true;
          errorEl.hidden = false;
          errorEl.textContent = message;
        }

        if (window.location.pathname.startsWith('/auth/')) {
          loading.hidden = true;
          return;
        }
        if (!isAuthConfigured()) {
          showError('Authgear is not configured for this app yet.');
          return;
        }

        document.getElementById('login-button')!.addEventListener('click', () => {
          void login();
        });
        document.getElementById('logout-button')!.addEventListener('click', () => {
          void logout();
        });

        try {
          const authed = await isAuthenticated();
          if (!authed) {
            loading.hidden = true;
            document.getElementById('account-signed-out')!.hidden = false;
            return;
          }
          const info = await getUserInfo();
          loading.hidden = true;
          document.getElementById('account-email')!.textContent = info.email ?? info.sub;
          document.getElementById('account-signed-in')!.hidden = false;
        } catch (e) {
          showError(e instanceof Error ? e.message : String(e));
          return;
        }

        // Just a convenience - on failure, the header stays without it.
        initTenantSwitcher().catch(() => {});
      }

      void initAccount();

      (function () {
        var root = document.documentElement;
        var toggle = document.getElementById('theme-toggle')!;
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

        function apply(theme: 'dark' | 'light') {
          if (theme === 'dark') {
            root.setAttribute('data-theme', 'dark');
            toggle.textContent = '☀ light';
            toggle.setAttribute('aria-pressed', 'true');
          } else {
            root.removeAttribute('data-theme');
            toggle.textContent = '☾ dark';
            toggle.setAttribute('aria-pressed', 'false');
          }
        }

        apply(prefersDark ? 'dark' : 'light');

        toggle.addEventListener('click', function () {
          var isDark = root.getAttribute('data-theme') === 'dark';
          apply(isDark ? 'light' : 'dark');
        });
      })();
    </script>
  </body>
</html>
