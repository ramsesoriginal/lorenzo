---
import BeingPicker from '../components/BeingPicker/BeingPicker.astro';
import CheckboxField from '../components/CheckboxField/CheckboxField.astro';
import SiteFooter from '../components/SiteFooter/SiteFooter.astro';
import SiteHead from '../components/SiteHead/SiteHead.astro';
import SiteHeader from '../components/SiteHeader/SiteHeader.astro';

interface Props {
  title?: string;
}

const { title = 'Lorenzo — Inventory' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <SiteHead title={title} />
  <body>
    <SiteHeader />
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <!-- What the panels that find a being and give something copy, as any page may open one. -->
    <BeingPicker />
    <CheckboxField />

    <SiteFooter />
  </body>
</html>
