---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Lorenzo — Inventory' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Lorenzo">
        <img
          class="brand-mark brand-mark--light"
          src="/brand/lorenzo_horizontal_lockup_light_bg.svg"
          alt="Lorenzo"
          width="220"
          height="40"
        />
        <img
          class="brand-mark brand-mark--dark"
          src="/brand/lorenzo_horizontal_lockup_dark_bg.svg"
          alt="Lorenzo"
          width="220"
          height="40"
        />
      </a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
