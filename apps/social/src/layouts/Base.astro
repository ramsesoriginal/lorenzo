---
import AppPage from '@lorenzo/app-shell/AppPage.astro';
import { ClientRouter } from 'astro:transitions';
import { BRANDING_CSS_URL } from '../lib/config';
import appStyles from '../styles/app.css?url';

interface Props {
  title?: string;
  // The page's template (ADR 0412); a web is a workspace, the rest are lists and forms.
  template?: 'list-detail' | 'workspace';
  // What the welcome says while the page works out who is signed in.
  status?: string;
}

const {
  title = 'Lorenzo Social',
  status = 'Opening your libraries…',
  template = 'list-detail',
} = Astro.props;
---

<AppPage
  title={title}
  product="Social"
  icon="social"
  brandingUrl={BRANDING_CSS_URL}
  themeKey="lorenzo:social:theme"
  shell="web"
  template={template}
  nav={[
    { label: 'Libraries', href: '/', icon: 'social' },
    {
      label: 'Relationships',
      href: '/relationships/',
      needsLibrary: true,
      icon: 'kind-relationship',
      also: ['/relationship/'],
    },
    {
      label: 'Webs',
      href: '/webs/',
      needsLibrary: true,
      icon: 'kind-social-web',
      also: ['/web/', '/matrix/'],
    },
    { label: 'Types and standings', href: '/types/', needsLibrary: true, icon: 'kind-entity' },
  ]}
  path="apps/social"
  welcome={{
    title: 'Social',
    text: 'Who knows whom: the relationships between the beings and groups of your world, and how much each one counts.',
    status,
  }}
>
  <ClientRouter slot="head" />
  <link slot="head" rel="stylesheet" href={appStyles} />
  <slot />
</AppPage>
<script>
  import { bindLegalLinksFromApi } from '@lorenzo/app-shell/legal';
  import { API_BASE_URL } from '../lib/config';

  // The legal notice, the privacy policy and the support link, when the deployment has them
  // (ADR 0439). The footer is replaced when the client router swaps a page, so it is bound again.
  const bind = () => void bindLegalLinksFromApi(API_BASE_URL);
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
