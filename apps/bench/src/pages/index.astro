---
import '@lorenzo/brand/normalize.css';
import '@lorenzo/brand/tokens.css';
import '@lorenzo/brand/fonts.css';
import '@lorenzo/brand/base.css';
import '../styles/bench.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <!-- Brand tokens turn dark only via [data-theme="dark"]; set it before first paint. -->
    <script is:inline>
      try {
        var t = localStorage.getItem('bench:theme') || 'system';
        var dark =
          t === 'dark' || (t === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
      } catch (e) {}
    </script>
    <title>Lorenzo Bench</title>
  </head>
  <body>
    <header class="top" id="titlebar">
      <strong>Lorenzo Bench</strong>
    </header>
    <div class="live" id="live" role="status" hidden></div>
    <main id="bench"></main>
    <script>
      import { Bench } from '../core/bench';
      import { SampleTransport } from '../core/sample';
      import type { Transport } from '../core/transport';
      import { apiTransport } from '../lib/transport';
      import { LiveBanner } from '../shell/liveBanner';
      import { loadSession, signOut } from '../shell/session';
      import { Shell } from '../shell/shell';
      import { SAMPLE_ENTRIES, SAMPLE_STATS } from '../shell/stub';
      import { renderTitleBar } from '../shell/titlebar';

      const root = document.getElementById('bench');
      const bar = document.getElementById('titlebar');
      if (root && bar) {
        // The workbench and its shortcuts exist at once, empty; the session fills it in.
        const shell = new Shell(root, new Bench(new SampleTransport([])));
        (window as unknown as { bench: Shell }).bench = shell;
        const live = new LiveBanner(document.getElementById('live') as HTMLElement);
        const session = await loadSession();
        live.set(session.kind === 'signed-in' && session.published);

        // Signed in: the chosen repository, through the API. Otherwise a small sample one held
        // in memory, so the page can still be tried.
        let transport: Transport;
        let sample: SampleTransport | null = null;
        if (session.kind === 'signed-in' && session.current) {
          const { client } = await import('../lib/api');
          transport = apiTransport(client, session.current.id);
        } else {
          sample = new SampleTransport(
            session.kind === 'signed-in' ? [] : SAMPLE_ENTRIES,
            SAMPLE_STATS,
          );
          transport = sample;
        }

        const bench = new Bench(transport);
        shell.use(bench);
        renderTitleBar(bar, session, () => location.reload());

        const extra = [];
        if (session.kind === 'signed-in') {
          extra.push(
            ...session.repositories.map((r) => ({
              label: `Open repository ${r.name}`,
              run: () => {
                const select = bar.querySelector('select');
                if (select) {
                  select.value = r.id;
                  select.dispatchEvent(new Event('change'));
                }
              },
            })),
            { label: 'Sign out', run: () => void signOut() },
          );
        }
        if (sample) {
          const s = sample;
          // Exposed so the browser tests can play the server's part.
          (window as unknown as { sample: SampleTransport }).sample = s;
          extra.push(
            {
              label: 'Sample: publish the repository',
              run: () => live.set(true),
            },
            {
              label: 'Sample: lose the connection',
              run: () => {
                s.offline = true;
              },
            },
            {
              label: 'Sample: get the connection back',
              run: () => {
                s.offline = false;
                void bench.run();
              },
            },
          );
        }
        shell.extra = extra;

        await bench.loadEntries();
        const first = bench.entries.find((e) => e.kinds.includes('item'));
        if (first) shell.select(first.id);
      }
    </script>
  </body>
</html>
