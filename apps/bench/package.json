{
  "name": "@lorenzo/bench",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm run build-branding-package && astro dev",
    "build": "pnpm run build-branding-package && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "biome check . && astro check && prettier --check \"**/*.astro\"",
    "format": "biome check --write . && prettier --write \"**/*.astro\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build-branding-package": "pnpm --filter @lorenzo/brand run build",
    "test:e2e-api": "playwright test --config playwright.api.config.ts"
  },
  "dependencies": {
    "@authgear/web": "^6.0.0",
    "@lorenzo/api-client": "workspace:*",
    "@lorenzo/app-shell": "workspace:*",
    "@lorenzo/brand": "workspace:*",
    "@lorenzo/graph-renderer": "workspace:*",
    "@lorenzo/information-editor": "workspace:*",
    "@lorenzo/lorenzoscript": "workspace:*",
    "@lorenzo/lorenzoscript-editor": "workspace:*",
    "@lorenzo/repo-ui": "workspace:*",
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
