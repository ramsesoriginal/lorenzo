# Copy to .env and fill in. This app needs its own Authgear "Single Page Application" client
# (public, PKCE), with Authorized Redirect URIs http://127.0.0.1:4321/auth/redirect/ (the trailing
# slash is required) and the deployed https://<host>/auth/redirect/, and the same origins as
# Authorized Post-Logout Redirect URIs. See docs/operations/deployment-setup.md.
PUBLIC_AUTHGEAR_ENDPOINT=
PUBLIC_AUTHGEAR_CLIENT_ID=

# Optional: defaults to the deployed API. Set to a local apps/api (e.g. http://localhost:8000).
PUBLIC_API_BASE_URL=
