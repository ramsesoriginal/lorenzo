{
  "name": "@lorenzo/loot-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx --env-file=.env watch src/index.ts",
    "build": "tsup",
    "start": "node --env-file=.env dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "register-commands": "tsx --env-file=.env scripts/register-commands.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/migrate.ts",
    "generate-client": "openapi-typescript ../api/openapi.json -o src/lorenzo-schema.d.ts"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "drizzle-orm": "^0.36.4",
    "openapi-fetch": "^0.13.4",
    "openid-client": "^6.1.7",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.31.10",
    "msw": "^2.7.0",
    "openapi-typescript": "^7.5.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
