{
  "name": "@lorenzo/loot-bot",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx --env-file=.env watch src/index.ts",
    "build": "tsup",
    "start": "node --env-file=.env dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "register-commands": "tsx --env-file=.env scripts/register-commands.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/migrate.ts"
  },
  "dependencies": {
    "@lorenzo/api-client": "workspace:*",
    "discord-interactions": "^4.1.0",
    "discord.js": "^14.16.3",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "openapi-fetch": "^0.17.0",
    "openid-client": "^6.1.7",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^5.0.2",
    "drizzle-kit": "^0.31.11",
    "msw": "^2.7.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
