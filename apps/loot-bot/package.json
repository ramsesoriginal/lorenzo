{
  "name": "@lorenzo/loot-bot",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx --env-file=.env watch src/index.ts",
    "build": "tsup",
    "start": "node --env-file=.env dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "register-commands": "tsx --env-file=.env scripts/register-commands.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/migrate.ts"
  },
  "dependencies": {
    "@lorenzo/api-client": "workspace:*",
    "discord-interactions": "^4.1.0",
    "discord.js": "^14.28.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "openapi-fetch": "^0.17.0",
    "openid-client": "^6.8.9",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "msw": "^3.0.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.1.0"
  }
}
