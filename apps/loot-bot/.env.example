# Copy to .env (this app reads it relative to its own working directory,
# not the repo root - see the root .env.example's own note on this).

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

LORENZO_API_BASE_URL=http://localhost:8000
LORENZO_TENANT_ID=

# A dedicated Authgear application, separate from apps/api's own dev client
# (docs/operations/local-authgear-setup.md) - see README.md for setup.
AUTHGEAR_ISSUER=http://localhost:4000
AUTHGEAR_CLIENT_ID=
AUTHGEAR_CLIENT_SECRET=

# Same Postgres instance as apps/api (infra/docker-compose.yml), a separate
# role/schema (ADR 0029) - not apps/api's own lorenzo_app/lorenzo.
LOOT_BOT_DATABASE_URL=postgres://loot_bot:loot_bot@localhost:55432/lorenzo
LOOT_BOT_MIGRATIONS_DATABASE_URL=postgres://lorenzo:lorenzo@localhost:55432/lorenzo

# 32 random bytes, base64-encoded, e.g. `openssl rand -base64 32`.
LOOT_BOT_TOKEN_ENCRYPTION_KEY=

LOOT_BOT_HTTP_PORT=8090
LOOT_BOT_PUBLIC_BASE_URL=http://127.0.0.1:8090
