# The operator's details are not in the repository (ADR 0439). The build fails without them.
# One JSON object, validated by src/lib/profile.ts; see docs/operations/legal-pages.md.
LEGAL_PROFILE=
# Local development only: renders a sample profile under a visible "sample" banner.
LEGAL_PROFILE_SAMPLE=
# Where the brand stylesheets are served from; the default is the same origin.
PUBLIC_BRANDING_CSS_URL=
