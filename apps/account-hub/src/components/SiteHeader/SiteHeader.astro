---
import { BRANDING_CSS_URL } from '../../lib/config';
---

<header class="site-header" data-site-header>
  <div class="row h-mobile">
    <a class="brand display" href="/" aria-label="Lorenzo">
      <span class="display">✧ Lorenzo</span>
    </a>
    <details class="site-navigation">
      <summary>Navigation</summary>
      <nav class="row" aria-label="Subpages">
        <a href="/" data-path="/" class="row-tight">
          Home
        </a>
        <a
          href="/profile/"
          data-path="/profile/"
          data-requires="signed-in"
          class="row-tight"
          hidden
        >
          Profile
        </a>
        <a
          href="/tenants/"
          data-path="/tenants/"
          data-requires="signed-in"
          class="row-tight"
          hidden
        >
          <svg class="icon" width="28" height="28" aria-hidden="true">
            <use href={`${BRANDING_CSS_URL}/icons.svg#icon-library`}></use>
          </svg>
          Libraries
        </a>
        <a
          href="/repositories/"
          data-path="/repositories/"
          data-requires="library-admin"
          class="row-tight"
          hidden
        >
          Repositories
        </a>
        <a
          href="/studio/"
          data-path="/studio/"
          data-requires="repository-work"
          class="row-tight"
          hidden
        >
          My repositories
        </a>
        <a
          href="/discover/"
          data-path="/discover/"
          data-requires="discover"
          class="row-tight"
          hidden
        >
          Discover
        </a>
        <a
          href="/campaigns/"
          data-path="/campaigns/"
          data-requires="signed-in"
          class="row-tight"
          hidden
        >
          <svg class="icon" width="28" height="28" aria-hidden="true">
            <use href={`${BRANDING_CSS_URL}/icons.svg#icon-campaign`}></use>
          </svg>
          Campaigns
        </a>
        <a
          href="/setup/"
          data-path="/setup/"
          data-requires="create-tenant"
          class="row-tight"
          hidden
        >
          Set Up a table
        </a>
        <a href="/beings/" data-path="/beings/" data-requires="beings" class="row-tight" hidden>
          <svg class="icon" width="28" height="28" aria-hidden="true">
            <use href={`${BRANDING_CSS_URL}/icons.svg#icon-kind-beings`}></use>
          </svg>
          Beings
        </a>
        <a
          href="/notifications/"
          data-path="/notifications/"
          data-requires="signed-in"
          class="row-tight"
          hidden
        >
          <svg class="icon" aria-hidden="true">
            <use href={`${BRANDING_CSS_URL}/icons.svg#icon-notifications`}></use>
          </svg>
          Notifications
          <span class="canonical-marker" data-unread hidden></span>
        </a>
      </nav>
    </details>
  </div>

  <div class="row-tight">
    <div class="row-tight">
      <span data-account-loading>Checking your session&hellip;</span>
      <span class="error-text" data-account-error hidden></span>
      <div class="row" data-account-signed-out hidden>
        <button type="button" class="btn row-tight" data-login>
          <svg class="icon" aria-hidden="true">
            <use href={`${BRANDING_CSS_URL}/icons.svg#icon-login`}></use>
          </svg>
          Log in
        </button>
      </div>
      <div class="row" data-account-signed-in hidden>
        <span>
          Signed in as <strong data-account-email></strong>.
        </span>
        <button type="button" class="btn btn-secondary row-tight" data-logout>
          <svg class="icon" aria-hidden="true">
            <use href={`${BRANDING_CSS_URL}/icons.svg#icon-logout`}></use>
          </svg>
          Log out
        </button>
        <a
          href="/debug/me"
          style="display: inline-block; width: 0.5em;
                                   color: transparent;
                                   background-color: transparent;
                                   overflow: hidden;
                                   height: 1em;"
        >
          Debug: <code>GET /me</code>
        </a>
      </div>
    </div>

    <button type="button" class="btn btn-secondary" aria-pressed="false" data-theme-toggle>
      ☾ dark
    </button>
  </div>
</header>

<script>
  import { renderSiteHeader } from './renderer';

  const header = document.querySelector<HTMLElement>('[data-site-header]');

  if (header) await renderSiteHeader(header);
</script>
