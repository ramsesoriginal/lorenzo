---
// One repository in Studio (ADR 0202): its name, picture and description with the Edit button,
// and its tabs: Overview, People, Libraries using it, Built on and Activity. Rendered by renderRepository. The parts that are the same as a
// library's (the picture, the form that edits the name, the people) are components, kept here as
// <template>s or in place, and bound by their own renderers.
import { BRANDING_CSS_URL } from '../../lib/config';
import ActivityLog from '../ActivityLog/ActivityLog.astro';
import MembershipAdmin from '../MembershipAdmin/MembershipAdmin.astro';
import TenantInviteLinks from '../TenantInviteLinks/TenantInviteLinks.astro';
import PictureUpload from '../PictureUpload/PictureUpload.astro';
import TenantDelete from '../TenantDelete/TenantDelete.astro';
import TenantEdit from '../TenantEdit/TenantEdit.astro';
import DiscoverCard from '../Discover/DiscoverCard.astro';
import ReleaseComposer from './ReleaseComposer.astro';
---

<article class="stack card card-body" data-repository data-tenant hidden>
  <header class="stack">
    <div class="row">
      <div class="row grow">
        <h2 data-name></h2>
        <code data-slug></code>
      </div>
      <span class="badge" data-role></span>
    </div>
    <div class="row sticky-top">
      <div class="stack grow" data-tenant-edit>
        <div class="ls-content" data-tenant-description hidden></div>
        <div class="row">
          <button type="button" data-edit hidden>
            Edit <span data-noun></span>
          </button>
        </div>
        <span class="status-text" role="status" data-edit-status hidden></span>
      </div>
      <div data-picture-slot hidden></div>
    </div>
    <TenantEdit />
  </header>

  <p data-loading hidden>
    Loading&hellip;
  </p>
  <p class="error-text" role="alert" data-error hidden></p>

  <div class="stack" data-tabs>
    <div class="tabs" role="tablist" aria-label="This repository">
      <button type="button" class="tab" role="tab">
        Overview
      </button>
      <button type="button" class="tab" role="tab">
        Profile
      </button>
      <button type="button" class="tab" role="tab">
        People
      </button>
      <button type="button" class="tab" role="tab">
        Releases
      </button>
      <button type="button" class="tab" role="tab">
        Libraries using it
      </button>
      <button type="button" class="tab" role="tab">
        Built on
      </button>
      <button type="button" class="tab" role="tab">
        Activity
      </button>
    </div>

    <div class="stack" role="tabpanel">
      <section class="stack" data-overview hidden>
        <!-- Off Discover by the platform's operators (ADR 0303): every member reads it. -->
        <div class="card card-body stack-tight" role="status" data-delisted hidden>
          <p class="row">
            <span class="pill pill-warning" data-delisted-pill></span>
            <strong data-delisted-title></strong>
          </p>
          <p data-delisted-reason></p>
          <p data-delisted-effect></p>
        </div>
        <!-- Retired by its Owner (ADR 0384): every member reads it. -->
        <div class="card card-body stack-tight" role="status" data-retired hidden>
          <p class="row">
            <span class="pill pill-warning" data-retired-pill></span>
            <strong data-retired-title></strong>
          </p>
          <p data-retired-effect></p>
          <p data-retired-message hidden></p>
        </div>
        <h3>State</h3>
        <p class="row">
          <span data-state></span>
          <span data-state-explanation></span>
        </p>
        <p class="row" data-live hidden>
          <span class="pill pill-warning">Live</span>
          <span data-live-text></span>
        </p>
        <div class="stack-tight" data-release-state hidden>
          <p data-matches></p>
          <p class="caption" data-descriptions-hint hidden></p>
          <p class="caption" data-text-not-tracked></p>
        </div>
        <div class="stack-tight" data-publish-actions>
          <div class="row" data-publish-buttons hidden>
            <button type="button" class="btn btn-primary" data-publish hidden>
              Publish&hellip;
            </button>
            <button type="button" class="btn btn-secondary" data-announce hidden>
              Publish a new release&hellip;
            </button>
            <button type="button" class="btn btn-secondary" data-unpublish hidden>
              Unpublish&hellip;
            </button>
          </div>
          <p class="caption" data-owner-only hidden></p>
          <p class="status-text" role="status" data-publish-status hidden></p>
        </div>
        <!-- Private or public, and the switch (ADR 0290): an Owner's, and only where the deployment has public repositories or this one already is. -->
        <div class="stack-tight" data-visibility hidden>
          <h3 data-visibility-heading></h3>
          <p class="row">
            <span class="pill" data-visibility-state></span>
            <span data-visibility-explanation></span>
          </p>
          <div class="row">
            <button type="button" class="btn btn-secondary" data-visibility-button></button>
            <button
              type="button"
              class="btn btn-secondary"
              data-visibility-button-alt
              hidden
            ></button>
          </div>
          <p class="caption" data-visibility-note hidden></p>
          <!-- Whether Discover lists it (RFC 0051 H2, ADR 0432): an Owner's, for a public repository, saved at once. -->
          <div class="stack-tight" data-visibility-listed hidden>
            <label class="field-row">
              <input type="checkbox" data-visibility-listed-input />
              <span data-visibility-listed-label></span>
            </label>
            <p class="caption" data-visibility-listed-help></p>
            <p>
              <a class="shelf-link" data-visibility-listed-link></a>
            </p>
          </div>
          <p class="status-text" role="status" data-visibility-status hidden></p>
        </div>
        <!-- What is still missing before it can be public, each with a link to where to fix it (ADR 0385): an Owner's, beside the switch. -->
        <div class="stack-tight" data-readiness hidden>
          <h3 data-readiness-heading></h3>
          <ul class="stack-tight" data-readiness-list></ul>
          <p class="caption" data-readiness-note></p>
        </div>
        <!-- What people can look at before copying, and the entries featured (ADR 0293): an Owner's, for any repository. -->
        <div class="stack-tight" data-showcase hidden>
          <h3 data-showcase-heading></h3>
          <p class="caption" data-showcase-explanation></p>
          <fieldset data-showcase-choice></fieldset>
          <p class="status-text" role="status" data-showcase-choice-status hidden></p>
          <h4 data-featured-heading></h4>
          <p data-featured-none hidden></p>
          <ol class="list" data-featured-list></ol>
          <p class="caption" role="status" data-featured-count></p>
          <div class="field">
            <label class="field-label" for="featured-search" data-featured-search-label></label>
            <input
              id="featured-search"
              class="text-input"
              type="search"
              autocomplete="off"
              aria-describedby="featured-hint"
              data-featured-search
            />
            <span class="caption" id="featured-hint" data-featured-hint></span>
          </div>
          <ul class="list" data-featured-results></ul>
          <p data-featured-add-none hidden></p>
          <p class="caption" data-featured-release-note></p>
          <p class="status-text" role="status" data-featured-status hidden></p>
        </div>
        <!-- Retire it, or bring it back (ADR 0384): an Owner's, for any repository. -->
        <div class="stack-tight" data-retire hidden>
          <h3 data-retire-heading></h3>
          <p data-retire-explanation></p>
          <div class="stack-tight" data-retire-form-box>
            <label class="field">
              <span class="field-label" data-retire-label></span>
              <textarea class="text-input" rows="3" maxlength="500" data-retire-message></textarea>
              <span class="caption" data-retire-help></span>
              <span class="caption" role="status" data-retire-count></span>
            </label>
            <div class="row">
              <button type="button" class="btn btn-secondary" data-retire-button></button>
            </div>
          </div>
          <div class="stack-tight" data-retire-retired hidden>
            <p class="row">
              <span class="pill pill-warning" data-retire-pill></span>
              <span data-retire-state></span>
            </p>
            <p class="caption" data-retire-since></p>
            <p data-retire-saved hidden></p>
            <div class="row">
              <button type="button" class="btn btn-secondary" data-bring-back></button>
            </div>
            <p class="caption" data-bring-back-note></p>
          </div>
          <p class="status-text" role="status" data-retire-status hidden></p>
        </div>
        <div class="stack-tight" data-subscriber>
          <h3 data-subscriber-heading></h3>
          <p class="caption" data-subscriber-explanation></p>
          <p data-subscriber-line hidden></p>
          <div class="row" data-subscriber-buttons hidden>
            <button type="button" class="btn btn-secondary" data-view-as>
              View as a subscriber
            </button>
            <button type="button" class="btn btn-secondary" data-reset-test hidden>
              Reset the Test library
            </button>
            <button type="button" class="btn-danger" data-remove-test hidden>
              Remove the Test library
            </button>
          </div>
          <p class="caption" data-subscriber-unavailable hidden></p>
          <p class="status-text" role="status" data-subscriber-status hidden></p>
        </div>
      </section>
    </div>

    <div class="stack" role="tabpanel">
      <!-- What it says about itself, and its cover (ADR 0385): an Owner edits, every other member reads. -->
      <section class="stack" data-profile hidden>
        <h3 data-profile-heading></h3>
        <p class="caption" data-profile-intro></p>
        <p class="caption" data-profile-owner-only hidden></p>
        <p class="error-text" role="alert" data-profile-error hidden></p>

        <!-- The cover has its own buttons: it is not part of Save. -->
        <div class="card card-body stack" id="profile-cover" tabindex="-1" data-cover-card>
          <h4 data-cover-heading></h4>
          <img class="discover-cover" alt="The cover" data-cover-picture hidden />
          <div class="row" data-cover-none hidden>
            <span
              class="avatar-placeholder repository-initial"
              aria-hidden="true"
              data-cover-initial
            ></span>
            <div class="grow stack-tight">
              <strong data-cover-none-title></strong>
              <span class="caption" data-cover-none-text></span>
            </div>
          </div>
          <div class="stack-tight" data-cover-staged hidden>
            <canvas
              class="discover-cover"
              width="600"
              height="200"
              role="img"
              aria-label="The picture you chose"
              data-cover-staged-picture
            ></canvas>
            <p class="caption" role="status" data-cover-staged-text></p>
            <div class="row">
              <button type="button" class="btn btn-primary" data-cover-upload></button>
              <button type="button" class="btn btn-secondary" data-cover-cancel></button>
            </div>
          </div>
          <p class="caption" data-cover-help hidden></p>
          <div class="row" data-cover-buttons hidden>
            <button type="button" class="btn btn-secondary" data-cover-choose></button>
            <button type="button" class="btn btn-secondary" data-cover-remove hidden></button>
          </div>
          <input type="file" hidden aria-label="Choose a picture for the cover" data-cover-file />
          <p class="status-text" role="status" data-cover-status hidden></p>
        </div>

        <!-- Only an Owner has the form: the others read what it says below. -->
        <form class="stack" novalidate data-profile-form hidden>
          <div class="field">
            <label class="field-label" for="profile-summary" data-summary-label></label>
            <textarea
              id="profile-summary"
              class="text-input"
              rows="3"
              aria-describedby="profile-summary-help profile-summary-count"
              data-profile-summary
            ></textarea>
            <span class="caption" id="profile-summary-help" data-profile-summary-help></span>
            <span class="caption" id="profile-summary-count" data-profile-summary-count></span>
            <span class="error-text" role="alert" data-problem="summary" hidden></span>
          </div>

          <div class="field">
            <label class="field-label" for="profile-licence" data-licence-label></label>
            <select class="text-input" id="profile-licence" data-licence></select>
            <span class="caption" data-licence-help></span>
          </div>
          <div class="field" data-licence-other-field hidden>
            <label class="field-label" for="profile-licence-other" data-licence-other-label></label>
            <input
              id="profile-licence-other"
              class="text-input"
              type="text"
              autocomplete="off"
              data-licence-other
            />
            <span class="error-text" role="alert" data-problem="licence" hidden></span>
          </div>
          <div class="field" data-licence-link-field hidden>
            <label class="field-label" for="profile-licence-link" data-licence-link-label></label>
            <input
              id="profile-licence-link"
              class="text-input"
              type="url"
              inputmode="url"
              autocomplete="off"
              spellcheck="false"
              placeholder="https://"
              data-licence-link
            />
            <span class="caption" data-licence-link-help></span>
            <span class="error-text" role="alert" data-problem="licenceLink" hidden></span>
          </div>

          <fieldset id="profile-credits" tabindex="-1">
            <legend class="field-label" data-credits-label></legend>
            <p class="caption" data-credits-help></p>
            <div class="stack" data-credits-list></div>
            <p class="caption" role="status" data-credits-count></p>
            <span class="error-text" role="alert" data-problem="credits" hidden></span>
            <div class="row">
              <button type="button" class="btn btn-secondary" data-credit-add></button>
            </div>
          </fieldset>

          <div class="field">
            <label class="field-label" for="profile-tag" data-tags-label></label>
            <ul class="discover-tags" aria-label="Tags" data-tags-list></ul>
            <div class="row">
              <input
                id="profile-tag"
                class="text-input grow"
                type="text"
                autocomplete="off"
                list="profile-tag-options"
                aria-describedby="profile-tags-help profile-tags-count"
                data-tag-input
              />
              <button type="button" class="btn btn-secondary" data-tag-add>
                Add
              </button>
            </div>
            <datalist id="profile-tag-options" data-tag-options></datalist>
            <span class="caption" id="profile-tags-help" data-tags-help></span>
            <span class="caption" id="profile-tags-count" role="status" data-tags-count></span>
            <span class="error-text" role="alert" data-problem="tags" hidden></span>
          </div>

          <div class="field">
            <label class="field-label" for="profile-system" data-system-label></label>
            <input
              id="profile-system"
              class="text-input"
              type="text"
              autocomplete="off"
              list="profile-system-options"
              data-system
            />
            <datalist id="profile-system-options" data-system-options></datalist>
            <span class="caption" data-system-help></span>
            <span class="error-text" role="alert" data-problem="system" hidden></span>
          </div>

          <div class="field">
            <label class="field-label" for="profile-language" data-languages-label></label>
            <ul class="discover-tags" aria-label="Languages" data-languages-list></ul>
            <div class="row">
              <input
                id="profile-language"
                class="text-input grow"
                type="text"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
                list="profile-language-options"
                aria-describedby="profile-languages-help profile-languages-count"
                data-language-input
              />
              <button type="button" class="btn btn-secondary" data-language-add>
                Add
              </button>
            </div>
            <datalist id="profile-language-options" data-language-options></datalist>
            <span class="caption" id="profile-languages-help" data-languages-help></span>
            <span
              class="caption"
              id="profile-languages-count"
              role="status"
              data-languages-count
            ></span>
            <span class="error-text" role="alert" data-problem="languages" hidden></span>
          </div>

          <p class="error-text" role="alert" data-problem="form" hidden></p>
          <div class="row">
            <button type="submit" class="btn btn-primary" data-profile-save></button>
            <button type="button" class="btn btn-secondary" data-profile-revert></button>
            <span class="status-text" role="status" data-profile-status hidden></span>
          </div>
        </form>

        <!-- What people will see: Discover's own card, and what its page adds. -->
        <section class="stack" data-profile-preview>
          <h4 data-preview-heading></h4>
          <p class="caption" data-preview-intro></p>
          <ul class="list" data-preview-card></ul>
          <dl class="key-values" data-preview-facts></dl>
        </section>
      </section>

      <!-- What repositories built on this one may do with it (ADR 0431): an Owner decides, every member
           reads. Beside the profile and not in it: it is saved when it is changed, not with Save. -->
      <div class="card card-body stack" id="profile-terms" tabindex="-1" data-terms-card hidden>
        <h4 data-terms-heading></h4>
        <p class="caption" data-terms-intro></p>
        <fieldset class="stack-tight" data-terms-presets>
          <legend class="caption" data-terms-presets-legend></legend>
        </fieldset>
        <label class="field-row">
          <input type="checkbox" data-terms-include />
          <span data-terms-include-label></span>
        </label>
        <p class="caption" data-terms-include-help></p>
        <p class="caption" data-terms-line></p>
        <label class="field-row">
          <input type="checkbox" data-terms-shown />
          <span data-terms-shown-label></span>
        </label>
        <p class="caption" data-terms-shown-help></p>
        <p class="caption" data-terms-shown-line></p>
        <p class="caption" data-terms-owner-only hidden></p>
        <p class="status-text" role="status" data-terms-status hidden></p>
      </div>
    </div>

    <div class="stack" role="tabpanel">
      <section class="stack" data-people hidden>
        <h3>Who works on it</h3>
        <ul class="stack-tight" data-roles></ul>

        <!-- An Owner changes people: the membership panel. Everyone else reads the list. -->
        <div data-memberships-slot hidden></div>
        <!-- An Owner adds people by a link too. -->
        <div data-links-slot hidden></div>
        <ul class="list" data-people-list hidden></ul>

        <div data-leave hidden>
          <button type="button" class="btn-danger" data-leave-button>
            Leave this <span data-noun></span>
          </button>
          <span class="status-text" role="status" data-leave-status hidden></span>
        </div>

        <!-- An Owner deletes it; an Organizer is told why not (ADR 0267). -->
        <div data-delete-slot hidden></div>
      </section>
    </div>

    <div class="stack" role="tabpanel">
      <section class="stack" data-releases hidden>
        <h3>Releases</h3>
        <p class="caption" data-releases-note></p>
        <p class="error-text" role="alert" data-releases-error hidden></p>
        <p data-releases-none hidden></p>
        <ul class="stack" data-releases-list></ul>
      </section>
    </div>

    <div class="stack" role="tabpanel">
      <section class="stack" data-using hidden>
        <h3>Libraries using it</h3>
        <p data-using-summary></p>
        <p data-using-public hidden></p>
        <p class="error-text" role="alert" data-using-error hidden></p>
        <ul class="list" data-using-list></ul>

        <!-- An Owner invites a library by its id; an Organizer reads the list. -->
        <form class="card card-body stack" data-invite hidden>
          <h4>Invite a library</h4>
          <p class="caption" data-invite-help></p>
          <div class="row">
            <label class="field grow">
              <span class="field-label">Library id</span>
              <input
                type="text"
                class="text-input"
                autocomplete="off"
                spellcheck="false"
                data-invite-id
              />
            </label>
            <button type="submit" class="btn btn-primary" data-invite-submit>
              Invite
            </button>
          </div>
          <p class="status-text" role="status" data-invite-status hidden></p>
        </form>

        <!-- Or sends a link, by which the Owner of a library shares it back (ADR 0212). -->
        <div data-library-links-slot hidden></div>
      </section>
    </div>

    <div class="stack" role="tabpanel">
      <section class="stack" data-built-on hidden>
        <h3>Built on</h3>
        <p class="error-text" role="alert" data-built-on-error hidden></p>
        <p data-built-on-none hidden></p>
        <ul class="list" data-built-on-list></ul>
        <p class="caption" data-built-on-add></p>
        <p>
          <a class="shelf-link" href="/repositories/" data-offered-link>
            Repositories offered to this one
          </a>
        </p>
      </section>
    </div>

    <div class="stack" role="tabpanel">
      <div data-activity-slot hidden></div>
    </div>
  </div>

  <!-- What a publish will do, said before it does it (ADR 0206). -->
  <dialog aria-labelledby="publish-dialog-title" data-publish-dialog>
    <form method="dialog" class="stack" data-publish-form>
      <h3 id="publish-dialog-title" data-dialog-title></h3>
      <div class="stack-tight" data-dialog-warnings hidden>
        <strong>Check before you go on</strong>
        <ul class="stack-tight" data-dialog-warning-list></ul>
      </div>
      <ul class="stack-tight" data-dialog-lines></ul>

      <!-- What a release is called and says, and what it will contain (ADR 0209). -->
      <ReleaseComposer />
      <p class="error-text" role="alert" data-dialog-error hidden></p>
      <div class="row">
        <button type="button" class="btn btn-secondary" data-dialog-cancel autofocus>
          Cancel
        </button>
        <button type="submit" class="btn btn-primary" data-dialog-confirm></button>
      </div>
    </form>
  </dialog>

  <!-- What making it public, protected or private will do, said before it does it (ADR 0290, ADR 0433). -->
  <dialog aria-labelledby="visibility-dialog-title" data-visibility-dialog>
    <form method="dialog" class="stack" data-visibility-form>
      <h3 id="visibility-dialog-title" data-vis-title></h3>
      <div class="stack-tight" data-vis-blockers hidden>
        <strong data-vis-blockers-title></strong>
        <ul class="stack-tight" data-vis-blocker-list></ul>
      </div>
      <div class="stack-tight" data-vis-warnings hidden>
        <strong>Check before you go on</strong>
        <ul class="stack-tight" data-vis-warning-list></ul>
      </div>
      <ul class="stack-tight" data-vis-lines></ul>

      <!-- Making it public: how it carries each repository it is built on (ADR 0431). -->
      <div class="stack" data-vis-built-on hidden>
        <strong data-vis-built-on-title></strong>
        <ul class="stack" data-vis-built-on-list></ul>
      </div>

      <!-- Making it public: what it says of itself and what people may look at. -->
      <div class="stack" data-vis-public hidden>
        <label class="field">
          <span class="field-label">Summary</span>
          <textarea class="text-input" rows="3" data-vis-summary></textarea>
          <span class="caption" data-vis-summary-help></span>
          <span class="caption" data-vis-summary-count></span>
        </label>
        <fieldset data-vis-preview>
          <legend data-vis-preview-legend></legend>
        </fieldset>
      </div>

      <!-- Making it public or protected (a private repository): the release. -->
      <ReleaseComposer />

      <!-- Making it public: the terms line an Owner agrees to (RFC 0038 section 6, ADR 0299). -->
      <div class="stack" data-vis-public-terms hidden>
        <!-- The terms line an Owner agrees to (RFC 0038 section 6, ADR 0299). -->
        <label class="field-row" data-vis-terms-row>
          <input type="checkbox" data-vis-terms />
          <span data-vis-terms-text></span>
        </label>
      </div>

      <!-- Making it private: only asked when libraries lose its updates. -->
      <label class="field-row" data-vis-ack-row hidden>
        <input type="checkbox" data-vis-ack />
        <span data-vis-ack-text></span>
      </label>
      <p class="error-text" role="alert" data-vis-error hidden></p>
      <div class="row">
        <button type="button" class="btn btn-secondary" data-vis-cancel>
          Cancel
        </button>
        <button type="submit" class="btn btn-primary" data-vis-confirm></button>
      </div>
    </form>
  </dialog>

  <!-- What retiring it will do, said before it does it (ADR 0384). -->
  <dialog aria-labelledby="retire-dialog-title" data-retire-dialog>
    <form method="dialog" class="stack" data-retire-form>
      <h3 id="retire-dialog-title" data-retire-title></h3>
      <ul class="stack-tight" data-retire-lines></ul>
      <p data-retire-dialog-message hidden></p>
      <p class="error-text" role="alert" data-retire-error hidden></p>
      <div class="row">
        <button type="button" class="btn btn-secondary" data-retire-cancel autofocus>
          Cancel
        </button>
        <button type="submit" class="btn btn-primary" data-retire-confirm></button>
      </div>
    </form>
  </dialog>

  <!-- A tag or a language chosen: a button, so that it is as big to press as any (identity.md 8.5). -->
  <template data-chip-template>
    <li>
      <button type="button" class="chip profile-chip" data-chip>
        <span data-text></span>
        <span aria-hidden="true">&times;</span>
      </button>
    </li>
  </template>
  <template data-credit-template>
    <div class="card card-body stack" data-credit>
      <label class="field">
        <span class="field-label" data-name-label></span>
        <input type="text" class="text-input" autocomplete="off" data-credit-name />
        <span class="error-text" role="alert" data-problem hidden></span>
      </label>
      <label class="field">
        <span class="field-label" data-role-label></span>
        <input type="text" class="text-input" autocomplete="off" data-credit-role />
        <span class="error-text" role="alert" data-problem hidden></span>
      </label>
      <label class="field">
        <span class="field-label" data-url-label></span>
        <input
          type="url"
          class="text-input"
          inputmode="url"
          autocomplete="off"
          spellcheck="false"
          placeholder="https://"
          data-credit-url
        />
        <span class="error-text" role="alert" data-problem hidden></span>
      </label>
      <div class="row">
        <button type="button" class="btn btn-secondary" data-credit-up>
          Move up
        </button>
        <button type="button" class="btn btn-secondary" data-credit-down>
          Move down
        </button>
        <button type="button" class="btn btn-secondary" data-credit-remove>
          Remove
        </button>
      </div>
    </div>
  </template>
  <DiscoverCard />

  <template data-tenant-delete-template>
    <TenantDelete />
  </template>

  <template data-release-template>
    <li class="card card-body stack">
      <header class="row">
        <strong class="grow" data-label></strong>
        <span class="pill pill-warning" data-breaking hidden>
          Breaking
        </span>
      </header>
      <p class="campaign-meta" data-meta></p>
      <p data-notes hidden></p>
      <ul class="stack-tight" data-counts></ul>
      <details class="stack shelf-section" data-warns hidden>
        <summary>
          <svg class="icon tree-toggle" aria-hidden="true">
            <use href={`${BRANDING_CSS_URL}/icons.svg#icon-expand`}></use>
          </svg>
          <span data-warns-heading></span>
        </summary>
        <ul class="stack-tight" data-warns-list></ul>
      </details>
      <details class="stack shelf-section" data-breaks hidden>
        <summary>
          <svg class="icon tree-toggle" aria-hidden="true">
            <use href={`${BRANDING_CSS_URL}/icons.svg#icon-expand`}></use>
          </svg>
          <span data-breaks-title></span>
        </summary>
        <ul class="stack-tight" data-breaks-list></ul>
      </details>
      <div class="row" data-release-actions hidden>
        <button type="button" class="btn btn-secondary" data-edit-release>
          Edit label and notes
        </button>
      </div>
      <form class="stack" data-release-form hidden>
        <label class="field">
          <span class="field-label">Label</span>
          <input type="text" class="text-input" maxlength="80" required data-edit-label />
        </label>
        <label class="field">
          <span class="field-label">Notes</span>
          <textarea class="text-input" rows="4" data-edit-notes></textarea>
        </label>
        <div class="row">
          <button type="submit" class="btn btn-primary">
            Save
          </button>
          <button type="button" class="btn btn-secondary" data-edit-cancel>
            Cancel
          </button>
        </div>
        <p class="status-text" role="status" data-edit-status hidden></p>
      </form>
    </li>
  </template>
  <template data-featured-template>
    <li class="row">
      <span class="grow" data-name></span>
      <button type="button" class="btn btn-secondary" data-up>
        Up
      </button>
      <button type="button" class="btn btn-secondary" data-down>
        Down
      </button>
      <button type="button" class="btn btn-secondary" data-remove>
        Remove
      </button>
    </li>
  </template>
  <template data-candidate-template>
    <li class="row">
      <span class="grow" data-name></span>
      <button type="button" class="btn btn-secondary" data-add>
        Add
      </button>
    </li>
  </template>
  <template data-using-template>
    <li class="row">
      <div class="grow stack-tight">
        <strong data-name></strong>
        <span class="campaign-meta" data-line></span>
      </div>
      <span data-state></span>
      <button type="button" class="btn btn-secondary" data-stop hidden>
        Stop inviting
      </button>
      <span class="status-text" role="status" data-status hidden></span>
    </li>
  </template>
  <template data-built-on-template>
    <li class="row">
      <div class="grow stack-tight" data-built-on-body>
        <a class="shelf-link" href="/repositories/" data-name></a>
        <span class="campaign-meta" data-line></span>
        <span class="campaign-meta" data-updates></span>
      </div>
      <span data-state></span>
      <a class="btn btn-secondary" href="/repositories/" data-review hidden>
        Review updates
      </a>
    </li>
  </template>
  <template data-activity-log-template>
    <ActivityLog />
  </template>
  <template data-picture-upload-template>
    <PictureUpload />
  </template>
  <template data-membership-admin-template>
    <MembershipAdmin />
  </template>
  <template data-tenant-invite-links-template>
    <TenantInviteLinks />
  </template>
  <template data-person-template>
    <li class="row">
      <span class="grow" data-name></span>
      <span class="badge" data-person-role></span>
    </li>
  </template>
</article>
