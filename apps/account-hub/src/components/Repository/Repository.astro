---
// One repository in Studio (ADR 0202): its name, picture and description with the Edit button,
// and its tabs: Overview, People, Libraries using it, Built on and Activity. Rendered by renderRepository. The parts that are the same as a
// library's (the picture, the form that edits the name, the people) are components, kept here as
// <template>s or in place, and bound by their own renderers.
import { BRANDING_CSS_URL } from '../../lib/config';
import ActivityLog from '../ActivityLog/ActivityLog.astro';
import MembershipAdmin from '../MembershipAdmin/MembershipAdmin.astro';
import PictureUpload from '../PictureUpload/PictureUpload.astro';
import TenantEdit from '../TenantEdit/TenantEdit.astro';
---

<article class="stack card card-body" data-repository data-tenant hidden>
  <header class="stack">
    <div class="row">
      <div class="row grow">
        <h2 data-name></h2>
        <code data-slug></code>
      </div>
      <span class="badge" data-role></span>
    </div>
    <div class="row sticky-top">
      <div class="stack grow" data-tenant-edit>
        <div class="ls-content" data-tenant-description hidden></div>
        <div class="row">
          <button type="button" data-edit hidden>
            Edit <span data-noun></span>
          </button>
        </div>
        <span class="status-text" role="status" data-edit-status hidden></span>
      </div>
      <div data-picture-slot hidden></div>
    </div>
    <TenantEdit />
  </header>

  <p data-loading hidden>
    Loading&hellip;
  </p>
  <p class="error-text" role="alert" data-error hidden></p>

  <div class="stack" data-tabs>
    <div class="tabs" role="tablist" aria-label="This repository">
      <button type="button" class="tab" role="tab">
        Overview
      </button>
      <button type="button" class="tab" role="tab">
        People
      </button>
      <button type="button" class="tab" role="tab">
        Releases
      </button>
      <button type="button" class="tab" role="tab">
        Libraries using it
      </button>
      <button type="button" class="tab" role="tab">
        Built on
      </button>
      <button type="button" class="tab" role="tab">
        Activity
      </button>
    </div>

    <div class="stack" role="tabpanel">
      <section class="stack" data-overview hidden>
        <h3>State</h3>
        <p class="row">
          <span data-state></span>
          <span data-state-explanation></span>
        </p>
        <p class="row" data-live hidden>
          <span class="pill pill-warning">Live</span>
          <span data-live-text></span>
        </p>
        <div class="stack-tight" data-release-state hidden>
          <p data-matches></p>
          <p class="caption" data-descriptions-hint hidden></p>
          <p class="caption" data-text-not-tracked></p>
        </div>
        <div class="stack-tight" data-publish-actions>
          <div class="row" data-publish-buttons hidden>
            <button type="button" class="btn btn-primary" data-publish hidden>
              Publish&hellip;
            </button>
            <button type="button" class="btn btn-secondary" data-announce hidden>
              Publish a new release&hellip;
            </button>
            <button type="button" class="btn btn-secondary" data-unpublish hidden>
              Unpublish&hellip;
            </button>
          </div>
          <p class="caption" data-owner-only hidden></p>
          <p class="status-text" role="status" data-publish-status hidden></p>
        </div>
      </section>
    </div>

    <div class="stack" role="tabpanel">
      <section class="stack" data-people hidden>
        <h3>Who works on it</h3>
        <ul class="stack-tight" data-roles></ul>
        <p class="caption" data-roles-note></p>

        <!-- An Owner changes people: the membership panel. Everyone else reads the list. -->
        <div data-memberships-slot hidden></div>
        <ul class="list" data-people-list hidden></ul>

        <div data-leave hidden>
          <button type="button" class="btn-danger" data-leave-button>
            Leave this <span data-noun></span>
          </button>
          <span class="status-text" role="status" data-leave-status hidden></span>
        </div>
      </section>
    </div>

    <div class="stack" role="tabpanel">
      <section class="stack" data-releases hidden>
        <h3>Releases</h3>
        <p class="caption" data-releases-note></p>
        <p class="error-text" role="alert" data-releases-error hidden></p>
        <p data-releases-none hidden></p>
        <ul class="stack" data-releases-list></ul>
      </section>
    </div>

    <div class="stack" role="tabpanel">
      <section class="stack" data-using hidden>
        <h3>Libraries using it</h3>
        <p data-using-summary></p>
        <p class="error-text" role="alert" data-using-error hidden></p>
        <ul class="list" data-using-list></ul>

        <!-- An Owner invites a library by its id; an Organizer reads the list. -->
        <form class="card card-body stack" data-invite hidden>
          <h4>Invite a library</h4>
          <p class="caption" data-invite-help></p>
          <div class="row">
            <label class="field grow">
              <span class="field-label">Library id</span>
              <input
                type="text"
                class="text-input"
                autocomplete="off"
                spellcheck="false"
                data-invite-id
              />
            </label>
            <button type="submit" class="btn btn-primary" data-invite-submit>
              Invite
            </button>
          </div>
          <p class="status-text" role="status" data-invite-status hidden></p>
        </form>
      </section>
    </div>

    <div class="stack" role="tabpanel">
      <section class="stack" data-built-on hidden>
        <h3>Built on</h3>
        <p class="error-text" role="alert" data-built-on-error hidden></p>
        <p data-built-on-none hidden></p>
        <ul class="list" data-built-on-list></ul>
        <p class="caption" data-built-on-add></p>
        <p>
          <a class="shelf-link" href="/repositories/" data-offered-link>
            Repositories offered to this one
          </a>
        </p>
      </section>
    </div>

    <div class="stack" role="tabpanel">
      <div data-activity-slot hidden></div>
    </div>
  </div>

  <!-- What a publish will do, said before it does it (ADR 0206). -->
  <dialog aria-labelledby="publish-dialog-title" data-publish-dialog>
    <form method="dialog" class="stack" data-publish-form>
      <h3 id="publish-dialog-title" data-dialog-title></h3>
      <div class="stack-tight" data-dialog-warnings hidden>
        <strong>Check before you go on</strong>
        <ul class="stack-tight" data-dialog-warning-list></ul>
      </div>
      <ul class="stack-tight" data-dialog-lines></ul>

      <!-- What a release is called and says, and what it will contain (ADR 0209). -->
      <div class="stack" data-composer hidden>
        <label class="field">
          <span class="field-label">Label</span>
          <input
            type="text"
            class="text-input"
            maxlength="80"
            autocomplete="off"
            data-composer-label
          />
          <span class="caption" data-label-help></span>
        </label>
        <label class="field">
          <span class="field-label">Notes</span>
          <textarea class="text-input" rows="4" data-composer-notes></textarea>
        </label>
        <label class="field-row">
          <input type="checkbox" data-composer-breaking />
          This release is breaking: libraries should read its notes before they update
        </label>
        <section class="stack-tight" data-changes>
          <strong>What this release contains</strong>
          <p data-matches-line></p>
          <ul class="stack-tight" data-content-lines></ul>
          <p class="caption" data-hint hidden></p>
          <p class="caption" data-not-tracked></p>
        </section>
        <div class="stack-tight" data-breaks-box hidden>
          <strong>This release breaks things</strong>
          <ul class="stack-tight" data-breaks-lines></ul>
          <label class="field-row">
            <input type="checkbox" data-composer-ack />
            <span data-ack-text></span>
          </label>
        </div>
      </div>
      <p class="error-text" role="alert" data-dialog-error hidden></p>
      <div class="row">
        <button type="button" class="btn btn-secondary" data-dialog-cancel autofocus>
          Cancel
        </button>
        <button type="submit" class="btn btn-primary" data-dialog-confirm></button>
      </div>
    </form>
  </dialog>

  <template data-release-template>
    <li class="card card-body stack">
      <header class="row">
        <strong class="grow" data-label></strong>
        <span class="pill pill-warning" data-breaking hidden>
          Breaking
        </span>
      </header>
      <p class="campaign-meta" data-meta></p>
      <p data-notes hidden></p>
      <ul class="stack-tight" data-counts></ul>
      <details class="stack shelf-section" data-breaks hidden>
        <summary>
          <svg class="icon tree-toggle" aria-hidden="true">
            <use href={`${BRANDING_CSS_URL}/icons.svg#icon-expand`}></use>
          </svg>
          <span data-breaks-title></span>
        </summary>
        <ul class="stack-tight" data-breaks-list></ul>
      </details>
      <div class="row" data-release-actions hidden>
        <button type="button" class="btn btn-secondary" data-edit-release>
          Edit label and notes
        </button>
      </div>
      <form class="stack" data-release-form hidden>
        <label class="field">
          <span class="field-label">Label</span>
          <input type="text" class="text-input" maxlength="80" required data-edit-label />
        </label>
        <label class="field">
          <span class="field-label">Notes</span>
          <textarea class="text-input" rows="4" data-edit-notes></textarea>
        </label>
        <div class="row">
          <button type="submit" class="btn btn-primary">
            Save
          </button>
          <button type="button" class="btn btn-secondary" data-edit-cancel>
            Cancel
          </button>
        </div>
        <p class="status-text" role="status" data-edit-status hidden></p>
      </form>
    </li>
  </template>
  <template data-using-template>
    <li class="row">
      <div class="grow stack-tight">
        <strong data-name></strong>
        <span class="campaign-meta" data-line></span>
      </div>
      <span data-state></span>
      <button type="button" class="btn btn-secondary" data-stop hidden>
        Stop inviting
      </button>
      <span class="status-text" role="status" data-status hidden></span>
    </li>
  </template>
  <template data-built-on-template>
    <li class="row">
      <div class="grow stack-tight">
        <a class="shelf-link" href="/repositories/" data-name></a>
        <span class="campaign-meta" data-line></span>
        <span class="campaign-meta" data-updates></span>
      </div>
      <span data-state></span>
      <a class="btn btn-secondary" href="/repositories/" data-review hidden>
        Review updates
      </a>
    </li>
  </template>
  <template data-activity-log-template>
    <ActivityLog />
  </template>
  <template data-picture-upload-template>
    <PictureUpload />
  </template>
  <template data-membership-admin-template>
    <MembershipAdmin />
  </template>
  <template data-person-template>
    <li class="row">
      <span class="grow" data-name></span>
      <span class="badge" data-person-role></span>
    </li>
  </template>
</article>
