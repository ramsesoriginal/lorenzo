---
// What someone who belongs nowhere yet is offered (ADR 0416, D27): two doors, "I run a game" (set up a
// library) and "I'm joining a game" (paste an invite link), with the mascot beside them. Rendered by
// renderNewUser.
import { BRANDING_CSS_URL } from '../../lib/config';
---

<div class="first-run" data-new-user hidden>
  <!-- The mascot: the illustrators' image when it is there, the earlier one until then, and a quiet
       placeholder with the words if neither loads. Lazy, so someone with a library already (this
       block stays hidden) never downloads it. -->
  <div class="page-state-art" data-art>
    <img
      alt="Lorenzo holding out a welcoming hand, an open atlas in the other"
      loading="lazy"
      width="300"
      height="300"
      data-art-image
      data-art-src={`${BRANDING_CSS_URL}/mascots/ui_first-run-welcome.png`}
      data-art-fallback="/brand/mascot_getting_started_web.png"
    />
  </div>

  <div class="stack">
    <h1 class="display">Welcome to Lorenzo</h1>
    <p class="lede">
      Lorenzo keeps track of the worlds your games and stories happen in: where things are, who
      knows what, and the notes that belong to each. How would you like to start?
    </p>

    <div class="doors">
      <section class="card card-body stack-tight" aria-labelledby="door-run" data-start-card hidden>
        <h2 id="door-run">I run a game</h2>
        <p>
          Set up a library for your group, a campaign and a link for your players. One short form.
        </p>
        <div>
          <a class="btn btn-primary" href="/setup/">
            Set up a library
          </a>
        </div>
      </section>

      <section class="card card-body stack-tight" aria-labelledby="door-join">
        <h2 id="door-join">I’m joining a game</h2>
        <p data-cannot-create>
          Someone sent you an invite link. Open it, or paste it here. A GM can send you one.
        </p>
        <p data-can-create hidden>
          Someone sent you an invite link. Open it, or paste it here.
        </p>
        <form class="stack-tight" data-invite-form>
          <div class="row">
            <label class="visually-hidden" for="first-run-link">
              Invite link or code
            </label>
            <input
              id="first-run-link"
              type="text"
              class="text-input grow"
              placeholder="Paste the invite link"
              autocomplete="off"
              spellcheck="false"
              data-invite-input
            />
            <button type="submit" class="btn btn-secondary">
              Join
            </button>
          </div>
          <p class="status-text error-text" role="alert" data-invite-error hidden></p>
        </form>
      </section>
    </div>

    <!-- Only where public repositories are on. -->
    <p data-browse hidden>
      Just looking around? <a href="/discover/">Browse public repositories</a>
    </p>
  </div>
</div>
