---
// Tenant-wide owner/orga role administration (RFC 0017 e): who the admins are, and how to invite
// more, one at a time or in bulk. Rendered by renderMembershipAdmin.
import UserPicker from '../UserPicker/UserPicker.astro';
---

<div class="stack" data-membership-admin>
  <section class="hub-card stack-tight">
    <h3 class="hub-heading" data-heading></h3>
    <ul class="stack-tight hub-roles" data-roles></ul>
  </section>

  <div class="hub-table hub-people">
    <div class="hub-head" aria-hidden="true">
      <span>Name</span>
      <span>Role</span>
      <span>Added by</span>
      <span></span>
    </div>
    <ul class="list hub-rows" data-members></ul>
  </div>

  <div class="hub-card hub-add" data-invite>
    <label class="field">
      <span class="field-label" data-invite-label></span>
      <select class="text-input" aria-label="Role" data-invite-role>
        <option value="owner">Owner</option>
        <option value="orga">Organizer</option>
        <option value="author" selected>
          Author
        </option>
      </select>
    </label>
    <span class="caption grow" data-role-meaning></span>
    <span class="status-text" role="status" data-status hidden></span>
    <UserPicker />
  </div>

  <div class="hub-card stack" data-bulk-invite>
    <h3 class="hub-heading">Bulk invite</h3>
    <div class="list" data-bulk-rows></div>
    <div class="row">
      <button type="button" class="btn btn-secondary" data-add-row>
        Add another
      </button>
      <button type="button" class="btn btn-primary" data-send>
        Send invites
      </button>
      <span class="status-text" role="status" data-status hidden></span>
    </div>
    <ul class="list" data-results></ul>
  </div>

  <template data-member-template>
    <li class="hub-member">
      <span class="hub-name" data-name></span>
      <span class="row-tight">
        <select class="text-input" aria-label="Role" data-role>
          <option value="owner">Owner</option>
          <option value="orga">Organizer</option>
          <option value="author">Author</option>
        </select>
      </span>
      <span class="hub-cell" data-added-by></span>
      <span class="row-tight hub-end">
        <span class="status-text" role="status" data-status hidden></span>
        <button type="button" class="btn btn-text" data-remove>
          Remove
        </button>
      </span>
    </li>
  </template>

  <template data-bulk-row-template>
    <div class="stack" data-bulk-row>
      <div class="row">
        <select class="text-input" aria-label="Role" data-role>
          <option value="owner">Owner</option>
          <option value="orga">Organizer</option>
          <option value="author" selected>
            Author
          </option>
        </select>
      </div>
      <span class="status-text" role="status" data-status hidden></span>
      <UserPicker />
    </div>
  </template>

  <template data-result-template>
    <li></li>
  </template>
</div>
