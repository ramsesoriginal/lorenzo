---
// Tenant-wide owner/orga role administration (RFC 0017 e): who the admins are, and how to invite
// more, one at a time or in bulk. Rendered by renderMembershipAdmin.
import UserPicker from '../UserPicker/UserPicker.astro';
---

<div class="stack" data-membership-admin>
  <h3 data-heading></h3>

  <ul class="list" data-members></ul>

  <div class="row card card-body" data-invite>
    <label class="field">
      <span class="field-label"data-invite-label></span>
      <select class="text-input" aria-label="Role" data-invite-role>
        <option value="owner">owner</option>
        <option value="orga" selected>orga</option>
      </select>
    </label>
    <span class="status-text" role="status" data-status hidden></span>
    <UserPicker />
  </div>

  <div class="stack card card-body" data-bulk-invite>
    <strong>Bulk invite:</strong>
    <div class="list" data-bulk-rows></div>
    <div class="row">
      <button type="button" data-add-row>Add another</button>
      <button type="button" data-send>Send invites</button>
      <span class="status-text" role="status" data-status hidden></span>
    </div>
    <ul class="list" data-results></ul>
  </div>

  <template data-member-template>
    <li class="row">
      <span class="grow" data-name></span>
      <span class="row-tight">
        <select class="text-input" aria-label="Role" data-role>
          <option value="owner">owner</option>
          <option value="orga">orga</option>
        </select>
      </span>
      <button type="button" data-remove>Remove</button>
      <span class="status-text" role="status" data-status hidden></span>
    </li>
  </template>

  <template data-bulk-row-template>
    <div class="stack" data-bulk-row>
      <div class="row">
        <select class="text-input" aria-label="Role" data-role>
          <option value="owner">owner</option>
          <option value="orga" selected>orga</option>
        </select>
      </div>
      <span class="status-text" role="status" data-status hidden></span>
      <UserPicker />
    </div>
  </template>

  <template data-result-template>
    <li></li>
  </template>
</div>
