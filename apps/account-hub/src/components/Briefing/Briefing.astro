---
// The home page of someone who belongs somewhere (ADR 0417, AH1, AH6): in two columns, what needs
// them and where they play on the left and what they run on the right, then where they were last and
// what they might want to do. Rendered by renderBriefing; every part stays hidden until it has
// something to say.
import { BRANDING_CSS_URL } from '../../lib/config';
---

<div class="stack" data-briefing hidden>
  <div class="page-heading">
    <h1 data-greeting>Welcome back</h1>
  </div>

  <div class="home-columns">
    <div class="stack">
      <section class="home-block" aria-labelledby="home-needs" data-needs hidden>
        <h2 id="home-needs">Needs you</h2>
        <ul class="list" data-needs-list></ul>
        <div data-needs-empty hidden></div>
        <p class="error-text" role="alert" data-error hidden></p>
      </section>

      <section class="home-block" aria-labelledby="home-play" data-play hidden>
        <h2 id="home-play" class="row-tight">
          <svg class="icon" aria-hidden="true">
            <use href={`${BRANDING_CSS_URL}/icons.svg#icon-campaign`}></use>
          </svg>
          Where you play
        </h2>
        <div class="stack-tight" data-play-list></div>
        <p class="error-text" role="alert" data-error hidden></p>
      </section>

      <section class="home-block" aria-labelledby="briefing-changes" data-changes hidden>
        <h2 id="briefing-changes">Recent changes</h2>
        <p class="caption">To what your characters hold.</p>
        <ul class="list" data-changes-list></ul>
        <p class="error-text" role="alert" data-error hidden></p>
      </section>
    </div>

    <div class="stack">
      <section class="home-block" aria-labelledby="home-run" data-run hidden>
        <div class="row">
          <h2 id="home-run" class="grow">
            What you run
          </h2>
          <a href="/tenants/">Libraries</a>
        </div>
        <div class="stack-tight" data-run-list></div>
        <p class="error-text" role="alert" data-error hidden></p>
      </section>

      <section class="home-block" aria-labelledby="briefing-repositories" data-repositories hidden>
        <div class="row">
          <h2 id="briefing-repositories" class="grow">
            Your repositories
          </h2>
          <a href="/repositories/">Manage repositories</a>
        </div>
        <div class="stack-tight" data-repositories-list></div>
        <p class="error-text" role="alert" data-error hidden></p>
      </section>
    </div>
  </div>

  <div class="home-grid">
    <section class="home-block" aria-labelledby="home-continue" data-continue hidden>
      <h2 id="home-continue">Continue</h2>
      <ul class="list" data-continue-list></ul>
    </section>

    <section class="home-block" aria-labelledby="home-actions">
      <h2 id="home-actions">What do you want to do?</h2>
      <ul class="list home-actions">
        <li data-setup hidden>
          <a href="/setup/">Set up a library</a>
        </li>
        <li>
          <a href="/join/">Join with an invite link</a>
        </li>
        <li>
          <a href="/device/">Connect a device</a>
        </li>
        <li>
          <a href="/profile/">Change how others see you</a>
        </li>
        <li>
          <a href="/tokens/">Look after your access tokens</a>
        </li>
      </ul>
    </section>
  </div>

  <template data-task-template>
    <li class="row">
      <span class="grow" data-text></span>
      <a class="btn btn-secondary" data-action></a>
    </li>
  </template>

  <template data-table-template>
    <article class="card card-body stack-tight">
      <div class="row">
        <h3 class="grow" data-name></h3>
        <span class="row-tight" data-roles></span>
      </div>
      <p class="caption">
        <a data-library></a>
        <span data-system></span>
      </p>
      <p data-characters hidden></p>
      <span class="badge-visibility" data-secret hidden>
        <svg class="icon" aria-hidden="true">
          <use href={`${BRANDING_CSS_URL}/icons.svg#icon-private`}></use>
        </svg>
        Secret
      </span>
    </article>
  </template>

  <template data-role-template>
    <span class="badge"></span>
  </template>

  <template data-repository-template>
    <article class="card card-body stack-tight">
      <div class="row">
        <h3 class="grow">
          <a data-link data-name></a>
        </h3>
        <span class="badge" data-role></span>
      </div>
      <p class="caption" data-status></p>
    </article>
  </template>

  <template data-change-template>
    <li>
      <span class="grow" data-text></span>
      <span class="caption" data-where></span>
    </li>
  </template>

  <template data-recent-template>
    <li>
      <a data-link></a>
    </li>
  </template>
</div>
