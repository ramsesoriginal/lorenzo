---
// The home page of someone who belongs somewhere (ADR 0417, AH1, AH6, screen 01): "Needs you" and
// "Where you play" on the left, "What you run" on the right, then the blocks every Home shares,
// "Continue" and "What do you want to do?". Rendered by renderBriefing; every part stays hidden
// until it has something to say.
import { BRANDING_CSS_URL } from '../../lib/config';

const icons = `${BRANDING_CSS_URL}/icons.svg`;
---

<div class="stack" data-briefing hidden>
  <div class="page-heading">
    <h1>Home</h1>
    <p class="page-sub" data-subtitle></p>
  </div>

  <div class="home-columns">
    <div class="stack">
      <section class="home-card home-needs" aria-labelledby="home-needs" data-needs hidden>
        <div class="home-card-head">
          <h2 id="home-needs">Needs you</h2>
        </div>
        <ul class="home-rows" data-needs-list></ul>
        <div data-needs-empty hidden></div>
        <p class="error-text" role="alert" data-error hidden></p>
      </section>

      <section class="home-section" aria-labelledby="home-play" data-play hidden>
        <div class="home-head">
          <h2 id="home-play">Where you play</h2>
          <a href="/join/">Join with an invite link</a>
        </div>
        <div class="home-card">
          <ul class="home-rows" data-play-list></ul>
        </div>
        <p class="error-text" role="alert" data-error hidden></p>
      </section>

      <section class="home-section" aria-labelledby="briefing-changes" data-changes hidden>
        <h2 id="briefing-changes">Recent changes</h2>
        <p class="caption">To what your characters hold.</p>
        <div class="home-card">
          <ul class="home-rows" data-changes-list></ul>
        </div>
        <p class="error-text" role="alert" data-error hidden></p>
      </section>
    </div>

    <div class="stack">
      <section class="home-section" aria-labelledby="home-run" data-run hidden>
        <h2 id="home-run">What you run</h2>
        <div class="home-card">
          <ul class="home-rows" data-run-list></ul>
        </div>
        <div class="home-actions" data-run-actions>
          <a class="btn btn-secondary" href="/setup/" data-setup hidden>
            <svg class="icon" aria-hidden="true">
              <use href={`${icons}#icon-add`}></use>
            </svg>
            Set up a library
          </a>
          <a class="btn btn-secondary" href="/studio/?new=repository" data-new-repository hidden>
            <svg class="icon" aria-hidden="true">
              <use href={`${icons}#icon-add`}></use>
            </svg>
            Create a repository
          </a>
        </div>
        <p class="error-text" role="alert" data-error hidden></p>
      </section>
    </div>
  </div>

  <section class="home-section home-label" aria-labelledby="home-continue" data-continue hidden>
    <h2 id="home-continue">Continue</h2>
    <ul class="home-tiles" data-continue-list></ul>
  </section>

  <section class="home-section home-label" aria-labelledby="home-actions" data-apps hidden>
    <h2 id="home-actions">What do you want to do?</h2>
    <ul class="home-tiles home-tiles--apps" data-apps-list></ul>
  </section>

  <template data-task-template>
    <li class="home-row">
      <svg class="icon" aria-hidden="true">
        <use data-icon></use>
      </svg>
      <div class="home-row-text">
        <b data-text></b>
        <span class="caption" data-meta></span>
      </div>
      <a class="btn btn-secondary" data-action></a>
    </li>
  </template>

  <template data-play-template>
    <li class="home-row">
      <a class="home-row-text home-row-link" data-link>
        <b data-name></b>
        <span class="caption" data-meta></span>
      </a>
      <button type="button" class="btn btn-secondary" data-leave>
        Leave
      </button>
    </li>
  </template>

  <template data-run-template>
    <li class="home-row">
      <a class="home-row-text home-row-link" data-link>
        <b data-name></b>
        <span class="caption" data-meta></span>
      </a>
      <span class="state-chip" data-chip hidden>
        <svg class="icon" aria-hidden="true">
          <use data-chip-icon></use>
        </svg>
        <span data-chip-text></span>
      </span>
      <span class="home-chip" data-role hidden></span>
    </li>
  </template>

  <template data-tile-template>
    <li>
      <a class="card home-tile" data-link>
        <span class="home-tile-icon" data-tile-icon hidden>
          <svg class="icon" aria-hidden="true">
            <use data-icon></use>
          </svg>
        </span>
        <span class="home-tile-text">
          <b class="home-tile-title" data-title></b>
          <span class="caption" data-meta></span>
        </span>
      </a>
    </li>
  </template>

  <template data-change-template>
    <li class="home-row">
      <span class="home-row-text" data-text></span>
      <span class="caption" data-where></span>
    </li>
  </template>
</div>
