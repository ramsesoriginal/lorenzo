<!-- A tenant's or a campaign's picture: the current one, a file to replace it with, and a way to
     remove it. -->
<span class="row" data-picture-upload>

  <img alt="" width="128" height="128" data-picture />
  <div class="stack">
    <input type="file" accept="image/*" aria-label="Choose a picture" data-file />
    <button type="button" data-remove>Remove picture</button>
    <span class="status-text" role="status" data-status hidden></span>
  </div>
</span>
