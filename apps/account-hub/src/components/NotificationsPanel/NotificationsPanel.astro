---
// Everything on /notifications: the inbox, and the notifications you have sent with who has read
// them (RFC 0017 (h)). Rendered by renderNotificationsPanel.
import { BRANDING_CSS_URL } from '../../lib/config';
---

<div class="stack" data-notifications-panel hidden>
  <p class="error-text" role="alert" data-error hidden></p>

  <div class="notif-head">
    <p class="grow" role="status" data-summary></p>
    <div class="segmented-control" role="radiogroup" aria-label="Show">
      <button type="button" role="radio" aria-checked="true" data-filter="all">
        All
      </button>
      <button type="button" role="radio" aria-checked="false" data-filter="unread">
        Unread
      </button>
    </div>
    <button type="button" class="btn btn-secondary" data-mark-all>
      Mark all as read
    </button>
  </div>

  <div data-empty hidden></div>
  <ul class="list notif-list" data-list></ul>

  <section class="stack">
    <div>
      <button type="button" class="btn-secondary" data-sent-toggle>
        Show notifications I've sent
      </button>
    </div>

    <div class="stack" data-sent hidden>
      <p data-sent-empty hidden>
        You haven't sent any notifications.
      </p>
      <ul class="list" data-sent-list></ul>
    </div>
  </section>

  <template data-notification-template>
    <li class="notif" data-notification>
      <span class="notif-dot-slot" aria-hidden="true">
        <span class="notif-dot" data-dot hidden></span>
      </span>
      <div class="tree grow">
        <details>
          <summary data-open>
            <span class="stack-tight grow">
              <strong>
                <span class="visually-hidden" data-unread-word hidden>
                  Unread.{' '}
                </span>
                <span data-title></span>
              </strong>
              <span class="caption" data-when></span>
            </span>
            <svg class="icon tree-toggle" aria-hidden="true" data-chevron>
              <use href={`${BRANDING_CSS_URL}/icons.svg#icon-expand`}></use>
            </svg>
          </summary>
          <p class="notification-body" data-body></p>
          <p class="caption notification-meta" data-meta></p>
        </details>
      </div>
      <button type="button" class="btn btn-secondary" data-mark-read hidden>
        Mark read
      </button>
      <span class="status-text" role="status" data-status hidden></span>
    </li>
  </template>

  <!-- One broadcast: every row a single creation call fanned out shares a batch (ADR 0061). -->
  <template data-batch-template>
    <li>
      <div class="tree">
        <details>
          <summary data-open>
            <span class="stack-tight grow">
              <strong data-title></strong>
              <span class="caption notification-meta" data-meta></span>
            </span>
            <svg class="icon tree-toggle" aria-hidden="true" data-chevron>
              <use href={`${BRANDING_CSS_URL}/icons.svg#icon-expand`}></use>
            </svg>
          </summary>
          <p class="notification-body" data-body></p>
          <ul class="list" data-recipients></ul>
        </details>
      </div>
    </li>
  </template>

  <template data-recipient-template>
    <li></li>
  </template>
</div>
