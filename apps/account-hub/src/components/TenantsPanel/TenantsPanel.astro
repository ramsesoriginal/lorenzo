---
// Everything on /tenants: a tree of your libraries beside whichever one is open. "New library" is an
// item in the tree too, for an account that may create. Repositories are in Studio (ADR 0202).
// Rendered by renderTenantsPanel.
import { BRANDING_CSS_URL } from '../../lib/config';
import CreateTenant from '../CreateTenant/CreateTenant.astro';
import Tenant from '../Tenant/Tenant.astro';
---

<div class="with-sidebar full-width" data-tenants-panel hidden>
  <nav class="sidebar" aria-label="Libraries">
    <ul class="tree" data-tree>
      <li data-libraries-group hidden>
        <details data-libraries-details>
          <summary>
            <span class="grow">Libraries</span>
            <svg class="icon tree-toggle" aria-hidden="true">
              <use href={`${BRANDING_CSS_URL}/icons.svg#icon-expand`}></use>
            </svg>
          </summary>
          <ul data-libraries></ul>
        </details>
      </li>
    </ul>
    <p class="caption" data-create-unavailable hidden>
      Creating a library isn't open to your account yet.
    </p>
  </nav>

  <div class="stack" data-main>
    <p class="error-text" role="alert" data-error hidden></p>
    <!-- What happened to the library that was just deleted (ADR 0267). -->
    <p class="status-text" role="status" data-notice hidden></p>

    <!-- With two libraries or more and none open: a card for each (ADR 0417, AH7). -->
    <div class="home-grid" data-index hidden></div>

    <!-- Inside one: the way back to all of them. -->
    <nav class="breadcrumb caption" aria-label="Breadcrumb" data-breadcrumb hidden>
      <a href="/tenants/" data-all>
        Libraries
      </a>
      <span aria-hidden="true"> / </span>
      <span data-crumb></span>
    </nav>

    <Tenant />

    <div data-create hidden></div>

    <div data-unavailable hidden></div>

    <div class="stack-tight" data-empty hidden>
      <p>You don't belong to any library yet.</p>
      <div data-setup hidden>
        <a class="btn btn-primary" href="/setup/">
          Set up a library
        </a>
      </div>
    </div>
  </div>

  <template data-item-template>
    <li>
      <a data-link></a>
    </li>
  </template>

  <template data-card-template>
    <article class="home-block" data-card>
      <div class="row">
        <h2 class="grow">
          <a data-link></a>
        </h2>
        <span class="badge" data-role></span>
      </div>
      <div class="notification-body" data-description></div>
      <p class="caption" data-counts></p>
    </article>
  </template>

  <template data-create-template>
    <CreateTenant />
  </template>

  <template data-new-template>
    <li>
      <a class="row-tight" data-link>
        <svg class="icon" aria-hidden="true">
          <use href={`${BRANDING_CSS_URL}/icons.svg#icon-add`}></use>
        </svg>
        <span data-label></span>
      </a>
    </li>
  </template>
</div>
