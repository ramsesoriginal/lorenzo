<!-- Deleting your account (ADR 0170), at the foot of /profile. Rendered by renderDeleteAccount. -->
<section class="section danger-zone stack" data-delete-account hidden>
  <h2>Delete your account</h2>
  <p>
    This removes your Lorenzo account and ends every library membership, campaign seat and GM role
    you hold. It doesn't delete your Authgear login.
  </p>
  <div class="row">
    <button type="button" class="btn-danger" data-delete>Delete my account</button>
    <span class="status-text" role="status" data-status hidden></span>
  </div>
</section>
