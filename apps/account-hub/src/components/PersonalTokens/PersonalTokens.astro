---
import { BRANDING_CSS_URL } from '../../lib/config';
---

<!-- Your personal access tokens (ADR 0269, ADR 0418, PT4), on /tokens. Rendered by renderPersonalTokens. -->
<section class="stack" id="personal-access-tokens" data-personal-tokens hidden>
  <p class="callout">
    <svg class="icon" aria-hidden="true">
      <use href={`${BRANDING_CSS_URL}/icons.svg#icon-token`}></use>
    </svg>
    <span>
      A personal access token is a whole key: whatever has it can do what you can do, except manage
      tokens or delete your account. Revoke one here if it is lost or no longer needed.
    </span>
  </p>
  <span class="status-text" role="status" data-list-status hidden></span>
  <ul class="list token-list" data-list></ul>

  <template data-token-template>
    <li class="token-row">
      <div class="token-name">
        <strong data-name></strong>
        <span class="caption">
          Ends in <code data-hint></code>
        </span>
      </div>
      <div class="token-state">
        <span class="token-used row-tight">
          <svg class="icon" aria-hidden="true">
            <use href={`${BRANDING_CSS_URL}/icons.svg#icon-select-item`} data-icon></use>
          </svg>
          <span data-used></span>
        </span>
        <span class="caption" data-note></span>
      </div>
      <button type="button" class="btn btn-secondary" data-revoke>
        Revoke…
      </button>
      <span class="status-text" role="status" data-status hidden></span>
    </li>
  </template>
</section>
