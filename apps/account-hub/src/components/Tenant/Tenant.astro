---
// One library: its name, and what the signed-in person can do with it.
// Rendered by renderTenant. Each part of a tenant is a component, kept here as a <template>: the
// renderer clones the ones this tenant and this person have a use for into the slots below (a slot
// stays hidden until it has one), and the campaign's own parts into each campaign's row.
import ActivityLog from '../ActivityLog/ActivityLog.astro';
import CampaignEdit from '../CampaignEdit/CampaignEdit.astro';
import CampaignForm from '../CampaignForm/CampaignForm.astro';
import CampaignRoster from '../CampaignRoster/CampaignRoster.astro';
import GmManagement from '../GmManagement/GmManagement.astro';
import InviteLinks from '../InviteLinks/InviteLinks.astro';
import InvitePlayer from '../InvitePlayer/InvitePlayer.astro';
import MembershipAdmin from '../MembershipAdmin/MembershipAdmin.astro';
import TenantInviteLinks from '../TenantInviteLinks/TenantInviteLinks.astro';
import NotificationComposer from '../NotificationComposer/NotificationComposer.astro';
import Seat from '../Seat/Seat.astro';
import PictureUpload from '../PictureUpload/PictureUpload.astro';
import TenantDelete from '../TenantDelete/TenantDelete.astro';
import TenantEdit from '../TenantEdit/TenantEdit.astro';
---

<article class="stack" data-tenant hidden>
  <header class="stack-tight">
    <div class="row">
      <div class="row grow">
        <h2 data-name></h2>
        <code data-slug></code>
      </div>
      <span class="badge" data-role></span>
    </div>
    <div class="ls-content" data-tenant-description hidden></div>
  </header>

  <div class="stack">
    <p data-loading hidden>
      Loading&hellip;
    </p>
    <p class="error-text" role="alert" data-error hidden></p>

    <!-- What a library's people can do in it, one part at a time (the design's Overview, Campaigns,
         People and Settings). A tab is there only while its panel has something in it, so a player has
         the campaigns only; bindTabs does that. -->
    <div class="stack" data-tenant-tabs>
      <div class="tabs" role="tablist" aria-label="This library">
        <button type="button" class="tab" role="tab">
          Overview
        </button>
        <button type="button" class="tab" role="tab">
          Campaigns
        </button>
        <button type="button" class="tab" role="tab">
          People
        </button>
        <button type="button" class="tab" role="tab">
          Settings
        </button>
      </div>

      <!-- Overview: how big it is, what it draws on, what happened lately. -->
      <div class="stack" role="tabpanel">
        <div class="library-stats" data-stats hidden>
          <div class="card card-body stack-tight">
            <span class="caption">People</span>
            <strong class="library-stat" data-stat-people>
              0
            </strong>
          </div>
          <div class="card card-body stack-tight">
            <span class="caption">Campaigns</span>
            <strong class="library-stat" data-stat-campaigns>
              0
            </strong>
          </div>
          <div class="card card-body stack-tight">
            <span class="caption">Repositories</span>
            <strong class="library-stat" data-stat-repositories>
              0
            </strong>
          </div>
        </div>
        <div class="library-columns" data-overview-columns hidden>
          <section class="stack" data-overview-repositories hidden>
            <div class="row">
              <h3 class="grow">Repositories it draws on</h3>
              <a href="/repositories/" data-all-repositories>
                All repositories
              </a>
            </div>
            <ul class="list" data-overview-repository-list></ul>
            <p data-overview-no-repositories hidden>
              It draws on no repository yet.
            </p>
          </section>
          <section class="stack" data-overview-recent hidden>
            <h3>Recent</h3>
            <div data-slot data-activity-slot hidden></div>
          </section>
        </div>
      </div>

      <!-- Campaigns, and the form that makes one. -->
      <div class="stack" role="tabpanel">
        <p class="hub-intro">Who plays, who runs, and the links that bring people in.</p>
        <section class="stack" data-campaigns hidden>
          <p data-no-campaigns hidden>
            No campaigns visible to you here yet.
          </p>
          <div class="stack" data-campaign-list></div>
        </section>
        <div data-slot data-create-campaign-slot hidden></div>
      </div>

      <!-- People: who is in it, the links that bring them, and a word to all of them. -->
      <div class="stack" role="tabpanel">
        <div data-slot data-memberships-slot hidden></div>
        <div data-slot data-links-slot hidden></div>
        <div data-slot data-notifications-slot hidden></div>
      </div>

      <!-- Settings: its name and description, its picture, leaving it, deleting it. -->
      <div class="stack" role="tabpanel">
        <div class="stack" data-tenant-edit hidden>
          <div class="stack-tight">
            <h3>General</h3>
            <p class="caption">The name and description people see.</p>
          </div>
          <span class="status-text" role="status" data-edit-status hidden></span>
        </div>
        <div data-slot data-picture-slot hidden></div>

        <div data-leave hidden>
          <button type="button" class="btn-danger" data-leave-button>
            Leave this <span data-noun></span>
          </button>
          <span class="status-text" role="status" data-leave-status hidden></span>
        </div>

        <div data-slot data-delete-slot hidden></div>
      </div>
    </div>
  </div>

  <!-- The library's parts. -->
  <TenantEdit />
  <template data-picture-upload-template>
    <PictureUpload />
  </template>
  <template data-create-campaign-template>
    <CampaignForm />
  </template>
  <template data-membership-admin-template>
    <MembershipAdmin />
  </template>
  <template data-tenant-invite-links-template>
    <TenantInviteLinks />
  </template>
  <template data-activity-log-template>
    <ActivityLog />
  </template>
  <template data-notification-composer-template>
    <NotificationComposer />
  </template>
  <template data-tenant-delete-template>
    <TenantDelete />
  </template>

  <!-- A campaign's row and its parts, which are the same components for every campaign. -->
  <template data-campaign-template>
    <article class="card card-body stack hub-campaign">
      <header class="row">
        <h3 data-campaign-name></h3>
        <span class="campaign-meta" data-campaign-meta></span>
      </header>
      <div class="stack">
        <div class="row sticky-top">
          <div data-campaign-picture-slot hidden></div>
          <div class="stack grow">
            <div class="ls-content grow" data-campaign-description hidden></div>
            <div class="row-tight grow" data-campaign-edit-slot hidden></div>
          </div>
        </div>
      </div>
      <!-- What a campaign's managers can do, one part at a time. bindTabs makes it work; the tabs are
           only there for those who manage the campaign. -->
      <div data-campaign-seat-slot hidden></div>
      <div class="stack" data-campaign-tabs hidden>
        <div class="tabs" role="tablist" aria-label="Manage this campaign">
          <button type="button" class="tab" role="tab">
            People
          </button>
          <button type="button" class="tab" role="tab">
            Invite links
          </button>
          <button type="button" class="tab" role="tab">
            Notifications
          </button>
        </div>
        <div class="row v-mobile sticky-top" role="tabpanel">
          <div class="stack grow">
            <div data-campaign-invite-player-slot hidden></div>
            <div data-campaign-roster-slot hidden></div>
          </div>
          <div class="stack grow">
            <div data-campaign-gms-slot hidden></div>
            <!-- Stepping down as the campaign's GM, shown to its GMs. The button's words are what
                 the campaign calls its game master (ADR 0294), set by bindStepDownAsGm. -->
            <div class="row" data-campaign-step-down hidden>
              <button type="button" class="btn-danger" data-step-down></button>
              <span class="status-text" role="status" data-step-down-status hidden></span>
            </div>
          </div>
        </div>
        <div role="tabpanel">
          <div data-campaign-invite-links-slot hidden></div>
        </div>
        <div role="tabpanel">
          <div data-campaign-notify-slot hidden></div>
        </div>
      </div>
    </article>
  </template>
  <template data-seat-template>
    <Seat />
  </template>
  <template data-campaign-roster-template>
    <CampaignRoster />
  </template>
  <template data-campaign-edit-template>
    <CampaignEdit />
  </template>
  <template data-gm-management-template>
    <GmManagement />
  </template>
  <template data-invite-player-template>
    <InvitePlayer />
  </template>
  <template data-invite-links-template>
    <InviteLinks />
  </template>
</article>
