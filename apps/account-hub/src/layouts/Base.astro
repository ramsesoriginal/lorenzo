---
import SiteHead from '../components/SiteHead/SiteHead.astro';
import SiteHeader from '../components/SiteHeader/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter/SiteFooter.astro';

interface Props {
  title?: string;
}

const { title = 'Lorenzo - Account' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <SiteHead title={title}>
    <!-- What a page puts in `slot="head"` (the referrer policy of /join, ADR 0171) reaches <head>. -->
    <slot name="head" slot="head" />
  </SiteHead>
  <body>
    <SiteHeader />
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <SiteFooter />
  </body>
</html>
