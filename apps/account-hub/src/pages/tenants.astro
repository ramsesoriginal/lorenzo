---
import TenantsPanel from '../components/TenantsPanel/TenantsPanel.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Your libraries and campaigns — Lorenzo">
  <h1 class="display">Your libraries and campaigns</h1>

  <p id="loading">Loading&hellip;</p>
  <p id="load-error" class="error-text" hidden></p>

  <TenantsPanel />

  <script>
    import { renderTenantsPanel } from '../components/TenantsPanel/renderer';
    import { getMe } from '../lib/me';
    import { runPage } from '../lib/pageLoad';
    import { requiredIn } from '../lib/template';

    const panel = requiredIn('Tenants')<HTMLElement>(document, '[data-tenants-panel]');

    await runPage(async () => renderTenantsPanel(panel, await getMe()));
  </script>
</Base>
