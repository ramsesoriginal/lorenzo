---
import TenantsPanel from '../components/TenantsPanel/TenantsPanel.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Your libraries and campaigns — Lorenzo">
  <h1 class="display">Your libraries and campaigns</h1>

  <p id="loading">Loading&hellip;</p>
  <p id="load-error" class="error-text" hidden></p>

  <TenantsPanel />

  <script>
    import { renderTenantsPanel } from '../components/TenantsPanel/renderer';
    import { isAuthenticated } from '../lib/auth';
    import { showError } from '../lib/errorUi';
    import { getMe } from '../lib/me';
    import { requiredIn } from '../lib/template';

    const loading = document.getElementById('loading')!;
    const loadError = document.getElementById('load-error')!;
    const panel = requiredIn('Tenants')<HTMLElement>(document, '[data-tenants-panel]');

    if (!(await isAuthenticated())) {
      loading.hidden = true;
      loadError.hidden = false;
      loadError.textContent = 'Not logged in. Go back and log in first.';
    } else {
      try {
        await renderTenantsPanel(panel, await getMe());
        loading.hidden = true;
      } catch (e) {
        loading.hidden = true;
        loadError.hidden = false;
        showError(loadError, e);
      }
    }
  </script>
</Base>
