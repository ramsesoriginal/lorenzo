---
import Base from '../layouts/Base.astro';
---

<Base title="Your tenants and campaigns — Lorenzo">
  <h1 class="display">Your tenants and campaigns</h1>
  <p><a href="/">&larr; Back</a></p>

  <p id="loading">Loading&hellip;</p>
  <p id="load-error" class="error-text" hidden></p>

  <div id="create-tenant-container"></div>

  <p id="empty-state" hidden>You don't belong to any tenant yet.</p>

  <ul id="tenant-list"></ul>

  <script>
    import { renderActivityLog } from '../lib/activityLogUi';
    import { renderCreateCampaignForm, renderEditToggle } from '../lib/campaignAdminUi';
    import { renderCampaignRoster } from '../lib/campaignRosterUi';
    import { createStatusSpan } from '../lib/dom';
    import { campaignRoleFor, type CampaignRole } from '../lib/format';
    import { renderGmManagement, renderInvitePlayer } from '../lib/gmAndPlayerUi';
    import { getMe } from '../lib/me';
    import { renderMembershipAdmin } from '../lib/membershipAdminUi';
    import { renderNotificationComposer } from '../lib/notificationComposerUi';
    import { renderPictureUpload } from '../lib/pictureUi';
    import {
      campaignPictureUrl,
      createCampaignNotification,
      createTenant,
      createTenantNotification,
      deleteCampaignPicture,
      deleteTenantPicture,
      listCampaignGms,
      listMyTenants,
      listTenantCampaigns,
      listTenantRoster,
      tenantPictureUrl,
      uploadCampaignPicture,
      uploadTenantPicture,
    } from '../lib/tenants';
    import type {
      CampaignSummaryOut,
      MeOut,
      MembershipRosterEntryOut,
      RosterEntry,
      TenantSummaryOut,
    } from '../lib/types';
    import { isAuthenticated } from '../lib/auth';

    const loading = document.getElementById('loading')!;
    const loadError = document.getElementById('load-error')!;
    const createTenantContainer = document.getElementById('create-tenant-container')!;
    const emptyState = document.getElementById('empty-state')!;
    const tenantList = document.getElementById('tenant-list')!;

    function roleLabel(role: CampaignRole): string {
      switch (role) {
        case 'gm':
          return 'GM';
        case 'player':
          return 'Player';
        case 'visible':
          return 'Visible';
      }
    }

    function isTenantAdmin(tenant: TenantSummaryOut): boolean {
      return tenant.role === 'owner' || tenant.role === 'orga';
    }

    // RFC 0017 (d) - require_tenant_creator_role is a platform-level
    // Authgear role with no client-visible signal anywhere in MeOut - this
    // form is always shown, and a 403 is surfaced like any other
    // authorization failure, rather than trying to approximate a check
    // that has no data to approximate it with.
    function renderCreateTenantForm(onCreated: () => void): HTMLElement {
      const form = document.createElement('form');
      const heading = document.createElement('h2');
      heading.textContent = 'Create a tenant';
      const nameInput = document.createElement('input');
      nameInput.type = 'text';
      nameInput.placeholder = 'Name';
      nameInput.required = true;
      const slugInput = document.createElement('input');
      slugInput.type = 'text';
      slugInput.placeholder = 'Slug (optional, derived from name)';
      const descriptionInput = document.createElement('textarea');
      descriptionInput.placeholder = 'Description (optional)';
      const button = document.createElement('button');
      button.type = 'submit';
      button.textContent = 'Create tenant';
      const status = createStatusSpan();

      form.append(heading, nameInput, slugInput, descriptionInput, button, status);
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.textContent = 'Creating…';
        try {
          await createTenant({
            name: nameInput.value.trim(),
            slug: slugInput.value.trim() || null,
            description: descriptionInput.value.trim() || null,
          });
          form.reset();
          status.textContent = '';
          onCreated();
        } catch (e) {
          status.textContent = e instanceof Error ? e.message : String(e);
        }
      });
      return form;
    }

    function renderCampaign(
      tenant: TenantSummaryOut,
      campaign: CampaignSummaryOut,
      me: MeOut,
      roster: RosterEntry[] | null,
      gmsByCampaign: Map<string, string[]>,
      onChanged: () => void,
    ): HTMLLIElement {
      const item = document.createElement('li');
      const name = document.createElement('strong');
      name.textContent = campaign.name;
      const meta = document.createElement('span');
      meta.className = 'campaign-meta';
      const role = campaignRoleFor(campaign.id, me);
      meta.textContent = ` ${campaign.game_system} · ${roleLabel(role)}${campaign.secret ? ' · secret' : ''}`;
      item.append(name, meta);

      const admin = isTenantAdmin(tenant);
      // RFC 0017 (a)'s own "any tenant-wide member" is, by construction,
      // exactly admin (owner/orga) - MembershipRole has no plain-member
      // role, so get_tenant_context's gate on the underlying roster fetch
      // already excludes anyone else. roster is null (not fetched at all)
      // for a non-admin tenant - a participant-only caller (Player/
      // CampaignGm standing, no Membership row) got an uncaught 404 here
      // before this fix, breaking this whole page for them.
      if (roster) {
        item.append(renderCampaignRoster(campaign, roster));
      }

      if (admin) {
        item.append(renderEditToggle(tenant, campaign, onChanged));
        item.append(
          renderGmManagement(
            tenant,
            campaign,
            gmsByCampaign.get(campaign.id) ?? [],
            roster ?? [],
            onChanged,
          ),
        );
      }
      // can_manage_campaign's real two-way gate: a tenant admin, or this
      // specific campaign's own GM (RFC 0014) - not just one branch of it;
      // matches upload_campaign_picture's own gate too (ADR 0085).
      if (admin || role === 'gm') {
        item.append(
          renderPictureUpload(
            campaignPictureUrl(tenant.id, campaign.id),
            (file) => uploadCampaignPicture(tenant.id, campaign.id, file),
            () => deleteCampaignPicture(tenant.id, campaign.id),
          ),
        );
        item.append(renderInvitePlayer(tenant, campaign));
        item.append(
          renderNotificationComposer((body) =>
            createCampaignNotification(tenant.id, campaign.id, body),
          ),
        );
      }

      return item;
    }

    async function renderTenant(
      tenant: TenantSummaryOut,
      campaigns: CampaignSummaryOut[],
      me: MeOut,
      onChanged: () => void,
    ): Promise<HTMLLIElement> {
      const item = document.createElement('li');
      const heading = document.createElement('h2');
      heading.textContent = `${tenant.name} `;
      const roleBadge = document.createElement('span');
      roleBadge.className = 'tenant-role';
      roleBadge.textContent = tenant.role;
      heading.append(roleBadge);
      item.append(heading);

      const admin = isTenantAdmin(tenant);
      // get_tenant_context (the real gate behind list_tenant_roster/
      // list_activity_log/create_tenant_notification_route) requires an
      // actual Membership row, which by construction means admin
      // (owner/orga) - MembershipRole has no plain-member role. Fetching
      // this for every tenant listMyTenants() returns, including
      // participant-only ones (Player/CampaignGm standing, no Membership),
      // 404'd uncaught and broke this whole page for that caller.
      const roster = admin ? await listTenantRoster(tenant.id) : null;

      // Same gate upload_tenant_picture itself enforces (ADR 0056/0085) -
      // ORGA+, day-to-day tenant administration.
      if (admin) {
        item.append(
          renderPictureUpload(
            tenantPictureUrl(tenant.id),
            (file) => uploadTenantPicture(tenant.id, file),
            () => deleteTenantPicture(tenant.id),
          ),
        );
      }

      if (campaigns.length === 0) {
        const none = document.createElement('p');
        none.textContent = 'No campaigns visible to you here yet.';
        item.append(none);
      } else {
        const gmLists = admin
          ? await Promise.all(campaigns.map((c) => listCampaignGms(tenant.id, c.id)))
          : [];
        const gmsByCampaign = new Map(
          campaigns.map((c, i) => [c.id, (gmLists[i] ?? []).map((g) => g.user_id)]),
        );

        const list = document.createElement('ul');
        list.className = 'roster-list';
        for (const campaign of campaigns) {
          list.append(
            renderCampaign(tenant, campaign, me, roster?.items ?? null, gmsByCampaign, onChanged),
          );
        }
        item.append(list);
      }

      if (admin) {
        item.append(renderCreateCampaignForm(tenant, onChanged));
      }

      // RFC 0017 (e) - bulk invite is confirmed _require_owner-gated; the
      // single-item actions here are gated identically for consistency
      // rather than assumed looser (showing nothing to an orga who might
      // technically have single-item rights is the safe direction of a
      // wrong guess). tenant.role === 'owner' implies admin, so roster is
      // never null here.
      if (tenant.role === 'owner' && roster) {
        const memberships = roster.items.filter(
          (r): r is MembershipRosterEntryOut => r.kind === 'membership',
        );
        item.append(renderMembershipAdmin(tenant, memberships, onChanged));
      }

      // RFC 0017 (f)/(g) - gated the same as list_tenant_roster/
      // update_tenant themselves: get_tenant_context, which is admin-only
      // by construction (see the roster fetch above) - not owner-only, but
      // not "any participant" either.
      if (admin) {
        item.append(await renderActivityLog(tenant));
        item.append(
          renderNotificationComposer((body) => createTenantNotification(tenant.id, body)),
        );
      }

      return item;
    }

    async function load() {
      const me = await getMe();
      const tenantsPage = await listMyTenants();
      if (tenantsPage.items.length === 0) {
        emptyState.hidden = false;
        return;
      }
      const withCampaigns = await Promise.all(
        tenantsPage.items.map(async (tenant) => ({
          tenant,
          campaigns: (await listTenantCampaigns(tenant.id)).items,
        })),
      );
      const sections = await Promise.all(
        withCampaigns.map(({ tenant, campaigns }) =>
          renderTenant(tenant, campaigns, me, () => void load()),
        ),
      );
      tenantList.replaceChildren(...sections);
    }

    if (!(await isAuthenticated())) {
      loading.hidden = true;
      loadError.hidden = false;
      loadError.textContent = 'Not logged in. Go back and log in first.';
    } else {
      try {
        createTenantContainer.append(renderCreateTenantForm(() => void load()));
        await load();
        loading.hidden = true;
      } catch (e) {
        loading.hidden = true;
        loadError.hidden = false;
        loadError.textContent = e instanceof Error ? e.message : String(e);
      }
    }
  </script>
</Base>
