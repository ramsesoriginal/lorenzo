---
import Base from '../../layouts/Base.astro';
---

<Base title="Signing in — Lorenzo">
  <p>Signing you in&hellip;</p>
  <script>
    import { completeLogin } from '../../lib/auth';
    import { browserSessionStorage, takeReturnPath } from '../../lib/returnPath';

    await completeLogin();
    // The page "Log in" was pressed on (a path on this origin, else home).
    window.location.replace(takeReturnPath(browserSessionStorage()));
  </script>
</Base>
