---
import CampaignsPanel from '../components/CampaignsPanel/CampaignsPanel.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Your campaigns — Lorenzo">
  <h1 class="display">Your campaigns</h1>
  <p id="loading">Loading&hellip;</p>
  <p id="load-error" class="error-text" hidden></p>

  <CampaignsPanel />

  <script>
    import { renderCampaignsPanel } from '../components/CampaignsPanel/renderer';
    import { runPage } from '../lib/pageLoad';
    import { requiredIn } from '../lib/template';

    const panel = requiredIn('Campaigns')<HTMLElement>(document, '[data-campaigns-panel]');

    await runPage(() => renderCampaignsPanel(panel));
  </script>
</Base>
