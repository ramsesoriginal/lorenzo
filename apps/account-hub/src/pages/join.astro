---
import JoinInvite from '../components/JoinInvite/JoinInvite.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Join a campaign — Lorenzo">
  <!-- The address of this page carries an invite token for a moment (ADR 0171):
       never send it on to another site. public/_headers says the same. -->
  <meta slot="head" name="referrer" content="no-referrer" />

  <h1 class="display">Join a campaign</h1>

  <p id="loading">Loading&hellip;</p>
  <p id="load-error" class="error-text" hidden></p>

  <JoinInvite />

  <script>
    import { renderJoinInvite } from '../components/JoinInvite/renderer';
    import { showError } from '../lib/errorUi';
    import { requiredIn } from '../lib/template';

    const loading = document.getElementById('loading')!;
    const loadError = document.getElementById('load-error')!;
    const join = requiredIn('Join')<HTMLElement>(document, '[data-join]');

    try {
      await renderJoinInvite(join);
    } catch (e) {
      loadError.hidden = false;
      showError(loadError, e);
    } finally {
      loading.hidden = true;
    }
  </script>
</Base>
