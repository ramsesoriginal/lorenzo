---
import NotificationsPanel from '../components/NotificationsPanel/NotificationsPanel.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Notifications — Lorenzo">
  <h1 class="display">Notifications</h1>

  <p id="loading">Loading&hellip;</p>
  <p id="load-error" class="error-text" hidden></p>

  <NotificationsPanel />

  <script>
    import { renderNotificationsPanel } from '../components/NotificationsPanel/renderer';
    import { isAuthenticated } from '../lib/auth';
    import { showError } from '../lib/errorUi';
    import { requiredIn } from '../lib/template';

    const loading = document.getElementById('loading')!;
    const loadError = document.getElementById('load-error')!;
    const panel = requiredIn('Notifications')<HTMLElement>(
      document,
      '[data-notifications-panel]',
    );

    if (!(await isAuthenticated())) {
      loading.hidden = true;
      loadError.hidden = false;
      loadError.textContent = 'Not logged in. Go back and log in first.';
    } else {
      try {
        await renderNotificationsPanel(panel);
        loading.hidden = true;
      } catch (e) {
        loading.hidden = true;
        loadError.hidden = false;
        showError(loadError, e);
      }
    }
  </script>
</Base>
