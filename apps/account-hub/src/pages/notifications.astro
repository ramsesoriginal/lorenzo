---
import NotificationsPanel from '../components/NotificationsPanel/NotificationsPanel.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Notifications — Lorenzo" template="reading">
  <div class="page-heading">
    <h1>Notifications</h1>
  </div>

  <p id="loading">Loading&hellip;</p>
  <p id="load-error" class="error-text" hidden></p>

  <NotificationsPanel />

  <script>
    import { renderNotificationsPanel } from '../components/NotificationsPanel/renderer';
    import { runPage } from '../lib/pageLoad';
    import { requiredIn } from '../lib/template';

    const panel = requiredIn('Notifications')<HTMLElement>(document, '[data-notifications-panel]');

    await runPage(() => renderNotificationsPanel(panel));
  </script>
</Base>
