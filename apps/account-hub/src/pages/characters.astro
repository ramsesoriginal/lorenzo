---
import Base from '../layouts/Base.astro';
---

<Base title="Your characters — Lorenzo">
  <h1 class="display">Your characters</h1>
  <p><a href="/">&larr; Back</a></p>

  <p id="loading">Loading&hellip;</p>
  <p id="load-error" class="error-text" hidden></p>
  <p id="empty-state" hidden>You don't belong to any tenant yet.</p>

  <div id="tenant-list"></div>

  <script>
    import { createCharacter, updateCharacter } from '../lib/characters';
    import { getMe } from '../lib/me';
    import { listMyTenants, listTenantCampaigns } from '../lib/tenants';
    import type {
      CampaignSummaryOut,
      CharacterSummaryOut,
      MeOut,
      PlayerContextOut,
      TenantSummaryOut,
    } from '../lib/types';
    import { isAuthenticated } from '../lib/auth';

    const loading = document.getElementById('loading')!;
    const loadError = document.getElementById('load-error')!;
    const emptyState = document.getElementById('empty-state')!;
    const tenantList = document.getElementById('tenant-list')!;

    function renderCharacterItem(
      character: CharacterSummaryOut,
      player: PlayerContextOut,
      onRenamed: () => void,
    ): HTMLLIElement {
      const item = document.createElement('li');
      const nameEl = document.createElement('span');
      nameEl.textContent = character.name;

      const renameButton = document.createElement('button');
      renameButton.type = 'button';
      renameButton.textContent = 'Rename';

      const status = document.createElement('span');
      status.setAttribute('role', 'status');

      renameButton.addEventListener('click', () => {
        const input = document.createElement('input');
        input.type = 'text';
        input.value = character.name;
        const saveButton = document.createElement('button');
        saveButton.type = 'button';
        saveButton.textContent = 'Save';
        const cancelButton = document.createElement('button');
        cancelButton.type = 'button';
        cancelButton.textContent = 'Cancel';

        item.replaceChildren(input, saveButton, cancelButton, status);

        cancelButton.addEventListener('click', () => {
          item.replaceChildren(nameEl, renameButton, status);
        });
        saveButton.addEventListener('click', async () => {
          const name = input.value.trim();
          if (name === '' || name === character.name) {
            item.replaceChildren(nameEl, renameButton, status);
            return;
          }
          status.textContent = 'Saving&hellip;';
          try {
            await updateCharacter(player.tenant_id, character.entity_id, { name });
            onRenamed();
          } catch (e) {
            status.textContent = e instanceof Error ? e.message : String(e);
          }
        });
      });

      item.append(nameEl, renameButton, status);
      return item;
    }

    function renderCreateForm(player: PlayerContextOut, onCreated: () => void): HTMLFormElement {
      const form = document.createElement('form');
      const input = document.createElement('input');
      input.type = 'text';
      input.placeholder = 'New character name';
      input.required = true;
      const button = document.createElement('button');
      button.type = 'submit';
      button.textContent = 'Create character';
      const status = document.createElement('span');
      status.setAttribute('role', 'status');

      form.append(input, button, status);
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const name = input.value.trim();
        if (name === '') return;
        status.textContent = 'Creating&hellip;';
        try {
          await createCharacter(player.tenant_id, { name, owner_player_id: player.id });
          input.value = '';
          status.textContent = '';
          onCreated();
        } catch (e) {
          status.textContent = e instanceof Error ? e.message : String(e);
        }
      });
      return form;
    }

    function findPlayerFor(
      me: MeOut,
      tenantId: string,
      campaignId: string,
    ): PlayerContextOut | undefined {
      return me.players.find((p) => p.tenant_id === tenantId && p.campaign_id === campaignId);
    }

    // No self-service join exists (RFC 0014 - POST .../players is
    // can_manage_campaign-gated, never a plain player's own action), so a
    // campaign with no player context here is read-only context, not a
    // dead button.
    function renderCampaignSection(
      campaign: CampaignSummaryOut,
      player: PlayerContextOut | undefined,
      onChanged: () => void,
    ): HTMLElement {
      const section = document.createElement('section');
      section.className = 'campaign-subsection';
      const heading = document.createElement('h3');
      heading.textContent = campaign.name;
      section.append(heading);

      if (!player) {
        const none = document.createElement('p');
        none.textContent = "You don't play in this campaign yet.";
        section.append(none);
        return section;
      }

      if (player.characters.length === 0) {
        const none = document.createElement('p');
        none.textContent = "You don't have a character here yet.";
        section.append(none);
      } else {
        const list = document.createElement('ul');
        for (const character of player.characters) {
          list.append(renderCharacterItem(character, player, onChanged));
        }
        section.append(list);
      }

      section.append(renderCreateForm(player, onChanged));
      return section;
    }

    async function renderTenantSection(
      tenant: TenantSummaryOut,
      me: MeOut,
      onChanged: () => void,
    ): Promise<HTMLElement> {
      const section = document.createElement('section');
      section.className = 'section';
      const heading = document.createElement('h2');
      heading.textContent = tenant.name;
      section.append(heading);

      const campaigns = await listTenantCampaigns(tenant.id);
      for (const campaign of campaigns.items) {
        const player = findPlayerFor(me, tenant.id, campaign.id);
        section.append(renderCampaignSection(campaign, player, onChanged));
      }
      return section;
    }

    async function load() {
      const me = await getMe();
      const tenantsPage = await listMyTenants();
      if (tenantsPage.items.length === 0) {
        emptyState.hidden = false;
        tenantList.replaceChildren();
        return;
      }
      emptyState.hidden = true;
      const sections = await Promise.all(
        tenantsPage.items.map((tenant) => renderTenantSection(tenant, me, () => void load())),
      );
      tenantList.replaceChildren(...sections);
    }

    if (!(await isAuthenticated())) {
      loading.hidden = true;
      loadError.hidden = false;
      loadError.textContent = 'Not logged in. Go back and log in first.';
    } else {
      try {
        await load();
        loading.hidden = true;
      } catch (e) {
        loading.hidden = true;
        loadError.hidden = false;
        loadError.textContent = e instanceof Error ? e.message : String(e);
      }
    }
  </script>
</Base>
