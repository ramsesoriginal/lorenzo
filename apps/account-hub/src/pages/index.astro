---
import Base from '../layouts/Base.astro';
---

<Base>
  <h1 class="display">Keep track of worlds.</h1>

  <section class="account section">
    <p id="account-loading">Checking your session&hellip;</p>
    <p id="account-error" class="error-text" hidden></p>
    <div id="account-signed-out" hidden>
      <button id="login-button" type="button">
        Log in
      </button>
    </div>
    <div id="account-signed-in" hidden>
      <p>
        Signed in as <strong id="account-email"></strong>.
      </p>
      <button id="logout-button" type="button">
        Log out
      </button>
      <a href="/profile">Your profile</a>
      <a href="/notifications">
        Notifications<span id="unread-badge" class="canonical-marker" hidden></span>
      </a>
      <a href="/tenants">Your libraries and campaigns</a>
      <a href="/campaigns">Your campaigns</a>
      <a id="setup-link" href="/setup" hidden>
        Set up a table
      </a>
      <a href="/beings">Beings</a>
      <a href="/debug/me">
        Debug: <code>GET /me</code>
      </a>
    </div>
  </section>

  <script>
    import { showError } from '../lib/errorUi';
    import { getUserInfo, isAuthConfigured, isAuthenticated, login, logout } from '../lib/auth';
    import { getMe } from '../lib/me';
    import { getUnreadCount } from '../lib/notifications';
    import { canCreateTenants } from '../lib/tenantKind';

    // Matches notifications.astro's own polling cadence and visibility
    // pause (ADR 0085) - this page owns its own independent poll loop,
    // there's no cross-page shared timer.
    const POLL_INTERVAL_MS = 30_000;

    const loading = document.getElementById('account-loading')!;
    const errorEl = document.getElementById('account-error')!;
    const signedOut = document.getElementById('account-signed-out')!;
    const signedIn = document.getElementById('account-signed-in')!;
    const emailEl = document.getElementById('account-email')!;
    const unreadBadge = document.getElementById('unread-badge')!;
    const setupLink = document.getElementById('setup-link')!;

    // Offered only to an account that may create a library (ADR 0175); a
    // convenience, so a failure to ask is no failure of the page.
    async function showSetupLink() {
      try {
        setupLink.hidden = !canCreateTenants(await getMe());
      } catch {
        // No link, rather than a link that may not work.
      }
    }

    document.getElementById('login-button')?.addEventListener('click', () => {
      void login();
    });
    document.getElementById('logout-button')?.addEventListener('click', () => {
      void logout();
    });

    function showFailure(show: (target: HTMLElement) => void) {
      loading.hidden = true;
      errorEl.hidden = false;
      show(errorEl);
    }

    let pollHandle: ReturnType<typeof setInterval> | undefined;

    async function refreshUnreadBadge() {
      const count = await getUnreadCount();
      if (count > 0) {
        unreadBadge.textContent = ` (${count})`;
        unreadBadge.hidden = false;
      } else {
        unreadBadge.hidden = true;
      }
    }

    function startPolling() {
      stopPolling();
      pollHandle = setInterval(() => void refreshUnreadBadge(), POLL_INTERVAL_MS);
    }
    function stopPolling() {
      if (pollHandle !== undefined) clearInterval(pollHandle);
      pollHandle = undefined;
    }

    document.addEventListener('visibilitychange', () => {
      if (signedIn.hidden) return;
      if (document.visibilityState === 'visible') {
        void refreshUnreadBadge();
        startPolling();
      } else {
        stopPolling();
      }
    });

    if (!isAuthConfigured()) {
      showFailure((target) => {
        target.textContent = 'Authgear is not configured for this app yet.';
      });
    } else {
      try {
        const authed = await isAuthenticated();
        loading.hidden = true;
        if (authed) {
          const info = await getUserInfo();
          emailEl.textContent = info.email ?? info.sub;
          signedIn.hidden = false;
          void showSetupLink();
          await refreshUnreadBadge();
          startPolling();
        } else {
          signedOut.hidden = false;
        }
      } catch (e) {
        showFailure((target) => showError(target, e));
      }
    }
  </script>
</Base>
