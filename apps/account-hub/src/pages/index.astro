---
import Briefing from '../components/Briefing/Briefing.astro';
import NewUser from '../components/NewUser/NewUser.astro';
import Base from '../layouts/Base.astro';
---

<Base>
  <div id="account-signed-out" class="signed-out row" hidden>
    <div class="stack grow">
      <h1 class="display">Keep track of worlds.</h1>

      <p class="lede">
        Your account for Lorenzo: your libraries, campaigns, characters and notifications.
      </p>

      <div>
        <button id="login-button" type="button">
          Log in
        </button>
      </div>
    </div>
    <!-- Lazy, so someone already signed in (this block stays hidden) never downloads it. -->
    <img
      src="/brand/mascot_emblem_web.png"
      alt="Lorenzo leaning on a stack of Worlds, People, Places, Ideas, and Stories volumes, Catileo asleep on the open book beside them"
      loading="lazy"
      width="320"
    />
  </div>

  <NewUser />

  <Briefing />

  <p id="account-loading">Checking your session&hellip;</p>
  <p id="account-error" class="error-text" hidden></p>

  <script>
    import { renderBriefing } from '../components/Briefing/renderer';
    import { renderNewUser } from '../components/NewUser/renderer';
    import { showError } from '../lib/errorUi';
    import { isAuthConfigured, isAuthenticated, login } from '../lib/auth';
    import { isNewAccount } from '../lib/format';
    import { getMe } from '../lib/me';
    import { requiredIn } from '../lib/template';

    const loading = document.getElementById('account-loading')!;
    const errorEl = document.getElementById('account-error')!;
    const signedOut = document.getElementById('account-signed-out')!;
    const briefing = requiredIn('Home')<HTMLElement>(document, '[data-briefing]');
    const newUser = requiredIn('Home')<HTMLElement>(document, '[data-new-user]');

    document.getElementById('login-button')?.addEventListener('click', () => {
      void login();
    });

    function showFailure(show: (target: HTMLElement) => void) {
      loading.hidden = true;
      errorEl.hidden = false;
      show(errorEl);
    }

    // Signing in and out, and everything else about the session, lives in the header.
    if (!isAuthConfigured()) {
      showFailure((target) => {
        target.textContent = 'Authgear is not configured for this app yet.';
      });
    } else {
      try {
        const authed = await isAuthenticated();
        loading.hidden = true;
        if (authed) {
          // What the account is decides what the page offers.
          const me = await getMe();

          if (isNewAccount(me)) {
            renderNewUser(newUser, me);
          } else {
            await renderBriefing(briefing, me);
          }
        } else {
          signedOut.hidden = false;
        }
      } catch (e) {
        showFailure((target) => showError(target, e));
      }
    }
  </script>
</Base>
