---
import Base from '../../layouts/Base.astro';
---

<Base title="Debug: GET /me — Lorenzo">
  <h1 class="display">
    <code>GET /me</code>
  </h1>
  <p>
    <a href="/">&larr; Back</a>
  </p>
  <pre id="result">Loading&hellip;</pre>

  <script>
    import { describeError } from '../../lib/describeError';
    import { getMe } from '../../lib/me';
    import { isAuthenticated } from '../../lib/auth';
    import { NOT_LOGGED_IN } from '../../lib/pageLoad';

    const result = document.getElementById('result')!;

    if (!(await isAuthenticated())) {
      result.textContent = NOT_LOGGED_IN;
    } else {
      try {
        const me = await getMe();
        result.textContent = JSON.stringify(me, null, 2);
      } catch (e) {
        result.textContent = describeError(e);
      }
    }
  </script>
</Base>
