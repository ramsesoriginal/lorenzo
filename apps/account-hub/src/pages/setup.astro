---
import Setup from '../components/Setup/Setup.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Set up a table — Lorenzo">
  <h1 class="display">Set up a table</h1>

  <p id="loading">Loading&hellip;</p>
  <p id="load-error" class="error-text" hidden></p>
  <p id="setup-unavailable" hidden>
    Setting up a library isn't open to your account yet.
  </p>

  <section id="setup" class="stack car card-body" hidden>
    <p>
      This makes a library to keep it in, a campaign in that library, and the links for your
      players. A library holds the campaigns and characters of a group of people.
    </p>
    <Setup />
  </section>

  <script>
    import { renderSetup } from '../components/Setup/renderer';
    import { getMe } from '../lib/me';
    import { runPage } from '../lib/pageLoad';
    import { requiredIn } from '../lib/template';
    import { canCreateTenants } from '../lib/tenantKind';

    const unavailable = document.getElementById('setup-unavailable')!;
    const section = document.getElementById('setup')!;
    const setup = requiredIn('Setup page')<HTMLElement>(document, '[data-setup]');

    await runPage(async () => {
      const me = await getMe();

      // ADR 0175: only an account that may create is offered the form; the 403 is still shown if
      // it comes.
      if (canCreateTenants(me)) {
        section.hidden = false;
        renderSetup(setup, me.id);
      } else {
        unavailable.hidden = false;
      }
    });
  </script>
</Base>
