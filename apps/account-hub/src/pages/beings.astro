---
import BeingsPanel from '../components/BeingsPanel/BeingsPanel.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Beings — Lorenzo">
  <h1 class="display">Beings</h1>

  <p id="loading">Loading&hellip;</p>
  <p id="load-error" class="error-text" hidden></p>

  <BeingsPanel />

  <script>
    import { renderBeingsPanel } from '../components/BeingsPanel/renderer';
    import { runPage } from '../lib/pageLoad';
    import { requiredIn } from '../lib/template';

    const panel = requiredIn('Beings')<HTMLElement>(document, '[data-beings-panel]');

    await runPage(() => renderBeingsPanel(panel));
  </script>
</Base>
