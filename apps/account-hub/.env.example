# Copy to .env and fill in. This app needs its OWN Authgear "Single Page
# Application" client (a public/PKCE client, distinct from apps/api's own
# dev-token-script client AND from apps/inventory-web's client — redirect
# URIs are exact-match per client) — see ADR 0071. Authorized Redirect URIs
# should include http://localhost:4322/auth/redirect for local dev - a
# fixed, non-default port, since apps/inventory-web already owns 4321 and
# both need to run concurrently.

PUBLIC_AUTHGEAR_ENDPOINT=
PUBLIC_AUTHGEAR_CLIENT_ID=

# Optional - defaults to the deployed Cloud Run API. Set this to point at a
# local apps/api instance instead (e.g. http://localhost:8000).
PUBLIC_API_BASE_URL=

# Optional - defaults to this app's own same-origin /branding/ (populated
# at build time from @lorenzo/brand, see scripts/copy-branding.mjs and ADR
# 0098). Set this to apps/brand's own deployed origin to hotlink shared
# branding CSS instead, for instant cross-app propagation of a change.
PUBLIC_BRANDING_CSS_URL=
