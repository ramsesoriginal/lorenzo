{
  "name": "@lorenzo/account-hub",
  "private": true,
  "type": "module",
  "version": "1.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build-branding-package": "pnpm --filter @lorenzo/brand run build",
    "copy-branding": "node scripts/copy-branding.mjs",
    "dev": "pnpm run build-branding-package && pnpm run copy-branding && astro dev",
    "build": "pnpm run build-branding-package && pnpm run copy-branding && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "biome check . && astro check && prettier --check \"**/*.astro\"",
    "format": "biome check --write . && prettier --write \"**/*.astro\"",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:real-api": "playwright test --config playwright.real-api.config.ts",
    "test:real-api:ci": "playwright test --config playwright.real-api.config.ts tests/e2e tests/real-api/shelf.spec.ts tests/real-api/copy.spec.ts tests/real-api/updates.spec.ts"
  },
  "dependencies": {
    "@authgear/web": "^6.0.0",
    "@lorenzo/brand": "workspace:*",
    "@lorenzo/lorenzoscript": "workspace:*",
    "@lorenzo/lorenzoscript-editor": "workspace:*",
    "astro": "^7.3.5",
    "@lorenzo/api-client": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "^2.3.0",
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
