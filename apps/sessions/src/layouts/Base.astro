---
import { ClientRouter } from 'astro:transitions';
import { BRANDING_CSS_URL } from '../lib/config';
import appStyles from '../styles/app.css?url';
interface Props {
  title?: string;
}
const { title = 'Lorenzo Sessions' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {['normalize', 'tokens', 'fonts', 'base', 'layout', 'components', 'motion'].map((name) => (
      <link rel="stylesheet" href={`${BRANDING_CSS_URL}/${name}.css`} />
    ))}
    <link rel="stylesheet" href={appStyles} />
    <script is:inline>
      (() => {
        let saved;
        try {
          saved = localStorage.getItem('lorenzo:sessions:theme');
        } catch {
          // System appearance remains usable when preference storage is blocked.
        }
        document.documentElement.dataset.theme =
          saved === 'light' || saved === 'dark'
            ? saved
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">
      Skip to content
    </a>
    <header class="site-header">
      <div class="row brand-group">
        <a class="brand" href="/" aria-label="Lorenzo Sessions home">
          <img
            class="brand-mark brand-mark--light"
            src="/brand/lorenzo_horizontal_lockup_light_bg.svg"
            alt="Lorenzo"
            width="220"
            height="59"
          />
          <img
            class="brand-mark brand-mark--dark"
            src="/brand/lorenzo_horizontal_lockup_dark_bg.svg"
            alt="Lorenzo"
            width="220"
            height="59"
          />
        </a>
        <span class="product">Sessions</span>
      </div>
      <nav aria-label="Account and appearance">
        <a data-hub hidden>
          Account
        </a>
        <button class="btn btn-secondary" data-login hidden>
          Log in
        </button>
        <button class="btn btn-secondary" data-logout hidden>
          Log out
        </button>
        <button type="button" class="btn btn-secondary" data-theme-toggle aria-pressed="false">
          Dark theme
        </button>
      </nav>
    </header>
    <main id="content" class="wrap stack">
      <div class="welcome stack" data-welcome>
        <h1>Sessions for your worlds</h1>
        <p class="intro">
          Prepare your next session, keep scenes together, and leave room for everyone’s notes.
        </p>
        <p data-session role="status">
          Opening your sessions…
        </p>
      </div>
      <div data-page hidden>
        <slot />
      </div>
    </main>
    <footer>
      <div class="wrap">Prepare together. Keep the story.</div>
    </footer>
  </body>
</html>
